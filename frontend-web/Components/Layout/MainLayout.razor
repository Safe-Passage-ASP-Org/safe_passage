@inherits LayoutComponentBase
@inject SafePassage.Web.Services.AdminApiClient Api
@inject SafePassage.Web.Services.SecurityAlertCountService AlertCount
@inject SafePassage.Web.Services.AdminNotificationService AdminNotifications
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="sp-shell">

    <!-- ── Left Sidebar ──────────────────────────────────── -->
    <aside class="sp-sidebar">
        <NavMenu />
    </aside>

    <!-- ── Main Column ──────────────────────────────────── -->
    <div class="sp-main-column">

        <!-- Top Navbar -->
        <header class="sp-topbar">
            <!-- Page breadcrumb / title slot -->
            <div class="sp-topbar-left">
                <span class="sp-topbar-title">@(Api.IsAdministrator ? "Admin Dashboard" : "Dashboard")</span>
            </div>

            <!-- Right controls -->
            <div class="sp-topbar-right">

                @if (Api.IsAdministrator || Api.CurrentRole == "Auditor")
                {
                    <div class="sp-bell-wrapper">
                        @if (Api.IsAdministrator)
                        {
                            <button type="button" class="sp-icon-btn" aria-label="@BellTitle" aria-expanded="@NotificationOpen" aria-controls="admin-notification-panel" title="@BellTitle" @onclick="ToggleNotificationPanelAsync">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 0 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/>
                                </svg>
                                @if (BellCount is > 0) { <span class="sp-badge">@BellBadge</span> }
                            </button>
                            @if (NotificationOpen)
                            {
                                <button type="button" class="sp-notification-backdrop" aria-label="Close notifications" @onclick="CloseNotificationPanel"></button>
                                <section id="admin-notification-panel" class="sp-notification-panel" role="dialog" aria-label="Notifications">
                                    <header class="sp-notification-header">
                                        <h2>Notifications</h2>
                                        <div>
                                            <button type="button" class="sp-notification-refresh" aria-label="Refresh notifications" title="Refresh" @onclick="RefreshNotificationsAsync">↻</button>
                                            <a href="/notifications" @onclick="CloseNotificationPanel">See all</a>
                                        </div>
                                    </header>
                                    @if (AdminNotifications.Error is not null)
                                    {
                                        <div class="sp-notification-message error" role="alert">Couldn’t load notifications. <button type="button" @onclick="RefreshNotificationsAsync">Try again</button></div>
                                    }
                                    else if (AdminNotifications.Count is null)
                                    {
                                        <div class="sp-notification-message" role="status">Loading notifications…</div>
                                    }
                                    else if (AdminNotifications.Items.Count == 0)
                                    {
                                        <div class="sp-notification-message">You’re all caught up. There are no pending notifications.</div>
                                    }
                                    else
                                    {
                                        <div class="sp-notification-section-title">Needs review</div>
                                        <div class="sp-notification-list">
                                            @foreach (var item in AdminNotifications.Items)
                                            {
                                                <a class="sp-notification-item" href="@item.Href" @onclick="CloseNotificationPanel">
                                                    <span class="sp-notification-mark @NotificationMarkClass(item.Category)" aria-hidden="true">@NotificationMark(item.Category)</span>
                                                    <span class="sp-notification-copy"><small>@item.Category</small><strong>@item.Title</strong><span>@item.Message</span><time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToLocalTime().ToString("MMM d · h:mm tt")</time></span>
                                                </a>
                                            }
                                        </div>
                                    }
                                </section>
                            }
                        }
                        else
                        {
                            <a class="sp-icon-btn" aria-label="@BellTitle" href="/alerts" title="@BellTitle">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 0 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/>
                            </svg>
                            @if (BellCount is > 0) { <span class="sp-badge">@BellBadge</span> }
                            </a>
                        }
                    </div>
                }

                <!-- Signed-in account identity -->
                <div class="sp-profile-wrapper">
                    <div class="sp-profile-identity" aria-label="Signed-in account">
                        @if (!string.IsNullOrWhiteSpace(Api.CurrentProfileImageData))
                        {
                            <img class="sp-avatar sp-avatar-image" src="@Api.CurrentProfileImageData" alt="" />
                        }
                        else
                        {
                            <div class="sp-avatar">@AvatarInitials</div>
                        }
                        <div class="sp-profile-info">
                            <span class="sp-profile-name">@(Api.CurrentUsername ?? (Api.IsAdministrator ? "Administrator" : "User"))</span>
                            <span class="sp-profile-role">@(Api.CurrentRole ?? "Signed in")</span>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="sp-content">
            @Body
        </main>
    </div>
</div>

@code {
    private string AvatarInitials
    {
        get
        {
            var name = Api.CurrentUsername;
            if (string.IsNullOrWhiteSpace(name))
                return Api.IsAdministrator ? "AD" : "SP";

            var parts = name.Split(new[] { ' ', '.', '_', '-', '@' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";

            return name.Length >= 2
                ? name[..2].ToUpperInvariant()
                : name.ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        AlertCount.Changed += HandleAlertCountChanged;
        AdminNotifications.Changed += HandleAdminNotificationsChanged;
        Api.ProfileChanged += HandleProfileChanged;
        if (!string.IsNullOrWhiteSpace(Api.AccessToken))
        {
            try { await Api.GetProfileAsync(); }
            catch { /* Keep the initials avatar if the profile endpoint is temporarily unavailable. */ }
        }
        await RefreshAlertCountAsync();
        await RefreshNotificationsAsync();
        if (Api.IsAdministrator)
            _ = RefreshNotificationsPeriodicallyAsync(_notificationRefreshCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var isAuthenticated = !string.IsNullOrWhiteSpace(Api.AccessToken);
        await JS.InvokeVoidAsync("safePassageAppearance.initialize", isAuthenticated, Api.IsAdministrator);
    }

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Api.AccessToken))
            Navigation.NavigateTo("/login");
    }

    private int? BellCount => Api.IsAdministrator ? AdminNotifications.Count : AlertCount.Count;
    private string BellBadge => BellCount is int count && count > 99 ? "99+" : BellCount?.ToString() ?? "";
    private string BellTitle => Api.IsAdministrator
        ? AdminNotifications.Count is int count ? $"Notifications ({count} pending item{(count == 1 ? "" : "s")})" : "Notifications"
        : AlertCount.Count is int alertCount ? $"Security Alerts ({alertCount} pending device approval{(alertCount == 1 ? "" : "s")})" : "Security Alerts";
    private bool NotificationOpen;
    private readonly CancellationTokenSource _notificationRefreshCancellation = new();

    private async Task ToggleNotificationPanelAsync()
    {
        NotificationOpen = !NotificationOpen;
        if (NotificationOpen && Api.IsAdministrator)
            await AdminNotifications.RefreshAsync(_notificationRefreshCancellation.Token);
    }

    private void CloseNotificationPanel() => NotificationOpen = false;
    private static string NotificationMark(string category) => category switch
    {
        "Device approval" => "D",
        "Application access" => "A",
        "Website verification" => "W",
        _ => "•"
    };
    private static string NotificationMarkClass(string category) => category switch
    {
        "Device approval" => "device",
        "Application access" => "application",
        "Website verification" => "website",
        _ => "default"
    };

    private Task RefreshAlertCountAsync() => Api.IsAdministrator || Api.CurrentRole == "Auditor"
        ? AlertCount.RefreshAsync()
        : Task.CompletedTask;

    private Task RefreshNotificationsAsync() => Api.IsAdministrator
        ? AdminNotifications.RefreshAsync()
        : Task.CompletedTask;

    private async Task RefreshNotificationsPeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await AdminNotifications.RefreshAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        NotificationOpen = false;
        _ = InvokeAsync(async () =>
        {
            await RefreshAlertCountAsync();
            await RefreshNotificationsAsync();
        });
    }

    private void HandleAlertCountChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleAdminNotificationsChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleProfileChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _notificationRefreshCancellation.Cancel();
        _notificationRefreshCancellation.Dispose();
        Navigation.LocationChanged -= HandleLocationChanged;
        AlertCount.Changed -= HandleAlertCountChanged;
        AdminNotifications.Changed -= HandleAdminNotificationsChanged;
        Api.ProfileChanged -= HandleProfileChanged;
    }
}

<!-- Blazor error UI -->
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
