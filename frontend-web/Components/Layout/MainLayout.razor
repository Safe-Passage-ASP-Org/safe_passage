@inherits LayoutComponentBase
@inject SafePassage.Web.Services.AdminApiClient Api
@inject SafePassage.Web.Services.SecurityAlertCountService AlertCount
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="sp-shell">

    <!-- ── Left Sidebar ──────────────────────────────────── -->
    <aside class="sp-sidebar">
        <NavMenu />
    </aside>

    <!-- ── Main Column ──────────────────────────────────── -->
    <div class="sp-main-column">

        <!-- Top Navbar -->
        <header class="sp-topbar">
            <!-- Page breadcrumb / title slot -->
            <div class="sp-topbar-left">
                <span class="sp-topbar-title">@(Api.IsAdministrator ? "Admin Dashboard" : "Dashboard")</span>
            </div>

            <!-- Right controls -->
            <div class="sp-topbar-right">

                @if (Api.IsAdministrator || Api.CurrentRole == "Auditor")
                {
                    <div class="sp-bell-wrapper" title="@AlertTitle">
                        <a class="sp-icon-btn" aria-label="@AlertTitle" href="/alerts">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 0 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/>
                            </svg>
                            @if (AlertCount.Count is > 0)
                            {
                                <span class="sp-badge">@(AlertCount.Count > 99 ? "99+" : AlertCount.Count.ToString())</span>
                            }
                        </a>
                    </div>
                }

                <!-- Signed-in account identity -->
                <div class="sp-profile-wrapper">
                    <div class="sp-profile-identity" aria-label="Signed-in account">
                        <div class="sp-avatar">@AvatarInitials</div>
                        <div class="sp-profile-info">
                            <span class="sp-profile-name">@(Api.CurrentUsername ?? (Api.IsAdministrator ? "Administrator" : "User"))</span>
                            <span class="sp-profile-role">@(Api.CurrentRole ?? "Signed in")</span>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="sp-content">
            @Body
        </main>
    </div>
</div>

@code {
    private string AvatarInitials
    {
        get
        {
            var name = Api.CurrentUsername;
            if (string.IsNullOrWhiteSpace(name))
                return Api.IsAdministrator ? "AD" : "SP";

            var parts = name.Split(new[] { ' ', '.', '_', '-', '@' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";

            return name.Length >= 2
                ? name[..2].ToUpperInvariant()
                : name.ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        AlertCount.Changed += HandleAlertCountChanged;
        Api.ProfileChanged += HandleProfileChanged;
        await RefreshAlertCountAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var isAuthenticated = !string.IsNullOrWhiteSpace(Api.AccessToken);
        await JS.InvokeVoidAsync("safePassageAppearance.initialize", isAuthenticated, Api.IsAdministrator);
    }

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Api.AccessToken))
            Navigation.NavigateTo("/login");
    }

    private string AlertTitle => AlertCount.Count is int count
        ? $"Security Alerts ({count} pending device approval{(count == 1 ? "" : "s")})"
        : "Security Alerts";

    private Task RefreshAlertCountAsync() => Api.IsAdministrator || Api.CurrentRole == "Auditor"
        ? AlertCount.RefreshAsync()
        : Task.CompletedTask;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(RefreshAlertCountAsync);
    }

    private void HandleAlertCountChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleProfileChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        AlertCount.Changed -= HandleAlertCountChanged;
        Api.ProfileChanged -= HandleProfileChanged;
    }
}

<!-- Blazor error UI -->
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
