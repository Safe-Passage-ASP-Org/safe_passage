@inherits LayoutComponentBase
@inject SafePassage.Web.Services.AdminApiClient Api
@inject SafePassage.Web.Services.SecurityAlertCountService AlertCount
@inject SafePassage.Web.Services.AdminNotificationService AdminNotifications
@inject SafePassage.Web.Services.UserNotificationService UserNotifications
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="sp-shell">

    <!-- ── Left Sidebar ──────────────────────────────────── -->
    <aside class="sp-sidebar">
        <NavMenu />
    </aside>

    <!-- ── Main Column ──────────────────────────────────── -->
    <div class="sp-main-column">

        <!-- Top Navbar -->
        <header class="sp-topbar">
            <!-- Page breadcrumb / title slot -->
            <div class="sp-topbar-left">
                <span class="sp-topbar-title">@(Api.IsAdministrator ? "Admin Dashboard" : "Dashboard")</span>
            </div>

            <!-- Right controls -->
            <div class="sp-topbar-right">
                <button type="button" class="sp-icon-btn sp-theme-toggle" aria-label="Toggle light and dark mode" title="Toggle light and dark mode" @onclick="ToggleThemeAsync">
                    <svg class="sp-theme-icon-dark" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.985 12.486A9 9 0 1 1 11.514 3.015a.75.75 0 0 1 .807.402 6.5 6.5 0 0 0 8.262 8.262.75.75 0 0 1 .402.807Z" />
                    </svg>
                    <svg class="sp-theme-icon-light" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
                    </svg>
                </button>

                <div class="sp-bell-wrapper">
                    @if (Api.IsAdministrator)
                    {
                        <button type="button" class="sp-icon-btn" aria-label="@BellTitle" aria-expanded="@NotificationOpen" aria-controls="admin-notification-panel" title="@BellTitle" @onclick="ToggleNotificationPanelAsync">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 0 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/>
                            </svg>
                            @if (BellCount is > 0) { <span class="sp-badge">@BellBadge</span> }
                        </button>
                        @if (NotificationOpen)
                        {
                            <button type="button" class="sp-notification-backdrop" aria-label="Close notifications" @onclick="CloseNotificationPanel"></button>
                            <section id="admin-notification-panel" class="sp-notification-panel" role="dialog" aria-label="Notifications">
                                <header class="sp-notification-header">
                                    <h2>Notifications</h2>
                                    <div>
                                        <button type="button" class="sp-notification-refresh" aria-label="Refresh notifications" title="Refresh" @onclick="RefreshNotificationsAsync">↻</button>
                                        <a href="/notifications" @onclick="CloseNotificationPanel">See all</a>
                                    </div>
                                </header>
                                @if (AdminNotifications.Error is not null)
                                {
                                    <div class="sp-notification-message error" role="alert">Couldn’t load notifications. <button type="button" @onclick="RefreshNotificationsAsync">Try again</button></div>
                                }
                                else if (AdminNotifications.Count is null)
                                {
                                    <div class="sp-notification-message" role="status">Loading notifications…</div>
                                }
                                else if (AdminNotifications.Items.Count == 0)
                                {
                                    <div class="sp-notification-message">You’re all caught up. There are no pending notifications.</div>
                                }
                                else
                                {
                                    <div class="sp-notification-section-title">Needs review</div>
                                    <div class="sp-notification-list">
                                        @foreach (var item in AdminNotifications.Items)
                                        {
                                            <a class="sp-notification-item" href="@item.Href" @onclick="CloseNotificationPanel">
                                                <span class="sp-notification-mark @NotificationMarkClass(item.Category)" aria-hidden="true">@NotificationMark(item.Category)</span>
                                                <span class="sp-notification-copy"><small>@item.Category</small><strong>@item.Title</strong><span>@item.Message</span><time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToLocalTime().ToString("MMM d · h:mm tt")</time></span>
                                            </a>
                                        }
                                    </div>
                                }
                            </section>
                        }
                    }
                    else if (Api.CurrentRole == "Auditor")
                    {
                        <a class="sp-icon-btn" aria-label="@BellTitle" href="/alerts" title="@BellTitle">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 0 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/>
                            </svg>
                            @if (BellCount is > 0) { <span class="sp-badge">@BellBadge</span> }
                        </a>
                    }
                    else
                    {
                        <button type="button" class="sp-icon-btn" aria-label="@BellTitle" aria-expanded="@NotificationOpen" aria-controls="user-notification-panel" title="@BellTitle" @onclick="ToggleNotificationPanelAsync">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 0 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/>
                            </svg>
                            @if (BellCount is > 0) { <span class="sp-badge">@BellBadge</span> }
                        </button>
                        @if (NotificationOpen)
                        {
                            <button type="button" class="sp-notification-backdrop" aria-label="Close notifications" @onclick="CloseNotificationPanel"></button>
                            <section id="user-notification-panel" class="sp-notification-panel" role="dialog" aria-label="Your notifications">
                                <header class="sp-notification-header">
                                    <h2>Your notifications</h2>
                                    <div>
                                        @if (UserNotifications.UnreadCount > 0)
                                        {
                                            <button type="button" class="sp-notification-refresh" @onclick="MarkAllUserNotificationsReadAsync">Mark all read</button>
                                        }
                                        <a href="/notifications" @onclick="CloseNotificationPanel">See all</a>
                                    </div>
                                </header>
                                @if (UserNotifications.Error is not null)
                                {
                                    <div class="sp-notification-message error" role="alert">Couldn’t load notifications. <button type="button" @onclick="RefreshNotificationsAsync">Try again</button></div>
                                }
                                else if (UserNotifications.Items.Count == 0)
                                {
                                    <div class="sp-notification-message">You’re all caught up. There are no notifications.</div>
                                }
                                else
                                {
                                    <div class="sp-notification-list">
                                        @foreach (var item in UserNotifications.Items.Take(6))
                                        {
                                            <a class="sp-notification-item @UnreadClass(item)" href="@(item.Href ?? "/notifications")" @onclick="() => OpenUserNotificationAsync(item)">
                                                <span class="sp-notification-mark default" aria-hidden="true">•</span>
                                                <span class="sp-notification-copy"><small>@item.Category</small><strong>@item.Title</strong><span>@item.Message</span><time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToLocalTime().ToString("MMM d · h:mm tt")</time></span>
                                            </a>
                                        }
                                    </div>
                                }
                            </section>
                        }
                    }
                </div>

                <!-- Signed-in account identity & dropdown -->
                <div class="sp-profile-wrapper">
                    <button type="button" class="sp-profile-identity sp-profile-trigger" aria-label="Account menu" aria-expanded="@ProfileMenuOpen" aria-haspopup="menu" @onclick="ToggleProfileMenu">
                        @if (!string.IsNullOrWhiteSpace(Api.CurrentProfileImageData))
                        {
                            <img class="sp-avatar sp-avatar-image" src="@Api.CurrentProfileImageData" alt="" />
                        }
                        else
                        {
                            <div class="sp-avatar">@AvatarInitials</div>
                        }
                        <div class="sp-profile-info">
                            <span class="sp-profile-name">@(Api.CurrentUsername ?? (Api.IsAdministrator ? "Administrator" : "User"))</span>
                            <span class="sp-profile-role">@(Api.CurrentRole ?? "Signed in")</span>
                        </div>
                        <svg class="sp-profile-chevron" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                        </svg>
                    </button>
                    @if (ProfileMenuOpen)
                    {
                        <button type="button" class="sp-notification-backdrop" aria-label="Close account menu" @onclick="CloseProfileMenu"></button>
                        <div class="sp-profile-menu" role="menu" aria-label="Account menu">
                            <div class="sp-profile-menu-header">
                                <strong>@(Api.CurrentUsername ?? (Api.IsAdministrator ? "Administrator" : "User"))</strong>
                                <span>@(Api.CurrentEmail ?? Api.CurrentRole ?? "Signed in")</span>
                            </div>
                            <a class="sp-profile-menu-item" role="menuitem" href="/settings" @onclick="CloseProfileMenu">
                                <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                    <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/>
                                    <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.892 3.433-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.892-1.64-.901-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319z"/>
                                </svg>
                                <span>Settings</span>
                            </a>
                            <div class="sp-profile-menu-divider" role="separator"></div>
                            <button type="button" class="sp-profile-menu-item sp-profile-menu-signout" role="menuitem" @onclick="PromptSignOut">
                                <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                    <path d="M6 2h8v12H6v-2h2v1h4V3H8v1H6zm1 3 3 3-3 3V9H1V7h6z"/>
                                </svg>
                                <span>Sign out</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="sp-content">
            @Body
        </main>
    </div>
</div>

<ConfirmationDialog IsOpen="ShowSignOutConfirmation"
                    Title="Sign out of Safe Passage?"
                    Message="You will be signed out of this browser session and returned to the login page."
                    ConfirmLabel="Sign out"
                    CancelLabel="Stay signed in"
                    IsDestructive="true"
                    OnCancel="CloseSignOutConfirmation"
                    OnConfirm="ConfirmSignOutAsync" />

@code {
    private string AvatarInitials
    {
        get
        {
            var name = Api.CurrentUsername;
            if (string.IsNullOrWhiteSpace(name))
                return Api.IsAdministrator ? "AD" : "SP";

            var parts = name.Split(new[] { ' ', '.', '_', '-', '@' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";

            return name.Length >= 2
                ? name[..2].ToUpperInvariant()
                : name.ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        AlertCount.Changed += HandleAlertCountChanged;
        AdminNotifications.Changed += HandleAdminNotificationsChanged;
        UserNotifications.Changed += HandleUserNotificationsChanged;
        Api.ProfileChanged += HandleProfileChanged;
        if (!string.IsNullOrWhiteSpace(Api.AccessToken))
        {
            try { await Api.GetProfileAsync(); }
            catch { /* Keep the initials avatar if the profile endpoint is temporarily unavailable. */ }
        }
        await RefreshAlertCountAsync();
        await RefreshNotificationsAsync();
        if (Api.IsAdministrator || (Api.CurrentRole != "Auditor" && !string.IsNullOrWhiteSpace(Api.AccessToken)))
            _ = RefreshNotificationsPeriodicallyAsync(_notificationRefreshCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var isAuthenticated = !string.IsNullOrWhiteSpace(Api.AccessToken);
        await JS.InvokeVoidAsync("safePassageAppearance.initialize", isAuthenticated, Api.IsAdministrator);
    }

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Api.AccessToken))
            Navigation.NavigateTo("/login");
    }

    private int? BellCount => Api.IsAdministrator
        ? AdminNotifications.Count
        : Api.CurrentRole == "Auditor" ? AlertCount.Count : UserNotifications.UnreadCount;
    private string BellBadge => BellCount is int count && count > 99 ? "99+" : BellCount?.ToString() ?? "";
    private string BellTitle => Api.IsAdministrator
        ? AdminNotifications.Count is int count ? $"Notifications ({count} pending item{(count == 1 ? "" : "s")})" : "Notifications"
        : Api.CurrentRole == "Auditor"
            ? AlertCount.Count is int alertCount ? $"Security Alerts ({alertCount} pending device approval{(alertCount == 1 ? "" : "s")})" : "Security Alerts"
            : UserNotifications.UnreadCount > 0 ? $"Notifications ({UserNotifications.UnreadCount} unread)" : "Notifications";
    private bool NotificationOpen;
    private bool ProfileMenuOpen;
    private bool ShowSignOutConfirmation;
    private readonly CancellationTokenSource _notificationRefreshCancellation = new();

    private async Task ToggleThemeAsync()
    {
        var currentTheme = await JS.InvokeAsync<string>("safePassageAppearance.getTheme", Api.IsAdministrator);
        var nextTheme = currentTheme == "dark" ? "light" : "dark";
        await JS.InvokeVoidAsync("safePassageAppearance.setTheme", nextTheme, !string.IsNullOrWhiteSpace(Api.AccessToken), Api.IsAdministrator);
    }

    private async Task ToggleNotificationPanelAsync()
    {
        ProfileMenuOpen = false;
        NotificationOpen = !NotificationOpen;
        if (NotificationOpen)
            await RefreshNotificationsAsync();
    }

    private void CloseNotificationPanel() => NotificationOpen = false;

    private void ToggleProfileMenu()
    {
        NotificationOpen = false;
        ProfileMenuOpen = !ProfileMenuOpen;
    }

    private void CloseProfileMenu() => ProfileMenuOpen = false;

    private void PromptSignOut()
    {
        ProfileMenuOpen = false;
        ShowSignOutConfirmation = true;
    }

    private void CloseSignOutConfirmation() => ShowSignOutConfirmation = false;

    private async Task ConfirmSignOutAsync()
    {
        ShowSignOutConfirmation = false;
        await JS.InvokeVoidAsync("safePassageAppearance.reset");
        Api.SignOut();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
    private string UnreadClass(SafePassage.Web.Services.UserNotification item) =>
        item.ReadAt is null ? "unread" : "";
    private async Task OpenUserNotificationAsync(SafePassage.Web.Services.UserNotification item)
    {
        if (item.ReadAt is null)
            await UserNotifications.MarkReadAsync(item.Id, _notificationRefreshCancellation.Token);
        CloseNotificationPanel();
    }
    private Task MarkAllUserNotificationsReadAsync() =>
        UserNotifications.MarkAllReadAsync(_notificationRefreshCancellation.Token);
    private static string NotificationMark(string category) => category switch
    {
        "Device approval" => "D",
        "Application access" => "A",
        "Website verification" => "W",
        _ => "•"
    };
    private static string NotificationMarkClass(string category) => category switch
    {
        "Device approval" => "device",
        "Application access" => "application",
        "Website verification" => "website",
        _ => "default"
    };

    private Task RefreshAlertCountAsync() => Api.IsAdministrator || Api.CurrentRole == "Auditor"
        ? AlertCount.RefreshAsync()
        : Task.CompletedTask;

    private Task RefreshNotificationsAsync() => Api.IsAdministrator
        ? AdminNotifications.RefreshAsync(_notificationRefreshCancellation.Token)
        : Api.CurrentRole == "Auditor"
            ? Task.CompletedTask
            : UserNotifications.RefreshAsync(_notificationRefreshCancellation.Token);

    private async Task RefreshNotificationsPeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await RefreshNotificationsAsync();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        NotificationOpen = false;
        ProfileMenuOpen = false;
        _ = InvokeAsync(async () =>
        {
            await RefreshAlertCountAsync();
            await RefreshNotificationsAsync();
        });
    }

    private void HandleAlertCountChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleAdminNotificationsChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleUserNotificationsChanged() => _ = InvokeAsync(StateHasChanged);
    private void HandleProfileChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _notificationRefreshCancellation.Cancel();
        _notificationRefreshCancellation.Dispose();
        Navigation.LocationChanged -= HandleLocationChanged;
        AlertCount.Changed -= HandleAlertCountChanged;
        AdminNotifications.Changed -= HandleAdminNotificationsChanged;
        UserNotifications.Changed -= HandleUserNotificationsChanged;
        Api.ProfileChanged -= HandleProfileChanged;
    }
}

<!-- Blazor error UI -->
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
