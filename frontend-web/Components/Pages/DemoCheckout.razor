@page "/subscription/demo-checkout"
@layout SafePassage.Web.Components.Layout.AuthLayout
@using SafePassage.Web.Services
@inject AdminApiClient Api
@inject NavigationManager Navigation

<PageTitle>Checkout – Safe Passage</PageTitle>

<div class="pm-shell">
    <div class="pm-container">
        <div class="pm-summary">
            <div class="pm-merchant">
                <div class="pm-logo">SP</div>
                <div>
                    <div class="pm-merchant-name">Safe Passage</div>
                    <div class="pm-test-pill">TEST MODE</div>
                </div>
            </div>

            <div class="pm-order-label">Subscribe to</div>
            <div class="pm-order-title">@DisplayPlanName</div>
            <div class="pm-order-amount">@DisplayAmount</div>

            <div class="pm-breakdown">
                <div class="pm-breakdown-row">
                    <span>@DisplayPlanName</span>
                    <span>@DisplayAmount</span>
                </div>
                <div class="pm-breakdown-row pm-breakdown-total">
                    <span>Total due today</span>
                    <span>@DisplayAmount</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(SessionId))
            {
                <div class="pm-session-id">Reference: <code>@SessionId</code></div>
            }
            <div class="pm-powered">Secured by PayMongo Sandbox Checkout</div>
        </div>

        <div class="pm-form-pane">
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="pm-alert pm-alert-error" role="alert">@ErrorMessage</div>
            }

            @if (string.IsNullOrWhiteSpace(SessionId))
            {
                <div class="pm-alert pm-alert-warn">
                    Missing checkout session ID. Please return to the Subscription page and start checkout again.
                </div>
                <a href="/subscription" class="pm-btn pm-btn-pay" style="text-decoration:none;">Return to Subscription</a>
            }
            else
            {
                <h1 class="pm-form-heading">Select payment method</h1>

                <div class="pm-methods">
                    @foreach (var method in PaymentMethods)
                    {
                        var selected = SelectedMethodKey == method.Key;
                        <button type="button"
                                class="pm-method-tab @(selected ? "active" : "")"
                                @onclick="() => SelectMethod(method.Key)">
                            <span class="pm-method-title">@method.Title</span>
                            <span class="pm-method-badge">@method.Tag</span>
                        </button>
                    }
                </div>

                @if (SelectedMethodKey == "card")
                {
                    <div class="pm-fields">
                        <label class="pm-field">
                            <span>Card number</span>
                            <input type="text" @bind="CardNumber" placeholder="4242 4242 4242 4242" />
                        </label>
                        <div class="pm-field-row">
                            <label class="pm-field">
                                <span>Expiry</span>
                                <input type="text" @bind="CardExpiry" placeholder="12 / 28" />
                            </label>
                            <label class="pm-field">
                                <span>CVC</span>
                                <input type="text" @bind="CardCvc" placeholder="123" />
                            </label>
                        </div>
                        <label class="pm-field">
                            <span>Cardholder name</span>
                            <input type="text" @bind="CardHolder" placeholder="Safe Passage Test User" />
                        </label>
                    </div>
                }
                else
                {
                    <div class="pm-fields">
                        <div class="pm-wallet-box">
                            <strong>@SelectedMethodTitle</strong>
                            <p>You will authorize a test payment from your @SelectedMethodTitle account.</p>
                        </div>
                        <label class="pm-field">
                            <span>Mobile number</span>
                            <input type="tel" @bind="WalletPhone" placeholder="+63 917 000 4242" />
                        </label>
                    </div>
                }

                <div class="pm-actions">
                    <button type="button" class="pm-btn pm-btn-pay" disabled="@Busy" @onclick="ApprovePaymentAsync">
                        @(Busy ? "Processing payment..." : $"Pay {DisplayAmount}")
                    </button>
                    <div class="pm-secondary-actions">
                        <button type="button" class="pm-btn pm-btn-ghost" disabled="@Busy" @onclick="SimulateDecline">
                            Simulate decline
                        </button>
                        <button type="button" class="pm-btn pm-btn-ghost" disabled="@Busy" @onclick="CancelPaymentAsync">
                            Cancel &amp; return
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .pm-shell{min-height:100vh;background:#f4f6f8;display:flex;align-items:center;justify-content:center;padding:24px 16px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
    .pm-container{width:100%;max-width:860px;background:#fff;border-radius:14px;box-shadow:0 18px 50px rgba(15,23,42,.1);overflow:hidden;display:grid;grid-template-columns:1fr 1.25fr;border:1px solid #e2e8f0}
    .pm-summary{background:#0f172a;color:#f8fafc;padding:32px 28px;display:flex;flex-direction:column}
    .pm-merchant{display:flex;align-items:center;gap:12px;margin-bottom:28px}
    .pm-logo{width:38px;height:38px;border-radius:9px;background:#087f75;color:#fff;font-weight:800;font-size:14px;display:grid;place-items:center}
    .pm-merchant-name{font-size:15px;font-weight:700}
    .pm-test-pill{display:inline-block;margin-top:3px;padding:2px 7px;border-radius:4px;background:#fef08a;color:#854d0e;font-size:10px;font-weight:800;letter-spacing:.5px}
    .pm-order-label{font-size:12px;color:#94a3b8;margin-bottom:4px}
    .pm-order-title{font-size:20px;font-weight:700;margin-bottom:6px}
    .pm-order-amount{font-size:28px;font-weight:800;color:#2dd4bf;margin-bottom:24px}
    .pm-breakdown{border-top:1px solid #1e293b;padding-top:16px;display:flex;flex-direction:column;gap:10px;font-size:13px;color:#cbd5e1}
    .pm-breakdown-row{display:flex;justify-content:space-between;gap:12px}
    .pm-breakdown-total{border-top:1px solid #1e293b;padding-top:12px;margin-top:4px;font-weight:700;color:#fff;font-size:14px}
    .pm-session-id{margin-top:24px;font-size:11px;color:#94a3b8;word-break:break-all}
    .pm-session-id code{color:#cbd5e1}
    .pm-powered{margin-top:auto;padding-top:24px;font-size:11px;color:#64748b}
    .pm-form-pane{padding:32px 28px}
    .pm-form-heading{font-size:17px;font-weight:700;color:#0f172a;margin:0 0 16px}
    .pm-methods{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:18px}
    .pm-method-tab{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:10px 12px;border:1.5px solid #cbd5e1;border-radius:8px;background:#fff;cursor:pointer;font:inherit;text-align:left;transition:border-color .15s,background-color .15s}
    .pm-method-tab.active{border-color:#087f75;background:#f0fdfa}
    .pm-method-title{font-size:13px;font-weight:650;color:#0f172a}
    .pm-method-badge{font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase}
    .pm-fields{display:flex;flex-direction:column;gap:12px;margin-bottom:20px}
    .pm-field{display:flex;flex-direction:column;gap:5px}
    .pm-field span{font-size:12px;font-weight:600;color:#334155}
    .pm-field input{border:1px solid #cbd5e1;border-radius:7px;padding:10px 12px;font:inherit;font-size:13px;color:#0f172a;background:#fff}
    .pm-field input:focus{outline:none;border-color:#087f75;box-shadow:0 0 0 3px rgba(8,127,117,.14)}
    .pm-field-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .pm-wallet-box{padding:12px 14px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0}
    .pm-wallet-box strong{display:block;font-size:13px;color:#0f172a;margin-bottom:3px}
    .pm-wallet-box p{margin:0;font-size:12px;color:#64748b}
    .pm-actions{display:flex;flex-direction:column;gap:10px}
    .pm-secondary-actions{display:flex;justify-content:space-between;gap:8px}
    .pm-btn{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;padding:12px 16px;font:inherit;font-size:14px;font-weight:700;cursor:pointer;border:1px solid transparent;transition:background-color .15s,opacity .15s}
    .pm-btn:disabled{opacity:.6;cursor:not-allowed}
    .pm-btn-pay{width:100%;background:#087f75;color:#fff}
    .pm-btn-pay:hover:not(:disabled){background:#06685f}
    .pm-btn-ghost{flex:1;background:#f8fafc;color:#475569;border-color:#e2e8f0;font-size:12px;padding:9px 12px}
    .pm-btn-ghost:hover:not(:disabled){background:#f1f5f9}
    .pm-alert{padding:11px 13px;border-radius:8px;font-size:13px;margin-bottom:16px}
    .pm-alert-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
    .pm-alert-warn{background:#fffbeb;color:#92400e;border:1px solid #fde68a}
    @@media(max-width:720px){.pm-container{grid-template-columns:1fr}.pm-methods{grid-template-columns:1fr}}
</style>

@code {
    [SupplyParameterFromQuery(Name = "sessionId")]
    public string? SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "plan")]
    public string? PlanCode { get; set; }

    [SupplyParameterFromQuery(Name = "amount")]
    public string? Amount { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    public string? PlanName { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? DemoToken { get; set; }

    private string SelectedMethodKey { get; set; } = "card";
    private string CardNumber { get; set; } = "4242 4242 4242 4242";
    private string CardExpiry { get; set; } = "12 / 28";
    private string CardCvc { get; set; } = "123";
    private string CardHolder { get; set; } = "Safe Passage Test User";
    private string WalletPhone { get; set; } = "+63 917 000 4242";
    private bool Busy { get; set; }
    private string? ErrorMessage { get; set; }

    private string DisplayPlanName => string.IsNullOrWhiteSpace(PlanName) ? "Safe Passage Pro" : PlanName;
    private string DisplayAmount => string.IsNullOrWhiteSpace(Amount) ? "PHP 299 / month" : Amount;

    private static readonly (string Key, string Title, string Tag, string Label)[] PaymentMethods =
    [
        ("card", "Card", "VISA / MC", "Demo Card •••• 4242"),
        ("gcash", "GCash", "E-Wallet", "GCash (Sandbox)"),
        ("maya", "Maya", "E-Wallet", "Maya (Sandbox)"),
        ("grabpay", "GrabPay", "E-Wallet", "GrabPay (Sandbox)")
    ];

    private void SelectMethod(string key)
    {
        SelectedMethodKey = key;
        ErrorMessage = null;
    }

    private string SelectedMethodTitle =>
        PaymentMethods.FirstOrDefault(m => m.Key == SelectedMethodKey).Title ?? "Card";

    private string SelectedMethodLabel =>
        PaymentMethods.FirstOrDefault(m => m.Key == SelectedMethodKey).Label ?? "Demo Card •••• 4242";

    private async Task ApprovePaymentAsync()
    {
        if (string.IsNullOrWhiteSpace(SessionId))
            return;

        Busy = true;
        ErrorMessage = null;
        try
        {
            await Api.CompleteDemoCheckoutAsync(SessionId, SelectedMethodLabel, "paid", DemoToken);
            Navigation.NavigateTo($"/subscription/paymongo-callback?status=success&subscription_id={Uri.EscapeDataString(SessionId)}");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void SimulateDecline()
    {
        ErrorMessage = $"Payment declined by issuing bank for {SelectedMethodLabel}. Try another method or click Pay to retry.";
    }

    private async Task CancelPaymentAsync()
    {
        if (string.IsNullOrWhiteSpace(SessionId))
            return;

        Busy = true;
        ErrorMessage = null;
        try
        {
            await Api.CompleteDemoCheckoutAsync(SessionId, SelectedMethodLabel, "cancelled", DemoToken);
            Navigation.NavigateTo($"/subscription/paymongo-callback?status=cancel&subscription_id={Uri.EscapeDataString(SessionId)}");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}
