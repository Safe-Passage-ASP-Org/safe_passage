@page "/roles"
@rendermode InteractiveServer
@using SafePassage.Web.Services
@inject AdminApiClient Api

<PageTitle>Roles &amp; Permissions – Safe Passage</PageTitle>

<div class="sp-page-header">
    <h1 class="sp-page-title">Roles &amp; Permissions</h1>
    <p class="sp-page-subtitle">Review the built-in roles currently returned by the security API.</p>
</div>

@if (Loading)
{
    <div class="sp-card roles-state" role="status" aria-live="polite">Loading roles…</div>
}
else if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="roles-error" role="alert">
        <span>@Error</span>
        <button type="button" class="roles-retry" @onclick="LoadRolesAsync">Try again</button>
    </div>
}
else if (SupportedRoles.Count == 0)
{
    <div class="sp-card roles-state">No role definitions were returned by the API.</div>
}
else
{
    <div class="roles-summary" aria-live="polite">@SupportedRoles.Count built-in roles</div>
    <section class="roles-grid" aria-label="Built-in roles">
        @foreach (var role in SupportedRoles)
        {
            <article class="sp-card role-card">
                <div class="role-card-heading">
                    <span class="role-glyph" aria-hidden="true">♙</span>
                    <span class="role-code">@role.Id</span>
                </div>
                <h2>@role.Name</h2>
                <p>@role.Description</p>
            </article>
        }
    </section>
    <aside class="roles-note">
        <strong>Permission editing is not available yet.</strong>
        The API currently returns fixed role definitions and enforces access through fixed role names.
        Custom roles and editable permission assignments require backend support.
    </aside>
}

<style>
    .roles-summary { margin: 0 0 12px; color: #64748b; font-size: 13px; }
    .roles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 14px; }
    .role-card { min-width: 0; padding: 18px; }
    .role-card-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .role-glyph { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 8px; background: #e5f2ed; color: #087f75; font-size: 18px; }
    .role-code { overflow-wrap: anywhere; color: #64748b; font-size: 11px; }
    .role-card h2 { margin: 16px 0 6px; font-size: 16px; }
    .role-card p { margin: 0; color: #64748b; font-size: 13px; line-height: 1.55; }
    .roles-state { padding: 24px; color: #64748b; font-size: 13px; }
    .roles-error, .roles-note { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px; padding: 12px 15px; border: 1px solid #e5d5a8; border-radius: 6px; background: #fffaf0; color: #715c37; font-size: 13px; line-height: 1.5; }
    .roles-error { justify-content: space-between; border-color: #f2c2be; background: #fcecea; color: #9d332b; }
    .roles-note { display: block; margin: 16px 0 0; }
    .roles-retry { flex: 0 0 auto; border: 0; background: transparent; color: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; }
</style>

@code {
    private List<AdminRole> SupportedRoles = [];
    private bool Loading = true;
    private string Error = "";

    protected override Task OnInitializedAsync() => LoadRolesAsync();

    private async Task LoadRolesAsync()
    {
        Loading = true;
        Error = "";
        try
        {
            SupportedRoles = await Api.GetRolesAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Loading = false;
        }
    }
}
