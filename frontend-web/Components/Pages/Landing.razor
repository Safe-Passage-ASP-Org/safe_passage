    .visual-event>span:nth-child(2){display:grid;gap:3px;flex:1}.visual-event b{font-size:8px;color:#334155}.visual-event small{font-size:7px;color:#94a3b8}.visual-event i{font-style:normal;font-size:6px;font-weight:800;letter-spacing:.5px}.event-ok{color:#059669}.event-neutral{color:#64748b}
    .visual-floating{position:absolute;z-index:3;right:-2px;bottom:40px;display:flex;align-items:center;gap:10px;padding:12px 15px;background:#fff;border:1px solid #e2e8f0;border-radius:7px;box-shadow:0 10px 30px rgba(15,23,42,.1);transform:rotate(2deg)}
    .visual-floating>span{width:28px;height:28px;display:grid;place-items:center;border-radius:7px;background:#e0f2fe;color:#0284c7}.visual-floating div{display:grid;gap:3px}.visual-floating b{font-size:9px;color:#1e293b}.visual-floating small{font-size:7px;color:#94a3b8}
    .landing-scroll{position:absolute;bottom:25px;left:max(calc((100vw - 1152px)/2),48px);display:flex;align-items:center;gap:9px;font-size:8px;font-weight:750;letter-spacing:1.2px;color:#94a3b8}.landing-scroll span{width:1px;height:21px;background:#0ea5e9}
    .landing-platform{max-width:1152px;margin:0 auto;padding:93px 28px 98px}
    .section-heading{text-align:center;max-width:570px;margin:0 auto 43px}.section-heading .landing-kicker{justify-content:center}
    .section-heading h2,.how-copy h2{margin:17px 0 12px;font-size:36px;line-height:1.18;letter-spacing:-1.6px;color:#0f172a}.section-heading h2 span{color:#0284c7}
    .section-heading p,.how-copy>p{margin:0;color:#64748b;font-size:13px;line-height:1.8}
    .landing-features{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
    .feature-card{padding:21px 20px 22px;border:1px solid #e5eaf0;border-radius:7px;background:#fff;box-shadow:0 5px 16px rgba(15,23,42,.035);transition:transform .2s,box-shadow .2s}
