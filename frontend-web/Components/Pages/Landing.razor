@page "/"
@layout AuthLayout

<PageTitle>Safe Passage – Identity &amp; Device Security</PageTitle>

<div class="landing-page">
    <header class="landing-header">
        <a class="landing-brand" href="/" aria-label="Safe Passage home">
            <span class="landing-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 2.7 4.5 5.5v5.2c0 5 3.2 8.6 7.5 10.6 4.3-2 7.5-5.6 7.5-10.6V5.5L12 2.7Z" />
                    <path d="m8.8 12.1 2.1 2.1 4.4-4.6" />
                </svg>
            </span>
            <span>Safe Passage</span>
        </a>
        <nav class="landing-nav" aria-label="Main navigation">
            <a href="#platform">Platform</a>
            <a href="#how-it-works">How it works</a>
        </nav>
        <div class="landing-account-links"><a class="landing-signin" href="/login">Sign in</a><a class="landing-join" href="/signup">Create account</a></div>
    </header>

    <main>
        <section class="landing-hero">
            <div class="landing-hero-copy">
                <div class="landing-kicker"><span></span> IDENTITY &amp; DEVICE SECURITY</div>
                <h1>Every access point.<br /><span>One safe passage.</span></h1>
                <p class="landing-intro">Bring people, trusted devices, and sign-in activity into one clear view. Safe Passage helps your team manage identity and make access easier to oversee.</p>
                <div class="landing-actions">
                    <a class="landing-primary" href="/signup">Create your account <span aria-hidden="true">→</span></a>
                    <a class="landing-secondary" href="/login">Already a member? Sign in</a>
                </div>
                <div class="landing-note"><span class="landing-note-icon" aria-hidden="true">✓</span> Built for visibility, control, and safer access.</div>
            </div>
            <div class="landing-visual" aria-label="Safe Passage security dashboard preview">
                <div class="visual-orbit orbit-one"></div>
                <div class="visual-orbit orbit-two"></div>
                <div class="visual-glow"></div>
                <div class="visual-card">
                    <div class="visual-topbar"><span class="visual-brand-dot"></span><span>SAFE PASSAGE</span><span class="visual-live"><i></i> OVERVIEW</span></div>
                    <div class="visual-heading"><div><small>SECURITY OVERVIEW</small><strong>Access at a glance</strong></div><span class="visual-calendar">Today <b>⌄</b></span></div>
                    <div class="visual-stats">
                        <div><small>IDENTITIES</small><strong>Managed</strong><span>Central directory</span></div>
                        <div><small>DEVICES</small><strong>Reviewed</strong><span>Trust status</span></div>
                        <div><small>ACTIVITY</small><strong>Visible</strong><span>Recent events</span></div>
                    </div>
                    <div class="visual-event-title"><strong>Recent activity</strong><span>LIVE VIEW</span></div>
                    <div class="visual-event"><span class="event-icon event-shield">✓</span><span><b>Sign-in approved</b><small>Mobile approval · Just now</small></span><i class="event-ok">SUCCESS</i></div>
                    <div class="visual-event"><span class="event-icon event-device">▣</span><span><b>Device enrolled</b><small>Trusted device · 4 min ago</small></span><i class="event-ok">VERIFIED</i></div>
                    <div class="visual-event"><span class="event-icon event-user">◎</span><span><b>Identity updated</b><small>User directory · 12 min ago</small></span><i class="event-neutral">AUDIT</i></div>
                </div>
                <div class="visual-floating"><span>✦</span><div><b>Stay in control</b><small>Identity. Devices. Activity.</small></div></div>
            </div>
            <div class="landing-scroll"><span></span> SCROLL TO EXPLORE</div>
        </section>

        <section class="landing-platform" id="platform">
            <div class="section-heading">
                <div class="landing-kicker"><span></span> THE PLATFORM</div>
                <h2>Security operations,<br /><span>made easier to see.</span></h2>
                <p>Keep essential identity and device workflows together, with security activity visible to the people who manage access.</p>
            </div>
            <div class="landing-features">
                <article class="feature-card">
                    <span class="feature-icon feature-blue" aria-hidden="true">◎</span>
                    <small>01 / IDENTITY</small>
                    <h3>Manage your directory</h3>
                    <p>Organize user accounts, groups, and roles from one administrator workspace.</p>
                </article>
                <article class="feature-card">
                    <span class="feature-icon feature-teal" aria-hidden="true">▣</span>
                    <small>02 / DEVICES</small>
                    <h3>Know what’s connected</h3>
                    <p>Review enrolled devices and their trust status alongside the people who use them.</p>
                </article>
                <article class="feature-card">
                    <span class="feature-icon feature-violet" aria-hidden="true">⌁</span>
                    <small>03 / VERIFICATION</small>
                    <h3>Approve with confidence</h3>
                    <p>Use mobile sign-in approval to add a confirmation step to administrator access.</p>
                </article>
                <article class="feature-card">
                    <span class="feature-icon feature-amber" aria-hidden="true">≋</span>
                    <small>04 / VISIBILITY</small>
                    <h3>Follow the activity</h3>
                    <p>See recorded security events and review account and device activity in context.</p>
                </article>
            </div>
        </section>

        <section class="landing-how" id="how-it-works">
            <div class="how-copy">
                <div class="landing-kicker"><span></span> A CLEARER WAY TO MANAGE ACCESS</div>
                <h2>From identity<br />to trusted access.</h2>
                <p>Safe Passage connects everyday account administration with device awareness and sign-in verification—so your team can act with a better view of what’s happening.</p>
                <a class="how-link" href="/signup">Create a Safe Passage account <span aria-hidden="true">→</span></a>
            </div>
            <div class="how-steps">
                <div class="how-step"><span>01</span><div><b>Manage identities</b><p>Keep account and role administration in one place.</p></div><i>→</i></div>
                <div class="how-step"><span>02</span><div><b>Connect trusted devices</b><p>Enroll mobile devices and review their status.</p></div><i>→</i></div>
                <div class="how-step"><span>03</span><div><b>Review access activity</b><p>Use sign-in approvals and recorded events to stay informed.</p></div><i>✓</i></div>
            </div>
        </section>
    </main>

    <footer class="landing-footer">
        <a class="landing-brand" href="/" aria-label="Safe Passage home">
            <span class="landing-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.7 4.5 5.5v5.2c0 5 3.2 8.6 7.5 10.6 4.3-2 7.5-5.6 7.5-10.6V5.5L12 2.7Z" /><path d="m8.8 12.1 2.1 2.1 4.4-4.6" /></svg>
            </span>
            <span>Safe Passage</span>
        </a>
        <span>Identity &amp; device security, with a clearer view.</span>
        <a href="/login">Sign in <span aria-hidden="true">→</span></a>
    </footer>
</div>

<style>
    .landing-page{--lp-ink:#0f172a;--lp-muted:#64748b;--lp-blue:#0ea5e9;--lp-blue-dark:#0284c7;--lp-navy:#07111f;--lp-line:#e2e8f0;color:var(--lp-ink);background:#fff;font-family:'Inter','Segoe UI',system-ui,-apple-system,sans-serif}
    .landing-header{height:78px;max-width:1220px;margin:auto;padding:0 34px;display:flex;align-items:center;justify-content:space-between}
