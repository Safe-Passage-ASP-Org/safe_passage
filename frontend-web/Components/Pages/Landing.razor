    .landing-note{display:flex;align-items:center;gap:9px;margin-top:29px;font-size:10px;color:#64748b}
    .landing-note-icon{width:17px;height:17px;display:grid;place-items:center;border-radius:50%;background:#dcfce7;color:#059669;font-size:10px;font-weight:800}
    .landing-visual{position:relative;z-index:1;min-height:408px;display:flex;align-items:center;justify-content:center}
