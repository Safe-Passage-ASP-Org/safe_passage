    .feature-icon{width:39px;height:39px;display:grid;place-items:center;margin-bottom:18px;border-radius:9px;font-size:22px;font-weight:600}
    .feature-blue{background:#e0f2fe;color:#0284c7}.feature-teal{background:#ccfbf1;color:#0f766e}.feature-violet{background:#ede9fe;color:#7c3aed}.feature-amber{background:#fef3c7;color:#b45309}
    .feature-card>small{font-size:8px;letter-spacing:1px;font-weight:800;color:#94a3b8}.feature-card h3{margin:10px 0 8px;font-size:14px;color:#17212b}.feature-card p{margin:0;color:#64748b;font-size:11px;line-height:1.7}
