    .landing-kicker>span{display:inline-block;width:19px;height:2px;background:#0ea5e9;border-radius:2px}
    .landing-hero h1{margin:23px 0 18px;font-size:clamp(42px,5.2vw,66px);line-height:1.04;letter-spacing:-3.7px;font-weight:750;color:#0f172a}
    .landing-hero h1 span{color:#0284c7}
    .landing-intro{max-width:460px;margin:0;color:#526174;font-size:15px;line-height:1.85}
