    .landing-footer>span{font-size:10px;color:#94a3b8}.landing-footer>a:last-child{font-size:10px;font-weight:700;color:#475569;text-decoration:none}.landing-footer>a:last-child span{color:#0284c7;margin-left:5px}
    @@media(max-width:900px){.landing-hero{padding-left:42px;padding-right:42px;grid-template-columns:1fr 1fr;min-height:525px}.landing-hero h1{font-size:48px}.visual-card{padding:16px}.landing-features{grid-template-columns:repeat(2,1fr)}.landing-how{gap:45px;padding-left:44px;padding-right:44px}}
    @@media(max-width:650px){.landing-header{height:68px;padding:0 20px}.landing-nav{display:none}.landing-account-links{gap:10px}.landing-signin{font-size:11px}.landing-join{padding:8px 10px;font-size:10px}.landing-hero{display:flex;flex-direction:column;align-items:stretch;gap:8px;padding:56px 23px 62px}.landing-hero-copy{padding:0}.landing-hero h1{font-size:44px;letter-spacing:-2.7px;margin:20px 0 14px}.landing-intro{font-size:13px;line-height:1.75}.landing-actions{gap:16px;margin-top:23px}.landing-primary{padding:13px 14px;gap:12px;font-size:11px}.landing-secondary{font-size:10px}.landing-note{margin-top:20px;font-size:9px}.landing-visual{min-height:330px;margin-top:12px}.visual-card{max-width:390px;padding:15px 14px 10px;transform:none}.visual-orbit.orbit-one{width:320px;height:320px}.visual-orbit.orbit-two{width:255px;height:255px}.visual-floating{right:0;bottom:8px;padding:9px 11px}.landing-scroll{display:none}.landing-platform{padding:67px 21px 70px}.section-heading{margin-bottom:30px}.section-heading h2{font-size:31px}.section-heading p{font-size:12px}.landing-features{gap:10px}.feature-card{padding:17px 14px}.feature-icon{width:35px;height:35px;margin-bottom:13px}.feature-card h3{font-size:12px}.feature-card p{font-size:10px}.landing-how{grid-template-columns:1fr;gap:30px;padding:59px 23px}.how-copy h2{font-size:35px}.landing-footer{padding:20px;flex-wrap:wrap}.landing-footer>span{order:3;width:100%;text-align:center}.landing-footer>a:last-child{font-size:9px}}
    @@media(max-width:380px){.landing-hero h1{font-size:39px}.landing-actions{align-items:flex-start;flex-direction:column;gap:14px}.visual-event{gap:6px}.visual-event i{font-size:5px}.visual-card{padding-left:11px;padding-right:11px}}
    @@media(prefers-reduced-motion:reduce){.feature-card,.landing-primary{transition:none}}
</style>
