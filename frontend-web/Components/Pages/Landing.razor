    .landing-brand-mark{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:#e0f2fe;color:#0284c7}
    .landing-brand-mark svg{width:21px;height:21px;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .landing-nav{display:flex;gap:36px;margin-left:100px}
    .landing-account-links{display:flex;align-items:center;gap:18px}
    .landing-nav a,.landing-signin{font-size:12px;font-weight:600;color:#475569;text-decoration:none;transition:color .2s}
    .landing-nav a:hover,.landing-signin:hover,.landing-footer>a:last-child:hover{color:#0284c7}
    .landing-signin{color:#0f172a}.landing-signin span{color:#0284c7;margin-left:6px}
    .landing-join{padding:10px 14px;border:1px solid #0284c7;border-radius:5px;color:#0284c7;text-decoration:none;font-size:11px;font-weight:700;transition:background .15s,color .15s}
    .landing-join:hover{background:#0284c7;color:#fff}
    .landing-hero{position:relative;min-height:570px;overflow:hidden;background:radial-gradient(ellipse at 82% 43%,rgba(14,165,233,.13),transparent 38%),linear-gradient(112deg,#f8fafc 0%,#fff 54%,#f0f9ff 100%);display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:22px;padding:62px max(calc((100vw - 1152px)/2),48px) 90px}
    .landing-hero-copy{position:relative;z-index:2;max-width:530px;padding-bottom:8px}
