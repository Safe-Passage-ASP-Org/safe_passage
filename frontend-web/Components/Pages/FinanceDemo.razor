@page "/finance-demo"
@layout AuthLayout
@implements IDisposable
@using SafePassage.Web.Services
@inject AdminApiClient Api
@inject IConfiguration Configuration

<PageTitle>Company Finance Demo</PageTitle>

<main class="finance-demo">
    <header class="finance-header">
        <a class="finance-brand" href="/" aria-label="Safe Passage home">
            <span class="finance-mark">CF</span>
            <span><strong>Company Finance</strong><small>DEMO APPLICATION</small></span>
        </a>
        <span class="finance-protected"><i></i> Protected by Safe Passage</span>
    </header>

    @if (Unlocked)
    {
        <section class="finance-workspace" aria-labelledby="finance-title">
            <div class="finance-workspace-head">
                <div><span class="finance-kicker">FINANCE OPERATIONS</span><h1 id="finance-title">Overview</h1><p>Welcome, @SignedInAs</p></div>
                <button class="finance-secondary" type="button" @onclick="SignOut">Sign out</button>
            </div>
            <div class="finance-approved" role="status"><span class="finance-approved-check">✓</span><span><strong>Application access verified</strong><small>Safe Passage authorized Company Finance for this session.</small></span><b>SECURE</b></div>
            <p class="finance-demo-notice">Demo workspace · All figures below are fictional and for demonstration only.</p>
            <div class="finance-metrics">
                <article><span>Operating cash</span><strong>$4.82M</strong><small class="positive">+4.8% this quarter</small></article>
                <article><span>Quarterly revenue</span><strong>$1.26M</strong><small class="positive">+9.2% year over year</small></article>
                <article><span>Open invoices</span><strong>284</strong><small class="neutral">$318K total</small></article>
                <article><span>Payroll forecast</span><strong>$742K</strong><small class="neutral">Due in 6 days</small></article>
            </div>
            <section class="finance-activity"><div class="finance-activity-heading"><h2>Recent activity</h2><span>DEMO DATA</span></div>
                <article><i></i><div><strong>Quarterly report exported</strong><small>Finance team · 10:42 AM</small></div><b>+$82,400</b></article>
                <article><i class="muted"></i><div><strong>Payroll batch approved</strong><small>Operations · 9:18 AM</small></div><b>−$216,800</b></article>
                <article><i></i><div><strong>Vendor payment scheduled</strong><small>Accounts payable · 8:05 AM</small></div><b>−$12,600</b></article>
            </section>
        </section>
    }
    else if (MfaPending)
    {
        <section class="finance-auth-card" aria-labelledby="finance-mfa-title">
            <span class="finance-kicker">SAFE PASSAGE APPROVAL</span>
            <div class="finance-lock" aria-hidden="true">⌑</div>
            <h1 id="finance-mfa-title">Approve this sign-in</h1>
            <p>Open Safe Passage on your trusted mobile device and approve the Company Finance request. This demo will continue automatically after approval.</p>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="finance-error" role="alert">@Error
                    @if (Error.Contains("No active mobile device", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="finance-device-setup"><a href="@MobileUrl" target="_blank" rel="noopener noreferrer">Open Safe Passage Mobile</a> and choose <strong>First time on this phone? Set up device</strong>. Then return here and sign in again.</div>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Notice)) { <p class="finance-notice" role="status">@Notice</p> }
            <div class="finance-pending"><span class="finance-spinner" aria-hidden="true"></span><span><strong>Waiting for mobile approval</strong><small>Keep this page open while you approve the request.</small></span></div>
            <button class="finance-link-button" type="button" @onclick="ResendApprovalAsync" disabled="@Busy">@(Busy ? "Sending…" : "Resend approval request")</button>
            <button class="finance-secondary finance-full" type="button" @onclick="CancelMfa">Cancel sign-in</button>
        </section>
    }
    else
    {
        <section class="finance-auth-card" aria-labelledby="finance-title">
            <span class="finance-kicker">FINANCE OPERATIONS · CF / 01</span>
            <div class="finance-lock" aria-hidden="true">$</div>
            <h1 id="finance-title">Confidential<br />finance data.</h1>
            <p>This demo dashboard uses fictional data. Sign in with a Safe Passage user account, then approve the sign-in on your trusted mobile device.</p>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="finance-error" role="alert">@Error
                    @if (Error.Contains("No active mobile device", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="finance-device-setup"><a href="@MobileUrl" target="_blank" rel="noopener noreferrer">Open Safe Passage Mobile</a> and choose <strong>First time on this phone? Set up device</strong>. Then return here and sign in again.</div>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Notice)) { <div class="finance-notice" role="status">@Notice</div> }
            <form class="finance-login" @onsubmit="SignInAsync" @onsubmit:preventDefault="true">
                <label for="finance-username">Username or email</label>
                <input id="finance-username" @bind="Username" autocomplete="username" autocapitalize="none" required disabled="@Busy" />
                <label for="finance-password">Password</label>
                <input id="finance-password" type="password" @bind="Password" autocomplete="current-password" required disabled="@Busy" />
                <button class="finance-primary" type="submit" disabled="@Busy">@(Busy ? "Connecting…" : "Continue securely") <span aria-hidden="true">→</span></button>
            </form>
            <p class="finance-login-foot">Application access is checked after sign-in. If you are not assigned, request access from Browse applications in Safe Passage.</p>
        </section>
    }
    <footer class="finance-footer">Safe Passage · Company Finance test application · No real financial data</footer>
</main>

