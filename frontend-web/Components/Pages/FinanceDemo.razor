8}.finance-primary,.finance-secondary{min-height:42px;padding:0 14px;border-radius:6px;font:inherit;font-size:11px;font-weight:700;cursor:pointer}.finance-primary{display:flex;justify-content:center;align-items:center;gap:9px;margin-top:11px;border:0;background:#155c47;color:#fff}.finance-primary:hover:not(:disabled){background:#104a39}.finance-primary:disabled{opacity:.65;cursor:wait}.finance-secondary{border:1px solid #d3ddd5;background:#fff;color:#33443a}.finance-secondary:hover{background:#f5f8f5}.finance-full{width:100%;margin-top:10px}.finance-login-foot{margin:16px 0 0!important;font-size:10px!important}.finance-error,.finance-notice{padding:11px 12px;border-radius:6px;font-size:11px;line-height:1.5}.finance-error{border:1px solid #f0c8c2;background:#fff1ef;color:#9d332b}.finance-notice{border:1px solid #cfe3d5;background:#eff8f1;color:#236344}.finance-pending{display:flex;align-items:center;gap:11px;margin:22px 0 16px;padding:14px;border:1px solid #cfe3d5;border-radius:7px;background:#f2f8f3}.finance-pending>span:last-child{display:grid;gap:4px}.finance-pending strong{color:#254536;font-size:11px}.finance-pending small{color:#718077;font-size:10px}.finance-spinner{width:18px;height:18px;border:2px solid #c6ddd0;border-top-color:#268268;border-radius:50%;animation:finance-spin .8s linear infinite}@@keyframes finance-spin{to{transform:rotate(360deg)}}.finance-link-button{width:100%;padding:9px;border:0;background:none;color:#1f755c;font:inherit;font-size:10px;font-weight:700;cursor:pointer}.finance-link-button:disabled{opacity:.6;cursor:wait}.finance-workspace{max-width:1000px;margin:44px auto 0}.finance-workspace-head{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.finance-workspace-head h1{margin-top:7px}.finance-workspace-head p{margin:5px 0 0;color:var(--fd-muted);font-size:11px}.finance-approved{display:flex;align-items:center;gap:11px;padding:14px 16px;border:1px solid #cce2d2;border-radius:8px;background:#edf7ef}.finance-approved-check{width:29px;height:29px;display:grid;place-items:center;border-radius:50%;background:#d8eddd;color:#167255;font-size:15px;font-weight:800}.finance-approved>span:nth-child(2){display:grid;gap:3px;flex:1}.finance-approved strong{font-size:11px;color:#254536}.finance-approved small{font-size:10px;color:#6e8174}.finance-approved>b{color:#237452;font-size:8px;letter-spacing:1px}.finance-demo-notice{margin:16px 0 9px;color:#77867c;font-size:9px}.finance-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.finance-metrics article{min-height:112px;display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:15px;border:1px solid var(--fd-line);border-radius:8px;background:#fff}.finance-metrics article>span{color:#77867c;font-size:10px}.finance-metrics article>strong{color:#20372b;font-size:22px;letter-spacing:-.4px}.finance-metrics article>small{font-size:9px;font-weight:650}.finance-metrics .positive{color:#1d805a}.finance-metrics .neutral{color:#9a7136}.finance-activity{margin-top:16px;border:1px solid var(--fd-line);border-radius:8px;background:#fff}.finance-activity-heading{display:flex;align-items:center;justify-content:space-between;padding:15px 17px;border-bottom:1px solid #edf1ed}.finance-activity-heading h2{margin:0;color:#20372b;font-size:13px}.finance-activity-heading span{color:#89968d;font-size:8px;letter-spacing:1px}.finance-activity article{display:flex;align-items:center;gap:11px;padding:13px 17px;border-bottom:1px solid #f0f3f0}.finance-activity article:last-child{border-bottom:0}.finance-activity article>i{flex:none}.finance-activity article>i.muted{background:#b4c1b8}.finance-activity article>div{display:grid;gap:4px;flex:1}.finance-activity article strong{color:#34473a;font-size:10px}.finance-activity article small{color:#89958c;font-size:9px}.finance-activity article>b{color:#3a5544;font-size:10px}.finance-footer{max-width:1000px;margin:24px auto 0;color:#91a097;font-size:9px;text-align:center}
    .finance-device-setup{margin-top:7px;line-height:1.6}.finance-device-setup a{color:#155c47;font-weight:700}
    @@media(max-width:700px){.finance-demo{padding:0 15px 22px}.finance-header{height:64px}.finance-auth-card{margin-top:28px;padding:27px 22px}.finance-workspace{margin-top:26px}.finance-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.finance-approved{align-items:flex-start}.finance-approved>b{padding-top:4px}}
</style>

@code {
    private static readonly Guid FinanceApplicationId = Guid.Parse("66666666-6666-6666-6666-666666666666");
    private string Username = "";
    private string Password = "";
    private string SignedInAs = "";
    private string Error = "";
    private string Notice = "";
    private string? SessionToken;
    private bool Busy;
    private bool MfaPending;
    private bool Unlocked;
    private CancellationTokenSource? PollCancellation;
    private string MobileUrl => Configuration["Mobile:PublicUrl"] ?? "https://safepassage-mobile.vercel.app/";

    private async Task SignInAsync()
    {
        if (Busy) return;
        Busy = true; Error = ""; Notice = "";
        try
        {
            var result = await Api.LoginAsync(Username.Trim(), Password);
            if (result.MfaRequired)
            {
                SessionToken = result.SessionToken;
                if (string.IsNullOrWhiteSpace(SessionToken)) throw new InvalidOperationException("Safe Passage did not return an approval session.");
                MfaPending = true;
                StartPolling();
                return;
            }
            await VerifyAccessAsync();
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { Busy = false; }
    }

    private void StartPolling()
    {
        PollCancellation?.Cancel();
        PollCancellation?.Dispose();
        PollCancellation = new CancellationTokenSource(TimeSpan.FromMinutes(10));
        _ = PollForApprovalAsync(PollCancellation.Token);
    }

    private async Task PollForApprovalAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested && MfaPending)
        {
            try
            {
                if (await Api.CompleteMfaAsync(SessionToken!, cancellationToken))
                {
                    await InvokeAsync(async () =>
                    {
                        MfaPending = false;
                        await VerifyAccessAsync();
                        StateHasChanged();
                    });
                    return;
                }
                await Task.Delay(1500, cancellationToken);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
            catch (Exception exception)
            {
                await InvokeAsync(() =>
                {
                    MfaPending = false;
                    SessionToken = null;
                    Error = exception.Message;
                    StateHasChanged();
                });
                return;
            }
        }
    }

    private async Task VerifyAccessAsync()
    {
        if (Api.IsAdministrator)
        {
            Api.SignOut();
            throw new InvalidOperationException("Use a user account to sign in to Company Finance. Administrators should use the admin login.");
        }

        if (string.IsNullOrWhiteSpace(Api.AccessToken))
            throw new InvalidOperationException("Safe Passage did not issue an access token. Sign in again.");

        var decision = await Api.VerifyApplicationAccessAsync(FinanceApplicationId);
        if (!decision.Allowed)
        {
            Api.SignOut();
            Error = decision.Reason switch
            {
                "account_inactive" => "Your Safe Passage account is inactive.",
                "application_not_found" => "The Company Finance demo is not registered in Safe Passage. Contact the project administrator.",
                "access_not_assigned" => "You are not assigned to Company Finance yet. Request access from Browse applications in Safe Passage and ask an administrator to approve it.",
                "trusted_device_required" => "A trusted mobile device is required to access this demo.",
                "device_posture_noncompliant" => "Your trusted device does not meet the current security policy.",
                _ => $"Safe Passage denied access ({decision.Reason})."
            };
            return;
        }

        SignedInAs = Api.CurrentUsername ?? Username.Trim();
        Error = "";
        MfaPending = false;
        Unlocked = true;
    }

    private async Task ResendApprovalAsync()
    {
        if (string.IsNullOrWhiteSpace(SessionToken) || Busy) return;
        Busy = true; Error = ""; Notice = "";
        try { await Api.ResendMfaApprovalAsync(SessionToken); Notice = "Approval request resent to your trusted mobile device."; }
        catch (Exception exception) { Error = exception.Message; }
        finally { Busy = false; }
    }

    private void CancelMfa()
    {
        PollCancellation?.Cancel();
        Api.SignOut();
        SessionToken = null; MfaPending = false; Password = ""; Error = ""; Notice = "";
    }

    private void SignOut()
    {
        PollCancellation?.Cancel();
        Api.SignOut();
        SessionToken = null; MfaPending = false; Unlocked = false; Username = ""; Password = ""; SignedInAs = ""; Error = ""; Notice = "";
    }

    public void Dispose()
    {
        PollCancellation?.Cancel();
        PollCancellation?.Dispose();
    }
}
