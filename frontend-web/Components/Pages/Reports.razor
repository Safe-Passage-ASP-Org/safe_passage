@page "/reports"
@rendermode InteractiveServer

<PageTitle>Insights &amp; Reports – Safe Passage</PageTitle>

<div class="sp-page-header">
    <h1 class="sp-page-title">Insights &amp; Reports</h1>
    <p class="sp-page-subtitle">Security analytics, compliance summaries, and exportable audit reports.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="sp-stat-card">
            <span class="sp-stat-label">Auth Success Rate</span>
            <span class="sp-stat-value" style="color:var(--sp-success)">98.2%</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="sp-stat-card">
            <span class="sp-stat-label">Threats Blocked (30d)</span>
            <span class="sp-stat-value">1,034</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="sp-stat-card">
            <span class="sp-stat-label">Avg. MFA Latency</span>
            <span class="sp-stat-value">1.8s</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="sp-stat-card">
            <span class="sp-stat-label">Compliance Score</span>
            <span class="sp-stat-value" style="color:var(--sp-success)">94/100</span>
        </div>
    </div>
</div>

<div class="sp-card d-flex flex-column align-items-center justify-content-center py-5 text-center">
    <div class="sp-placeholder-icon">📈</div>
    <h5 class="fw-semibold mb-2">Insights &amp; Reports</h5>
    <p class="text-muted" style="max-width:420px">
        Interactive charts for login trends, MFA adoption, device trust distribution, and exportable compliance reports will appear here.
    </p>
    <button class="btn btn-outline-primary mt-3" disabled>
        Generate Report
    </button>
</div>
