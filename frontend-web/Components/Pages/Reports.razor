@page "/reports"
@rendermode InteractiveServer
@using SafePassage.Web.Services
@inject AdminApiClient Api

<PageTitle>Insights &amp; Reports – Safe Passage</PageTitle>
<div class="sp-page-header"><h1 class="sp-page-title">Insights &amp; Reports</h1><p class="sp-page-subtitle">A live summary derived from the latest records stored in the platform.</p></div>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="report-error" role="alert">@Error</div> }
<div class="sp-stat-grid"><div class="sp-stat-card"><span class="sp-stat-label">Recent login success rate</span><span class="sp-stat-value">@(Loading ? "—" : (LoginAttempts == 0 ? "N/A" : $"{LoginSuccessRate:F1}%"))</span><span class="sp-stat-change">@(Loading ? "Loading" : $"{LoginAttempts} login events in the latest 250 audit records")</span></div><div class="sp-stat-card"><span class="sp-stat-label">Denied events</span><span class="sp-stat-value">@(Loading ? "—" : DeniedCount.ToString())</span><span class="sp-stat-change">Latest audit records</span></div><div class="sp-stat-card"><span class="sp-stat-label">Trusted devices</span><span class="sp-stat-value">@(Loading ? "—" : TrustedCount.ToString())</span><span class="sp-stat-change">Active and trusted</span></div><div class="sp-stat-card"><span class="sp-stat-label">Registered applications</span><span class="sp-stat-value">@(Loading ? "—" : ApplicationCount.ToString())</span><span class="sp-stat-change">Application registry</span></div></div>
<section class="sp-card report-card"><h2>Report coverage</h2><p>These figures use the latest 250 audit records because the current API does not yet provide date-range queries or historical aggregates. IP addresses, MFA latency, and compliance scoring are not collected, so this page does not estimate them.</p><a href="/activity-logs">Review audit records →</a></section>
<style>.report-error{padding:11px 14px;border-radius:6px;margin-bottom:14px;background:#fcecea;color:#9d332b;font-size:13px}.report-card{margin-top:16px;padding:20px}.report-card h2{font-size:15px;margin:0 0 8px}.report-card p{font-size:12px;color:#64748b;line-height:1.6;max-width:800px}.report-card a{font-size:12px;color:#087f75;font-weight:650;text-decoration:none}</style>
@code {
    private bool Loading = true;
    private string Error = "";
    private int LoginAttempts, DeniedCount, TrustedCount, ApplicationCount, LoginSuccessRate;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var activity = await Api.GetAdminActivityAsync(); var devices = await Api.GetDevicesAsync(); var applications = await Api.GetApplicationsAsync();
            var logins = activity.Where(item => item.Action.Contains("login", StringComparison.OrdinalIgnoreCase)).ToList();
            LoginAttempts = logins.Count; LoginSuccessRate = LoginAttempts == 0 ? 0 : (int)Math.Round(logins.Count(item => item.Status.Equals("Success", StringComparison.OrdinalIgnoreCase)) * 100d / LoginAttempts, MidpointRounding.AwayFromZero);
            DeniedCount = activity.Count(item => item.Status.Equals("Denied", StringComparison.OrdinalIgnoreCase));
            TrustedCount = devices.Count(device => device.Status == "ACTIVE" && device.TrustStatus == "TRUSTED"); ApplicationCount = applications.Count;
        }
        catch (Exception ex) { Error = ex.Message; }
        finally { Loading = false; }
    }
}
