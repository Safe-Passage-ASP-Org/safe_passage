@page "/dashboard"
@using SafePassage.Web.Services
@inject AdminApiClient Api

<PageTitle>Dashboard – Safe Passage</PageTitle>
<div class="sp-page-header home-page-header">
    <div><h1 class="sp-page-title">Dashboard</h1><p class="sp-page-subtitle">@(Api.IsAdministrator ? "Current identity, device, and security activity from the platform." : "Your account and assigned applications.")</p></div>
    <button class="home-refresh" type="button" @onclick="LoadDashboardAsync" disabled="@Loading">@(Loading ? "Refreshing…" : "Refresh")</button>
</div>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="home-error" role="alert">@Error</div> }
@if (Api.IsAdministrator)
{
<div class="sp-stat-grid">
    <div class="sp-stat-card"><span class="sp-stat-label">Total Users</span><span class="sp-stat-value">@FormatMetric(TotalUsers)</span><span class="sp-stat-change">Directory accounts</span></div>
    <div class="sp-stat-card"><span class="sp-stat-label">Trusted Devices</span><span class="sp-stat-value">@FormatMetric(TrustedDevices)</span><span class="sp-stat-change">Active and trusted</span></div>
    <div class="sp-stat-card"><span class="sp-stat-label">MFA Events (24h)</span><span class="sp-stat-value">@FormatMetric(MfaEvents)</span><span class="sp-stat-change">Within latest 250 activity records</span></div>
    <div class="sp-stat-card"><span class="sp-stat-label">Denied Events</span><span class="sp-stat-value" style="color:var(--sp-danger)">@FormatMetric(DeniedEvents)</span><span class="sp-stat-change">Within latest 250 activity records</span></div>
</div>
<section class="sp-card home-events"><div class="home-heading"><h2>Recent Security Events</h2><a href="/activity-logs">View activity logs →</a></div>
    @if (Loading) { <p class="home-state" role="status">Loading dashboard…</p> }
    else if (!string.IsNullOrWhiteSpace(Error)) { <p class="home-state">Recent activity could not be loaded.</p> }
    else if (RecentEvents.Count == 0) { <p class="home-state">No activity has been recorded yet.</p> }
    else { <div class="home-event-list">@foreach (var item in RecentEvents) { <div class="home-event"><span class="home-dot @(item.Status.Equals("Success", StringComparison.OrdinalIgnoreCase) ? "ok" : "bad")"></span><div><strong>@item.Action</strong><small>@item.Username · @item.Resource</small></div><time>@item.Timestamp.ToLocalTime().ToString("MMM d, HH:mm")</time></div> }</div> }
</section>
}
else
{
    <div class="sp-stat-grid">
        <div class="sp-stat-card"><span class="sp-stat-label">Assigned applications</span><span class="sp-stat-value">@FormatMetric(MyApplications.Count)</span><span class="sp-stat-change">Applications assigned to your account or groups</span></div>
    </div>
    <section class="sp-card home-events">
        <div class="home-heading"><h2>Your Applications</h2><a href="/my-applications">View all →</a></div>
        @if (Loading) { <p class="home-state" role="status">Loading your applications…</p> }
        else if (!string.IsNullOrWhiteSpace(Error)) { <p class="home-state">Your assigned applications could not be loaded.</p> }
        else if (MyApplications.Count == 0) { <p class="home-state">No applications are assigned to your account yet. Contact your administrator if you expected access.</p> }
        else
        {
            <div class="home-event-list">
                @foreach (var application in MyApplications.Take(5))
                {
                    <div class="home-event"><span class="home-dot ok"></span><div><strong>@application.Name</strong><small>@application.Description</small></div></div>
                }
            </div>
        }
    </section>
}
<style>
    .home-page-header{display:flex;justify-content:space-between;align-items:center;gap:16px}.home-refresh{padding:8px 12px;border:1px solid #cbd5dc;border-radius:5px;background:#fff;color:#334155;font-size:12px;font-weight:650;cursor:pointer}.home-refresh:hover:not(:disabled){border-color:#087f75;color:#087f75}.home-refresh:disabled{opacity:.6;cursor:wait}
    .home-error{padding:11px 14px;border-radius:6px;margin-bottom:14px;background:#fcecea;color:#9d332b;font-size:13px}.home-events{overflow:hidden}.home-heading{display:flex;justify-content:space-between;align-items:center;padding:17px 20px;border-bottom:1px solid #edf0f2}.home-heading h2{font-size:15px;margin:0}.home-heading a{font-size:11px;color:#087f75;text-decoration:none;font-weight:650}.home-state{padding:20px;color:#64748b;font-size:13px}.home-event-list{padding:0 18px}.home-event{display:flex;align-items:center;gap:11px;padding:13px 0;border-bottom:1px solid #edf0f2}.home-event:last-child{border-bottom:0}.home-dot{width:8px;height:8px;flex:0 0 auto;border-radius:50%;background:#b5473c}.home-dot.ok{background:#099268}.home-event div{display:grid;gap:3px;flex:1;min-width:0}.home-event strong{font-size:12px;color:#26353c}.home-event small,.home-event time{font-size:10px;color:#64748b}.home-event time{white-space:nowrap}
    @@media(max-width:520px){.home-page-header{align-items:flex-start}.home-refresh{flex:0 0 auto}}
</style>
@code {
    private int? TotalUsers, TrustedDevices, MfaEvents, DeniedEvents;
    private bool Loading = true;
    private string Error = "";
    private List<AdminActivity> RecentEvents = [];
    private List<AccessibleApplication> MyApplications = [];

    protected override Task OnInitializedAsync() => LoadDashboardAsync();

    private string FormatMetric(int? value) =>
        Loading || !string.IsNullOrWhiteSpace(Error) || value is null ? "—" : value.Value.ToString();

    private async Task LoadDashboardAsync()
    {
        Loading = true;
        Error = "";
        TotalUsers = TrustedDevices = MfaEvents = DeniedEvents = null;
        RecentEvents = [];

        try
        {
            if (!Api.IsAdministrator)
            {
                MyApplications = await Api.GetMyApplicationsAsync();
                return;
            }

            var usersTask = Api.GetUsersAsync();
            var devicesTask = Api.GetDevicesAsync();
            var activityTask = Api.GetAdminActivityAsync();
            await Task.WhenAll(usersTask, devicesTask, activityTask);

            var users = await usersTask;
            var devices = await devicesTask;
            var activity = await activityTask;
            var since = DateTimeOffset.UtcNow.AddHours(-24);
            TotalUsers = users.Count;
            TrustedDevices = devices.Count(device => device.Status == "ACTIVE" && device.TrustStatus == "TRUSTED");
            MfaEvents = activity.Count(item => item.Timestamp >= since && item.Action.Contains("MFA", StringComparison.OrdinalIgnoreCase));
            DeniedEvents = activity.Count(item => item.Status.Equals("Denied", StringComparison.OrdinalIgnoreCase));
            RecentEvents = activity.Take(8).ToList();
        }
        catch (Exception ex) { Error = ex.Message; }
        finally { Loading = false; }
    }
}
