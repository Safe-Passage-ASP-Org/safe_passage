@page "/admin-otp"
@layout AuthLayout
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using SafePassage.Web.Services
@inject AdminApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Administrator Verification – Safe Passage</PageTitle>

<main class="signup-page">
    <a class="signup-brand" href="/" aria-label="Safe Passage home">
        <span class="signup-brand-mark" aria-hidden="true"><img src="/favicon.png" alt="" /></span>
        <span>Safe Passage</span>
    </a>
    <section class="signup-card" aria-labelledby="otp-title">
        <div class="signup-card-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.7 4.5 5.5v5.2c0 5 3.2 8.6 7.5 10.6 4.3-2 7.5-5.6 7.5-10.6V5.5L12 2.7Z" /><path d="m8.8 12.1 2.1 2.1 4.4-4.6" /></svg>
        </div>
        <p class="signup-eyebrow">ADMINISTRATOR ACCESS</p>
        <h1 id="otp-title">@(OtpRequested ? "Enter 6-digit Administrator OTP" : "Other verification method")</h1>
        <p class="signup-subtitle">
            @if (OtpRequested)
            {
                <span>Enter the verification code sent to <strong>@EmailAddress</strong>. After verification, you’ll still need approval on your trusted mobile device.</span>
            }
            else
            {
                <span>Request a 6-digit sign-in code by email instead of using the verification link.</span>
            }
        </p>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="signup-error" role="alert">@Error</div>
        }
        @if (!string.IsNullOrWhiteSpace(Notice))
        {
            <div class="signup-notice" role="status">@Notice</div>
        }

        @if (!OtpRequested)
        {
            <form @onsubmit="SendOtpAsync" @onsubmit:preventDefault="true">
                <label for="admin-otp-email">Administrator email address</label>
                <input id="admin-otp-email" type="email" autocomplete="email" @bind="EmailAddress" required disabled="@Sending" />
                <button class="signup-button" type="submit" disabled="@Sending">@(Sending ? "Sending OTP…" : "Send 6-digit OTP instead")</button>
            </form>
        }
        else
        {
            <form @onsubmit="VerifyAsync" @onsubmit:preventDefault="true">
                <label for="admin-otp-code">Verification code</label>
                <input id="admin-otp-code" type="text" inputmode="numeric" autocomplete="one-time-code"
                       @bind="Code" maxlength="6" minlength="6" pattern="[0-9]{6}" placeholder="123456" required disabled="@Verifying" style="letter-spacing:.35em;text-align:center;font-size:18px" />
                <button class="signup-button" type="submit" disabled="@Verifying">@(Verifying ? "Verifying…" : "Verify OTP")</button>
            </form>

            <p class="signup-subtitle" style="text-align:center;margin:16px 0 0;">
                Didn’t receive the code?
                <button class="login-link" type="button" @onclick="ResendAsync" disabled="@(Resending || ResendSeconds > 0)">
                    @(Resending ? "Sending…" : ResendSeconds > 0 ? $"Resend verification in {ResendSeconds}s" : "Resend verification")
                </button>
            </p>
        }
        <p class="signup-switch"><a href="@($"/admin-login?email={Uri.EscapeDataString(EmailAddress ?? string.Empty)}")" target="_top">← Back to Admin Login</a></p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private string EmailAddress = "";
    private string Code = "";
    private string Error = "";
    private string Notice = "";
    private int ResendSeconds;
    private bool Verifying;
    private bool Resending;
    private bool Sending;
    private bool OtpRequested;
    private CancellationTokenSource? CountdownCancellation;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email)) EmailAddress = Email;
    }

    private async Task SendOtpAsync()
    {
        Error = "";
        Notice = "";
        if (string.IsNullOrWhiteSpace(EmailAddress))
        {
            Error = "Enter your administrator email address first.";
            return;
        }

        Sending = true;
        try
        {
            await Api.RequestAdminEmailOtpAsync(EmailAddress.Trim());
            OtpRequested = true;
            Notice = "If this address belongs to an active administrator, a 6-digit verification code has been sent.";
            StartCountdown();
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { Sending = false; }
    }

    private async Task VerifyAsync()
    {
        Error = "";
        Notice = "";
        if (string.IsNullOrWhiteSpace(EmailAddress) || string.IsNullOrWhiteSpace(Code))
        {
            Error = "Enter the 6-digit verification code from your email.";
            return;
        }

        Verifying = true;
        try
        {
            var result = await Api.VerifyAdminEmailOtpAsync(EmailAddress.Trim(), Code.Trim());
            if (string.IsNullOrWhiteSpace(result.SessionToken))
                throw new InvalidOperationException("The API did not return an administrator approval session.");
            await JS.InvokeVoidAsync("safePassageAuthSession.savePendingMfa", result.SessionToken, "admin");
            Navigation.NavigateTo("/admin-login", forceLoad: true);
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { Verifying = false; }
    }

    private async Task ResendAsync()
    {
        if (string.IsNullOrWhiteSpace(EmailAddress) || ResendSeconds > 0 || Resending) return;
        Resending = true;
        Error = "";
        Notice = "";
        try
        {
            await Api.RequestAdminEmailOtpAsync(EmailAddress.Trim());
            Code = "";
            Notice = "If this address belongs to an active administrator, a new verification code has been sent.";
            StartCountdown();
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { Resending = false; }
    }

    private void StartCountdown()
    {
        CountdownCancellation?.Cancel();
        CountdownCancellation?.Dispose();
        CountdownCancellation = new CancellationTokenSource();
        ResendSeconds = 20;
        _ = RunCountdownAsync(CountdownCancellation.Token);
    }

    private async Task RunCountdownAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (ResendSeconds > 0)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                await InvokeAsync(() =>
                {
                    if (ResendSeconds > 0) ResendSeconds--;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        CountdownCancellation?.Cancel();
        CountdownCancellation?.Dispose();
    }
}
