    .directory-search{min-width:190px;border:1px solid #cbd5dc;border-radius:5px;padding:8px 10px;background:#fff;color:#334155;font:inherit;font-size:12px}
    .user-avatar-image{display:block;object-fit:cover;border:1px solid #d8dee4}.saved-site-heading{display:flex;align-items:center;gap:10px;min-width:0}.saved-site-heading>div{min-width:0}.site-icon,.site-icon-fallback{width:34px;height:34px;flex:0 0 34px;border-radius:8px}.site-icon{display:block;object-fit:contain;background:#fff;border:1px solid #e2e8f0;padding:4px}.site-icon-fallback{display:grid;place-items:center;background:#e8f2f0;color:#087f75;font-size:10px;font-weight:700}.user-actions-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-top:2px}.user-actions-footer>span{font-size:12px;font-weight:700;color:#64748b}.user-actions-footer>div{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8px}.user-danger-action{background:#b5473c}.expiry-test-editor{margin-top:17px;padding:14px;border:1px solid #eed8ac;border-radius:7px;background:#fffaf0}.expiry-test-editor h4{margin:0 0 6px;color:#694d16;font-size:13px}.expiry-test-editor>p{margin:0 0 11px;color:#745f37;font-size:11px;line-height:1.5}.expiry-test-editor>label{display:block;margin-bottom:6px;color:#475569;font-size:11px;font-weight:650}.expiry-test-controls{display:flex;align-items:center;gap:8px}.expiry-test-controls input{flex:1;min-width:0;border:1px solid #cbd5dc;border-radius:5px;padding:8px;background:#fff;color:#334155;font:inherit;font-size:12px}.expiry-test-controls .user-primary{padding:8px 11px;font-size:11px}.expiry-test-message{margin:8px 0 0!important;font-size:11px!important}.expiry-test-message.error{color:#9d332b}.expiry-test-message.success{color:#087f5b}
    @@media(max-width:900px){.user-table-heading{flex-wrap:wrap}.directory-search{flex:1;min-width:170px}}
    @@media(max-width:640px){.user-summary{gap:14px;padding:14px;flex-wrap:wrap}.user-summary .user-primary{margin-left:0;width:100%}.user-table-heading{padding:16px}.user-details-modal{padding:18px}.details-grid{grid-template-columns:1fr}.details-wide{grid-column:auto}.saved-site-title{flex-direction:column}}
</style>

@code {
    private List<AdminUser> DirectoryUsers = [];
    private bool Loading = true;
    private bool Busy;
    private bool Saving;
    private bool ModalOpen;
    private bool DetailsModalOpen;
    private bool DetailsLoading;
    private AdminUser? SelectedSummary;
    private AdminUserDetails? SelectedDetails;
    private string DetailsError = "";
    private string ExpiryTestDateTime = "";
    private string ExpiryTestError = "";
    private string ExpiryTestNotice = "";
    private bool SavingExpiryTest;
    private readonly HashSet<Guid> BrokenSiteIcons = [];
    private AdminUser? EditingUser;
    private AdminUserForm Draft = new();
    private string DraftGroups = "";
    private string Error = "";
    private string FormError = "";
    private string Notice = "";
    private string SortOrder = "name-asc";
    private string SearchTerm = "";
    private IEnumerable<AdminUser> FilteredUsers => string.IsNullOrWhiteSpace(SearchTerm) ? DirectoryUsers : DirectoryUsers.Where(user => string.Join(" ", user.FullName, user.Username, user.Email, user.PhoneNumber, user.Role, StatusText(user), string.Join(" ", user.Groups), user.Subscription?.PlanName, user.Subscription?.Status).Contains(SearchTerm.Trim(), StringComparison.OrdinalIgnoreCase));
    private IEnumerable<AdminUser> SortedUsers => SortOrder switch
    {
        "name-desc" => FilteredUsers.OrderByDescending(user => user.FullName ?? user.Username, StringComparer.OrdinalIgnoreCase),
        "email-asc" => FilteredUsers.OrderBy(user => user.Email, StringComparer.OrdinalIgnoreCase),
        "role-asc" => FilteredUsers.OrderBy(user => user.Role, StringComparer.OrdinalIgnoreCase).ThenBy(user => user.FullName ?? user.Username, StringComparer.OrdinalIgnoreCase),
        "status" => FilteredUsers.OrderBy(user => !user.IsEmailVerified ? 0 : user.IsActive ? 1 : 2).ThenBy(user => user.FullName ?? user.Username, StringComparer.OrdinalIgnoreCase),
        _ => FilteredUsers.OrderBy(user => user.FullName ?? user.Username, StringComparer.OrdinalIgnoreCase)
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private string FormatCount(int count) => string.IsNullOrWhiteSpace(Error) ? count.ToString() : "—";

    private async Task LoadAsync()
    {
        Loading = true;
        Error = "";
        try { DirectoryUsers = await Api.GetUsersAsync(); }
        catch (Exception exception) { Error = exception.Message; }
        finally { Loading = false; }
    }

    private static string Initials(string name) => string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    private static string StatusText(AdminUser user) => !user.IsEmailVerified ? "Pending activation" : user.IsActive ? "Active" : "Suspended";
    private static string StatusClass(AdminUser user) => !user.IsEmailVerified ? "pending" : user.IsActive ? "active" : "suspended";
    private static string SubscriptionStatus(AdminUser user) => user.Subscription?.Status switch
    {
        null or "Free" => "Free plan",
        "Active" => "Active",
        "Cancelled" when user.Subscription?.CancelAtPeriodEnd == true => "Ends this period",
        "Cancelled" => "Cancelled",
        "ApprovalPending" => "Payment pending",
        "Suspended" => "Suspended",
        "Expired" => "Expired",
        var status => status
    };
    private static string SubscriptionClass(AdminUser user) => user.Subscription?.Status switch
    {
        "Active" => "active",
        "ApprovalPending" => "pending",
        "Cancelled" => "cancelled",
        _ => ""
    };
    private static string SiteStatusClass(string status) => status.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "pending" : status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "rejected" : "";
    private async Task OpenDetailsAsync(AdminUser user)
    {
        SelectedSummary = user; SelectedDetails = null; DetailsError = ""; ExpiryTestError = ExpiryTestNotice = ""; ExpiryTestDateTime = ""; DetailsLoading = true; DetailsModalOpen = true; BrokenSiteIcons.Clear();
        try
        {
            SelectedDetails = await Api.GetAdminUserDetailsAsync(user.Id);
            if (SelectedDetails.User.Subscription?.CurrentPeriodEnd is { } periodEnd)
                ExpiryTestDateTime = await JS.InvokeAsync<string>("safePassageAuthSession.toLocalDateTimeInput", periodEnd);
        }
        catch (Exception exception) { DetailsError = exception.Message; }
        finally { DetailsLoading = false; }
    }
    private void CloseDetails() { DetailsModalOpen = false; SelectedDetails = null; SelectedSummary = null; DetailsError = ""; }
    private void OpenEditFromDetails(AdminUser user) { CloseDetails(); OpenEdit(user); }
    private static string GetSiteIconUrl(string loginUrl)
    {
        if (!Uri.TryCreate(loginUrl, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttps && uri.Scheme != Uri.UriSchemeHttp)) return "";
        var siteOrigin = uri.GetLeftPart(UriPartial.Authority);
        return $"https://www.google.com/s2/favicons?domain_url={Uri.EscapeDataString(siteOrigin)}&sz=64";
    }
    private void HandleSiteIconError(Guid siteId) => BrokenSiteIcons.Add(siteId);
    private static string SiteInitials(string name) => string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    private static bool IsSubscriptionExpiryTestAccount(string email) => email.Equals("jayshangodornes@gmail.com", StringComparison.OrdinalIgnoreCase);
    private void UpdateExpiryTestDateTime(ChangeEventArgs args)
    {
        ExpiryTestDateTime = args.Value?.ToString() ?? "";
        ExpiryTestError = ExpiryTestNotice = "";
    }
    private async Task SaveExpiryTestDateTimeAsync()
    {
        ExpiryTestError = ExpiryTestNotice = "";
        if (SelectedDetails is null || !IsSubscriptionExpiryTestAccount(SelectedDetails.User.Email)) return;
        if (!DateTime.TryParseExact(ExpiryTestDateTime, "yyyy-MM-dd'T'HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var localPeriodEnd))
        {
            ExpiryTestError = "Choose a valid expiry date and time.";
            return;
        }

        SavingExpiryTest = true;
        try
        {
            localPeriodEnd = DateTime.SpecifyKind(localPeriodEnd, DateTimeKind.Unspecified);
            var utcOffsetMinutes = await JS.InvokeAsync<int>("safePassageAuthSession.getUtcOffsetMinutes", ExpiryTestDateTime);
            await Api.SetTestSubscriptionExpiryAsync(SelectedDetails.User.Id, localPeriodEnd, utcOffsetMinutes);
            SelectedDetails = await Api.GetAdminUserDetailsAsync(SelectedDetails.User.Id);
            ExpiryTestDateTime = await JS.InvokeAsync<string>("safePassageAuthSession.toLocalDateTimeInput", SelectedDetails.User.Subscription!.CurrentPeriodEnd);
            ExpiryTestNotice = "Expiry date and time updated. The reminder email will be sent on the next scheduled check if it falls within the reminder window.";
        }
        catch (Exception exception) { ExpiryTestError = exception.Message; }
        finally { SavingExpiryTest = false; }
    }
    private void OpenCreate() { EditingUser = null; Draft = new() { Role = "User" }; DraftGroups = ""; FormError = ""; ModalOpen = true; }
    private void OpenEdit(AdminUser user) { EditingUser = user; Draft = new() { Username = user.Username, Email = user.Email, Role = user.Role }; DraftGroups = string.Join(", ", user.Groups); FormError = ""; ModalOpen = true; }
    private void CloseModal() { if (!Saving) ModalOpen = false; }

    private async Task SaveAsync()
    {
        Saving = true; FormError = "";
        Draft.Groups = DraftGroups.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        try
        {
            await Api.SaveUserAsync(Draft, EditingUser?.Id);
            ModalOpen = false; Notice = EditingUser is null ? "User account created. Activation email sent." : "User account updated.";
            await LoadAsync();
        }
        catch (Exception exception) { FormError = exception.Message; }
        finally { Saving = false; }
    }

    private async Task ChangeStatusAsync(AdminUser user)
    {
        Busy = true; Error = ""; Notice = "";
        try
        {
            await Api.SetUserActiveAsync(user.Id, !user.IsActive);
            Notice = user.IsActive ? "User suspended." : "User reactivated.";
            await LoadAsync();
            if (DetailsModalOpen && SelectedSummary?.Id == user.Id)
            {
                SelectedSummary = DirectoryUsers.FirstOrDefault(candidate => candidate.Id == user.Id) ?? user;
                SelectedDetails = await Api.GetAdminUserDetailsAsync(user.Id);
            }
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { Busy = false; }
    }
}
