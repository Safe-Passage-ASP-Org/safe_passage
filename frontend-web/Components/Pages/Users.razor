@page "/users"
@using System.Globalization
@using SafePassage.Web.Services
@inject AdminApiClient Api
@inject IJSRuntime JS

<PageTitle>Users &amp; Identities – Safe Passage</PageTitle>

<div class="sp-page-header">
    <h1 class="sp-page-title">Users &amp; Identities</h1>
    <p class="sp-page-subtitle">Manage accounts, roles, group assignments, account status, and subscription plans.</p>
</div>

<div class="user-summary">
    <div><span>Directory accounts</span><strong>@FormatCount(DirectoryUsers.Count)</strong></div>
    <div><span>Active</span><strong class="good">@FormatCount(DirectoryUsers.Count(user => user.IsActive))</strong></div>
    <div><span>Pending activation</span><strong class="muted">@FormatCount(DirectoryUsers.Count(user => !user.IsEmailVerified))</strong></div>
    <div><span>Suspended</span><strong class="muted">@FormatCount(DirectoryUsers.Count(user => user.IsEmailVerified && !user.IsActive))</strong></div>
    <button class="user-primary" @onclick="OpenCreate" disabled="@Busy">＋ Create user</button>
</div>

@if (!string.IsNullOrWhiteSpace(Error)) { <div class="user-error" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Notice)) { <div class="user-notice" role="status">@Notice</div> }

<section class="sp-card user-table-card">
    <div class="user-table-heading"><div><h2>Directory</h2><p>Select a name to view account details and saved sites.</p></div><input class="directory-search" type="search" aria-label="Search users" placeholder="Search users…" @bind="SearchTerm" @bind:event="oninput" /><label class="user-sort">Sort by <select aria-label="Sort users" @bind="SortOrder"><option value="name-asc">Name A–Z</option><option value="name-desc">Name Z–A</option><option value="email-asc">Email A–Z</option><option value="role-asc">Role A–Z</option><option value="status">Account status</option></select></label><span>@FilteredUsers.Count() of @DirectoryUsers.Count records</span></div>
    @if (Loading)
    {
        <p class="user-state" role="status">Loading users…</p>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="user-state">Directory records are unavailable.</p>
    }
    else if (DirectoryUsers.Count == 0)
    {
        <p class="user-state">No user accounts found.</p>
    }
    else if (!FilteredUsers.Any())
    {
        <p class="user-state">No users match “@SearchTerm”. Try another search.</p>
    }
    else
    {
        <div class="user-table-scroll"><table class="user-table">
            <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var user in SortedUsers)
                {
                    <tr>
                        <td><div class="identity-cell">
                            @if (!string.IsNullOrWhiteSpace(user.ProfileImageData))
                            {
                                <img class="user-avatar user-avatar-image" src="@user.ProfileImageData" alt="" aria-hidden="true" loading="lazy" />
                            }
                            else
                            {
                                <span class="user-avatar" aria-hidden="true">@Initials(user.FullName ?? user.Username)</span>
                            }
                            <button class="user-name-link" @onclick="() => OpenDetailsAsync(user)" aria-label="View details for @(user.FullName ?? user.Username)">@(user.FullName ?? user.Username)</button>
                        </div></td>
                        <td class="user-email">@user.Email</td><td>@user.Role</td>
                        <td><span class="user-status @StatusClass(user)"><i></i>@StatusText(user)</span></td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@if (DetailsModalOpen)
{
    <div class="user-modal-backdrop" @onclick="CloseDetails">
        <section class="user-details-modal" role="dialog" aria-modal="true" aria-labelledby="user-details-title" @onclick:stopPropagation="true">
            <div class="user-modal-heading"><div><span>USER ACCOUNT</span><h2 id="user-details-title">@(SelectedDetails?.User.FullName ?? SelectedDetails?.User.Username ?? SelectedSummary?.Username ?? "User details")</h2></div><button class="user-close" aria-label="Close user details" @onclick="CloseDetails">×</button></div>
            @if (DetailsLoading)
            {
                <p class="user-state" role="status">Loading account details and saved sites…</p>
            }
            else if (!string.IsNullOrWhiteSpace(DetailsError))
            {
                <div class="user-error" role="alert">@DetailsError</div>
                <div class="user-modal-actions"><button class="user-cancel" @onclick="CloseDetails">Close</button><button class="user-primary" @onclick="() => OpenDetailsAsync(SelectedSummary!)">Try again</button></div>
            }
            else if (SelectedDetails is not null)
            {
                var account = SelectedDetails.User;
                <div class="user-details-content">
                    <section class="details-section"><h3>Account</h3><dl class="details-grid">
                        <div><dt>Username</dt><dd>@account.Username</dd></div><div><dt>Primary email</dt><dd>@account.Email</dd></div>
                        <div><dt>Backup email</dt><dd>@(SelectedDetails.BackupEmail ?? "Not added")</dd></div><div><dt>Phone</dt><dd>@(account.PhoneNumber ?? "Not added")</dd></div>
                        <div><dt>Role</dt><dd>@account.Role</dd></div><div><dt>Account status</dt><dd><span class="user-status @StatusClass(account)"><i></i>@StatusText(account)</span></dd></div>
                        <div class="details-wide"><dt>Groups</dt><dd>@(account.Groups.Count == 0 ? "No groups" : string.Join(", ", account.Groups))</dd></div>
                    </dl></section>
                    <section class="details-section"><h3>Subscription</h3><dl class="details-grid">
                        <div><dt>Plan</dt><dd>@(account.Subscription?.PlanName ?? "Free")</dd></div><div><dt>Status</dt><dd>@SubscriptionStatus(account)</dd></div>
                        @if (account.Subscription?.CurrentPeriodStart is { } periodStart) { <div><dt>Period started</dt><dd>@periodStart.ToLocalTime().ToString("MMM d, yyyy")</dd></div> }
                        @if (account.Subscription?.CurrentPeriodEnd is { } periodEnd) { <div><dt>@(account.Subscription.CancelAtPeriodEnd ? "Access until" : "Renews on")</dt><dd>@periodEnd.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd></div> }
                    </dl>
                    @if (IsSubscriptionExpiryTestAccount(account.Email))
                    {
                        <div class="expiry-test-editor">
                            <h4>Subscription reminder test</h4>
                            <p>Test-only expiry editor for this account. Choose a local date and time inside the configured reminder window. The automatic email worker sends its warning on the next scheduled check; the account must be active and email-verified.</p>
                            <label for="test-subscription-expiry">Test expiry date and time (local)</label>
                            <div class="expiry-test-controls">
                                <input id="test-subscription-expiry" type="datetime-local" step="60" value="@ExpiryTestDateTime" @onchange="UpdateExpiryTestDateTime" disabled="@SavingExpiryTest" />
                                <button type="button" class="user-primary" @onclick="SaveExpiryTestDateTimeAsync" disabled="@(SavingExpiryTest || string.IsNullOrWhiteSpace(ExpiryTestDateTime))">@(SavingExpiryTest ? "Saving…" : "Update expiry date")</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ExpiryTestError)) { <p class="expiry-test-message error" role="alert">@ExpiryTestError</p> }
                            @if (!string.IsNullOrWhiteSpace(ExpiryTestNotice)) { <p class="expiry-test-message success" role="status">@ExpiryTestNotice</p> }
                        </div>
                    }
                    </section>
                    <section class="details-section"><div class="sites-heading"><div><h3>Saved sites</h3><p>Sites added to this user's account</p></div><span>@SelectedDetails.Sites.Count</span></div>
                        @if (SelectedDetails.Sites.Count == 0)
                        {
                            <div class="sites-empty">This user hasn't added any sites yet.</div>
                        }
                        else
                        {
                            <div class="saved-site-list">
                                @foreach (var site in SelectedDetails.Sites)
                                {
                                    <article class="saved-site-card"><div class="saved-site-title"><div class="saved-site-heading">
                                        @if (BrokenSiteIcons.Contains(site.Id))
                                        {
                                            <span class="site-icon-fallback" aria-hidden="true">@SiteInitials(site.Name)</span>
                                        }
                                        else
                                        {
                                            <img class="site-icon" src="@GetSiteIconUrl(site.LoginUrl)" alt="" aria-hidden="true" loading="lazy" referrerpolicy="no-referrer" @onerror="() => HandleSiteIconError(site.Id)" />
                                        }
                                        <div><h4>@site.Name</h4><a href="@site.LoginUrl" target="_blank" rel="noopener noreferrer">@site.LoginUrl</a></div></div><span class="site-verification @SiteStatusClass(site.VerificationStatus)">@site.VerificationStatus</span></div>
                                        @if (!string.IsNullOrWhiteSpace(site.Description)) { <p>@site.Description</p> }
                                        <div class="saved-site-meta"><span>@(string.IsNullOrWhiteSpace(site.Category) ? "Other" : site.Category)</span><span>Password @(site.HasPassword ? "saved" : "not saved")</span><span>2FA @(site.HasTotpSecret ? "configured" : "not configured")</span><span>Added @site.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span></div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                    <div class="user-actions-footer"><span>Actions</span><div>
                        <button class="user-cancel" @onclick="() => OpenEditFromDetails(account)" disabled="@Busy">Edit user</button>
                        @if (account.IsEmailVerified)
                        {
                            <button class="user-primary @(account.IsActive ? "user-danger-action" : "")" @onclick="() => ChangeStatusAsync(account)" disabled="@Busy">@(Busy ? "Updating…" : account.IsActive ? "Suspend user" : "Reactivate user")</button>
                        }
                        <button class="user-cancel" @onclick="CloseDetails">Close</button>
                    </div></div>
                </div>
            }
        </section>
    </div>
}

@if (ModalOpen)
{
    <div class="user-modal-backdrop" @onclick="CloseModal">
        <section class="user-modal" role="dialog" aria-modal="true" aria-labelledby="user-modal-title" @onclick:stopPropagation="true">
            <div class="user-modal-heading"><div><span>IDENTITY DIRECTORY</span><h2 id="user-modal-title">@(EditingUser is null ? "Create user" : "Edit user")</h2></div><button class="user-close" aria-label="Close" @onclick="CloseModal">×</button></div>
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                <label>Username<input required maxlength="100" autocomplete="username" @bind="Draft.Username" /></label>
                <label>Work email<input required type="email" maxlength="320" autocomplete="email" @bind="Draft.Email" disabled="@(EditingUser is { IsEmailVerified: false })" /></label>
                @if (EditingUser is null) { <p class="user-invitation-note">The account will remain inactive until the user activates it from the email invitation.</p> }
                <label>Role<select @bind="Draft.Role"><option>User</option><option>Operator</option><option>Auditor</option><option>Admin</option></select></label>
                <label>Groups<input @bind="DraftGroups" placeholder="Engineering, Workforce" /><small>Enter existing group names separated by commas.</small></label>
                @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="user-error" role="alert">@FormError</div> }
                <div class="user-modal-actions"><button type="button" class="user-cancel" @onclick="CloseModal" disabled="@Saving">Cancel</button><button type="submit" class="user-primary" disabled="@Saving">@(Saving ? "Saving…" : EditingUser is null ? "Create user" : "Save changes")</button></div>
            </form>
        </section>
    </div>
}

