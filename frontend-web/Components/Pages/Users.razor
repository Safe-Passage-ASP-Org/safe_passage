@page "/users"
@rendermode InteractiveServer

<PageTitle>Users &amp; Identities – Safe Passage</PageTitle>

<div class="sp-page-header">
    <h1 class="sp-page-title">Users &amp; Identities</h1>
    <p class="sp-page-subtitle">Manage all user accounts, identity records, and authentication status.</p>
</div>

<div class="user-summary">
    <div><span>Directory accounts</span><strong>@DirectoryUsers.Count</strong></div>
    <div><span>Active</span><strong class="good">@DirectoryUsers.Count(user => user.Status == "Active")</strong></div>
    <div><span>Suspended</span><strong class="muted">@DirectoryUsers.Count(user => user.Status == "Suspended")</strong></div>
    <button class="user-primary" @onclick="() => OpenUserModal()">＋ Create User</button>
</div>

<section class="sp-card user-table-card">
    <div class="user-table-heading">
        <div><h2>Directory</h2><p>Identity records and group assignments</p></div>
        <span class="user-count">@DirectoryUsers.Count records</span>
    </div>
    <div class="user-table-scroll">
        <table class="user-table">
            <thead><tr><th>User name</th><th>Email</th><th>Status</th><th>Assigned groups</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var user in DirectoryUsers)
                {
                    <tr>
                        <td><div class="identity-cell"><span class="user-avatar">@Initials(user.Name)</span><strong>@user.Name</strong></div></td>
                        <td class="user-email">@user.Email</td>
                        <td><span class="user-status @(user.Status == "Active" ? "active" : "suspended")"><i></i>@user.Status</span></td>
                        <td><div class="group-list">@foreach (var group in user.Groups) { <span>@group</span> }</div></td>
                        <td><div class="user-actions"><button class="user-text-button" @onclick="() => OpenUserModal(user)">Edit</button><button class="user-text-button danger" @onclick="() => ToggleSuspension(user)">@(user.Status == "Active" ? "Suspend" : "Reactivate")</button></div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (IsUserModalOpen)
{
    <div class="user-modal-backdrop" @onclick="CloseUserModal">
        <section class="user-modal" role="dialog" aria-modal="true" aria-labelledby="user-modal-title" @onclick:stopPropagation="true">
            <div class="user-modal-heading"><div><span>IDENTITY DIRECTORY</span><h2 id="user-modal-title">@(EditingUser is null ? "Create user" : "Edit user")</h2></div><button class="user-close" aria-label="Close" @onclick="CloseUserModal">×</button></div>
            <form @onsubmit="SaveUser" @onsubmit:preventDefault="true">
                <label>Full name<input required @bind="DraftName" placeholder="e.g. Jordan Lee" /></label>
                <label>Work email<input required type="email" @bind="DraftEmail" placeholder="name@company.com" /></label>
                <label>Assigned groups<input @bind="DraftGroups" placeholder="Engineering, Workforce" /><small>Separate group names with commas.</small></label>
                <div class="user-modal-actions"><button type="button" class="user-cancel" @onclick="CloseUserModal">Cancel</button><button type="submit" class="user-primary">@(EditingUser is null ? "Create user" : "Save changes")</button></div>
            </form>
        </section>
    </div>
}

<style>
    .user-summary{display:flex;align-items:center;gap:28px;margin:0 0 20px;padding:16px 20px;background:#fff;border:1px solid #e2e8f0;border-radius:8px;box-shadow:var(--sp-shadow-sm)}
    .user-summary div{display:flex;flex-direction:column;gap:3px}.user-summary span{font-size:12px;color:#64748b}.user-summary strong{font-size:19px}.user-summary .good{color:#087f5b}.user-summary .muted{color:#64748b}.user-summary .user-primary{margin-left:auto}
    .user-primary,.user-cancel{border:0;border-radius:5px;padding:9px 14px;font-size:13px;font-weight:650;cursor:pointer}.user-primary{background:#087f75;color:#fff}.user-primary:hover{background:#06665f}.user-cancel{background:#f1f5f9;color:#334155}
    .user-table-card{overflow:hidden}.user-table-heading{display:flex;align-items:center;justify-content:space-between;padding:19px 22px;border-bottom:1px solid #e8edf1}.user-table-heading h2{font-size:16px;margin:0 0 4px}.user-table-heading p{margin:0;color:#64748b;font-size:12px}.user-count{color:#64748b;font-size:12px}
    .user-table-scroll{overflow-x:auto}.user-table{width:100%;border-collapse:collapse;min-width:760px}.user-table th{padding:12px 18px;text-align:left;background:#f8fafb;color:#64748b;text-transform:uppercase;font-size:10px;letter-spacing:.6px;font-weight:700}.user-table td{padding:15px 18px;border-top:1px solid #edf0f2;font-size:13px;vertical-align:middle}.identity-cell{display:flex;align-items:center;gap:10px}.identity-cell strong{font-weight:650}.user-avatar{width:32px;height:32px;display:grid;place-items:center;background:#dff3ed;color:#087f75;border-radius:50%;font-size:10px;font-weight:700}.user-email{color:#52616b}.user-status{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:650}.user-status i{width:7px;height:7px;border-radius:50%;background:#099268}.user-status.suspended i{background:#a1aab2}.user-status.suspended{color:#64748b}.user-status.active{color:#087f5b}.group-list{display:flex;flex-wrap:wrap;gap:5px}.group-list span{padding:4px 7px;border-radius:4px;background:#f0f5f4;color:#47635d;font-size:10px}.user-actions{display:flex;justify-content:flex-end;gap:12px;white-space:nowrap}.user-text-button{padding:3px;border:0;background:none;color:#087f75;font-size:12px;font-weight:650;cursor:pointer}.user-text-button.danger{color:#b5473c}.user-text-button:hover{text-decoration:underline}
    .user-modal-backdrop{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(15,23,42,.48)}.user-modal{width:min(100%,480px);background:#fff;border-radius:8px;box-shadow:0 24px 70px rgba(15,23,42,.24);padding:24px}.user-modal-heading{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px}.user-modal-heading span{font-size:10px;font-weight:700;color:#087f75}.user-modal-heading h2{margin:5px 0 0;font-size:21px}.user-close{border:0;background:transparent;font-size:26px;line-height:1;color:#64748b;cursor:pointer}.user-modal form{display:grid;gap:15px}.user-modal label{display:grid;gap:6px;font-size:12px;font-weight:650;color:#334155}.user-modal input{width:100%;border:1px solid #cbd5dc;border-radius:5px;padding:10px 11px;font:inherit;font-size:13px}.user-modal input:focus{outline:2px solid #b7e1d8;border-color:#087f75}.user-modal small{font-weight:400;color:#64748b}.user-modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
    @@media(max-width:640px){.user-summary{gap:14px;padding:14px;flex-wrap:wrap}.user-summary .user-primary{margin-left:0;width:100%}.user-table-heading{padding:16px}}
</style>

@code {
    private readonly List<DirectoryUser> DirectoryUsers = new()
    {
        new("Avery Chen", "avery.chen@northstar.example", "Active", new() { "Engineering", "Workforce" }),
        new("Samira Patel", "samira.patel@northstar.example", "Active", new() { "Finance", "Workforce" }),
        new("Noah Williams", "noah.williams@northstar.example", "Suspended", new() { "Contractors" }),
        new("Morgan Rivera", "morgan.rivera@northstar.example", "Active", new() { "Administrators", "Workforce" })
    };
    private bool IsUserModalOpen;
    private DirectoryUser? EditingUser;
    private string DraftName = "";
    private string DraftEmail = "";
    private string DraftGroups = "";

    private static string Initials(string name) => string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();

    private void OpenUserModal(DirectoryUser? user = null)
    {
        EditingUser = user;
        DraftName = user?.Name ?? "";
        DraftEmail = user?.Email ?? "";
        DraftGroups = user is null ? "Workforce" : string.Join(", ", user.Groups);
        IsUserModalOpen = true;
    }

    private void CloseUserModal() => IsUserModalOpen = false;

    private void SaveUser()
    {
        var groups = DraftGroups.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (EditingUser is null)
            DirectoryUsers.Add(new(DraftName.Trim(), DraftEmail.Trim(), "Active", groups));
        else
        {
            EditingUser.Name = DraftName.Trim();
            EditingUser.Email = DraftEmail.Trim();
            EditingUser.Groups = groups;
        }
        CloseUserModal();
    }

    private static void ToggleSuspension(DirectoryUser user) => user.Status = user.Status == "Active" ? "Suspended" : "Active";

    private sealed class DirectoryUser(string name, string email, string status, List<string> groups)
    {
        public string Name { get; set; } = name;
        public string Email { get; set; } = email;
        public string Status { get; set; } = status;
        public List<string> Groups { get; set; } = groups;
    }
}
