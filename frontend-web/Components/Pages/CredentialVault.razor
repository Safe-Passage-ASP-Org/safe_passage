@page "/credential-vault"
@using SafePassage.Web.Services
@inject AdminApiClient Api

<PageTitle>Credential Vault – Safe Passage</PageTitle>
<div class="sp-page-header">
    <h1 class="sp-page-title">Credential Vault</h1>
    <p class="sp-page-subtitle">Your website credentials and authenticator secrets sync with the Safe Passage extension.</p>
</div>

<div class="vault-actions"><p>New sites stay pending until an administrator verifies the website. Credentials and 2FA codes remain unavailable to the extension until approval.</p><button class="vault-primary" @onclick="OpenCreate">Add website</button></div>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="vault-alert" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Notice)) { <div class="vault-notice" role="status">@Notice</div> }

<section class="sp-card vault-list">
    @if (Loading) { <p class="vault-empty" role="status">Loading your vault…</p> }
    else if (Sites.Count == 0) { <p class="vault-empty">No saved websites yet. Add one here or save it from the browser extension.</p> }
    else
    {
        @foreach (var site in Sites.OrderBy(site => site.Name, StringComparer.OrdinalIgnoreCase))
        {
            <article class="vault-row">
                <div class="vault-site-mark">@Mark(site.Name)</div>
                <div class="vault-site-copy"><h2>@site.Name <span class="vault-status @site.VerificationStatus.ToLowerInvariant()">@site.VerificationStatus</span></h2><p>@site.LoginUrl</p><small>@site.Category · @(site.HasPassword ? "Password saved" : "No password") · @(site.HasTotpSecret ? "2FA secret saved" : "No 2FA secret")</small></div>
                <div class="vault-row-actions"><button @onclick="() => OpenEdit(site)">Edit</button><button class="vault-delete" @onclick="() => DeleteAsync(site)">Remove</button></div>
            </article>
        }
    }
</section>

@if (EditingOpen)
{
    <div class="vault-backdrop" @onclick="Close"><section class="vault-modal" role="dialog" aria-modal="true" aria-labelledby="vault-form-title" @onclick:stopPropagation="true">
        <header><div><small>SAFE PASSAGE VAULT</small><h2 id="vault-form-title">@(Editing is null ? "Add website" : "Edit website")</h2></div><button class="vault-close" aria-label="Close" @onclick="Close">×</button></header>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
            <label>Application Name<input required maxlength="200" @bind="Draft.Name" /></label>
            <label>Login / Web URL<input required type="url" maxlength="2048" placeholder="https://example.com/login" @bind="Draft.LoginUrl" /></label>
            <label>Category<select @bind="Draft.Category">@foreach (var category in Categories) { <option value="@category">@category</option> }</select></label>
            <label>Description (Optional)<textarea rows="2" maxlength="2000" @bind="Draft.Description"></textarea></label>
            <label>Username / Email (Optional)<input maxlength="320" autocomplete="off" @bind="Draft.AutoFillUsername" /></label>
            <label>Password (Optional)<input type="password" maxlength="1024" autocomplete="new-password" placeholder="@(Draft.HasPassword ? "Leave blank to keep the saved password" : "Password")" @bind="Draft.Password" /></label>
            <label>2FA Secret (Base32, Optional)<input type="password" maxlength="256" autocomplete="off" placeholder="@(Draft.HasTotpSecret ? "Leave blank to keep the saved secret" : "Authenticator setup secret")" @bind="Draft.TotpSecret" /></label>
            @if (Editing is not null && Draft.HasTotpSecret) { <label class="vault-check"><input type="checkbox" @bind="Draft.ClearTotpSecret" /> Remove saved 2FA secret</label> }
            @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="vault-alert" role="alert">@FormError</div> }
            <p class="vault-help">Only administrator-verified sites can be used by the extension. Secrets are encrypted in the backend.</p>
            <footer><button type="button" class="vault-secondary" @onclick="Close" disabled="@Saving">Cancel</button><button class="vault-primary" type="submit" disabled="@Saving">@(Saving ? "Saving…" : "Save website")</button></footer>
        </form>
    </section></div>
}

<style>
    .vault-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.vault-actions p{max-width:690px;margin:0;color:#64748b;font-size:12px;line-height:1.5}.vault-primary,.vault-secondary{border:0;border-radius:5px;padding:9px 14px;font-size:12px;font-weight:650;cursor:pointer}.vault-primary{background:#087f75;color:#fff}.vault-secondary{background:#f1f5f9;color:#334155}.vault-alert,.vault-notice{padding:11px 14px;border-radius:6px;margin-bottom:14px;font-size:13px}.vault-alert{background:#fcecea;color:#9d332b}.vault-notice{background:#edf7f2;color:#087f5b}.vault-list{padding:4px 20px}.vault-empty{padding:20px 0;color:#64748b;font-size:13px}.vault-row{display:flex;align-items:center;gap:14px;padding:16px 0;border-bottom:1px solid #edf0f2}.vault-row:last-child{border-bottom:0}.vault-site-mark{width:40px;height:40px;flex:0 0 auto;display:grid;place-items:center;border-radius:7px;background:#e5f2ed;color:#087f75;font-weight:800}.vault-site-copy{flex:1;min-width:0}.vault-site-copy h2{margin:0 0 3px;font-size:14px}.vault-site-copy p,.vault-site-copy small{display:block;margin:0;color:#64748b;font-size:11px;overflow-wrap:anywhere}.vault-site-copy small{margin-top:4px}.vault-status{display:inline-block;padding:3px 8px;border-radius:12px;background:#fff5df;color:#946200;font-size:9px;text-transform:uppercase;vertical-align:middle}.vault-status.verified{background:#e5f5ed;color:#087f5b}.vault-status.rejected{background:#fcecea;color:#9d332b}.vault-row-actions{display:flex;gap:8px}.vault-row-actions button{border:0;background:none;color:#087f75;font-size:11px;font-weight:650;cursor:pointer}.vault-row-actions .vault-delete{color:#9d332b}.vault-backdrop{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(15,23,42,.48)}.vault-modal{width:min(100%,520px);max-height:90vh;overflow:auto;background:#fff;border-radius:8px;padding:23px;box-shadow:0 24px 70px rgba(15,23,42,.24)}.vault-modal header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px}.vault-modal header small{font-size:10px;font-weight:700;color:#087f75}.vault-modal header h2{font-size:20px;margin:5px 0}.vault-close{border:0;background:none;color:#64748b;font-size:25px;cursor:pointer}.vault-modal form{display:grid;gap:12px}.vault-modal form>label{display:grid;gap:6px;font-size:12px;font-weight:650;color:#334155}.vault-modal input:not([type=checkbox]),.vault-modal select,.vault-modal textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5dc;border-radius:5px;padding:10px;font:inherit;font-size:13px}.vault-modal .vault-check{display:flex;align-items:center;gap:8px;font-weight:500}.vault-modal .vault-check input{accent-color:#087f75}.vault-help{margin:0;color:#64748b;font-size:11px}.vault-modal footer{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
    @@media(max-width:600px){.vault-actions{align-items:flex-start;flex-direction:column}.vault-row{align-items:flex-start;flex-wrap:wrap}.vault-site-copy{flex-basis:calc(100% - 60px)}.vault-row-actions{margin-left:54px}}
</style>

@code {
    private static readonly string[] Categories = ["Work", "Social", "Finance", "Education", "Shopping", "Entertainment", "Health", "Other"];
    private List<VaultSiteSummary> Sites = [];
    private VaultSiteSummary? Editing;
    private VaultSiteForm Draft = new();
    private bool Loading = true, EditingOpen, Saving;
    private string Error = "", Notice = "", FormError = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        Loading = true; Error = "";
        try { Sites = await Api.GetVaultSitesAsync(); }
        catch (Exception exception) { Error = exception.Message; }
        finally { Loading = false; }
    }
    private static string Mark(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));
    private void OpenCreate() { Editing = null; Draft = new(); FormError = ""; EditingOpen = true; }
    private void OpenEdit(VaultSiteSummary site)
    {
        Editing = site;
        Draft = new() { Name = site.Name, LoginUrl = site.LoginUrl, Category = site.Category, Description = site.Description,
            AutoFillUsername = site.AutoFillUsername, HasPassword = site.HasPassword, HasTotpSecret = site.HasTotpSecret };
        FormError = ""; EditingOpen = true;
    }
    private void Close() { if (!Saving) EditingOpen = false; }
    private async Task SaveAsync()
    {
        Saving = true; FormError = ""; Notice = "";
        try
        {
            await Api.SaveVaultSiteAsync(Draft, Editing?.Id);
            EditingOpen = false;
            Notice = "Website saved. It will appear in the extension after administrator verification.";
            await LoadAsync();
        }
        catch (Exception exception) { FormError = exception.Message; }
        finally { Saving = false; }
    }
    private async Task DeleteAsync(VaultSiteSummary site)
    {
        try { await Api.DeleteVaultSiteAsync(site.Id); Notice = $"Removed {site.Name} from your synchronized vault."; await LoadAsync(); }
        catch (Exception exception) { Error = exception.Message; }
    }
}
