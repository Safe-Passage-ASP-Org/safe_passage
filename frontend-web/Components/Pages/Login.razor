@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using SafePassage.Web.Services
@inject AdminApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Sign in – Safe Passage</PageTitle>

<main class="signup-page">
    <a class="signup-brand" href="/" aria-label="Safe Passage home">
        <span class="signup-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.7 4.5 5.5v5.2c0 5 3.2 8.6 7.5 10.6 4.3-2 7.5-5.6 7.5-10.6V5.5L12 2.7Z" /><path d="m8.8 12.1 2.1 2.1 4.4-4.6" /></svg>
        </span>
        <span>Safe Passage</span>
    </a>

    <section class="signup-card" aria-labelledby="login-title">
        <div class="signup-card-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 2.7 4.5 5.5v5.2c0 5 3.2 8.6 7.5 10.6 4.3-2 7.5-5.6 7.5-10.6V5.5L12 2.7Z" /><path d="m8.8 12.1 2.1 2.1 4.4-4.6" /></svg>
        </div>
        @if (MfaPending)
        {
            <p class="signup-eyebrow">VERIFY IT’S YOU</p>
            <h1 id="login-title">Approve your sign-in</h1>
            <p class="signup-subtitle">Approve this request on your registered mobile device. This page will continue after approval.</p>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="signup-error" role="alert">@Error</div>
            }
            <div class="login-pending" role="status" aria-live="polite">
                <span class="pending-indicator"></span>
                <strong>Waiting for mobile approval</strong>
            </div>
            <button class="signup-button" @onclick="CheckOnce" disabled="@Busy">@(Busy ? "Checking…" : "Check approval")</button>
            <button class="login-link" @onclick="CancelMfa">Cancel sign-in</button>
        }
        else
        {
            <p class="signup-eyebrow">WELCOME BACK</p>
            <h1 id="login-title">Sign in to your account.</h1>
            <p class="signup-subtitle">Use your email or username and password to continue securely.</p>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="signup-error" role="alert">@Error</div>
            }
            <EditForm Model="Credentials" OnValidSubmit="SignInAsync">
                <DataAnnotationsValidator />
                <label for="username">Email address or username</label>
                <InputText id="username" @bind-Value="Credentials.Username" autocomplete="username" disabled="@Busy" placeholder="you@example.com" />
                <ValidationMessage For="() => Credentials.Username" />
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="Credentials.Password" autocomplete="current-password" disabled="@Busy" placeholder="Enter your password" />
                <ValidationMessage For="() => Credentials.Password" />
                <button class="signup-button" type="submit" disabled="@Busy">@(Busy ? "Signing in…" : "Sign in") <span aria-hidden="true">→</span></button>
            </EditForm>
            <p class="signup-switch">New to Safe Passage? <a href="/signup">Create an account</a></p>
        }
    </section>
    <a class="signup-back" href="/">← Back to Safe Passage</a>
</main>

@code {
    private readonly LoginForm Credentials = new();
    private CancellationTokenSource? PollCancellation;
    private string? SessionToken;
    private string Error = "";
    private bool Busy;
    private bool MfaPending;

    private async Task SignInAsync()
    {
        Busy = true;
        Error = "";
        try
        {
            var result = await Api.LoginAsync(Credentials.Username.Trim(), Credentials.Password);
            if (result.MfaRequired)
            {
                if (string.IsNullOrWhiteSpace(result.SessionToken))
                    throw new InvalidOperationException("The API did not return an MFA session.");
                SessionToken = result.SessionToken;
                MfaPending = true;
                PollCancellation = new CancellationTokenSource();
                _ = PollForApprovalAsync(PollCancellation.Token);
                return;
            }
            Navigation.NavigateTo("/users");
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { Busy = false; }
    }

    private async Task PollForApprovalAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested && MfaPending)
        {
            try
            {
                if (await Api.CompleteMfaAsync(SessionToken!, cancellationToken))
                {
                    MfaPending = false;
                    await InvokeAsync(() => Navigation.NavigateTo("/users"));
                    return;
                }
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
            catch (Exception exception)
            {
                Error = exception.Message;
                MfaPending = false;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
    }

    private async Task CheckOnce()
    {
        if (SessionToken is null) return;
        Busy = true;
        Error = "";
        try
        {
            if (await Api.CompleteMfaAsync(SessionToken))
            {
                MfaPending = false;
                PollCancellation?.Cancel();
                Navigation.NavigateTo("/users");
            }
        }
        catch (Exception exception) { Error = exception.Message; MfaPending = false; PollCancellation?.Cancel(); }
        finally { Busy = false; }
    }

    private void CancelMfa()
    {
        PollCancellation?.Cancel();
        SessionToken = null;
        MfaPending = false;
        Error = "";
    }

    public void Dispose()
    {
        PollCancellation?.Cancel();
        PollCancellation?.Dispose();
    }

    private sealed class LoginForm
    {
        [Required, StringLength(320, MinimumLength = 1)] public string Username { get; set; } = "";
        [Required, StringLength(1024, MinimumLength = 1)] public string Password { get; set; } = "";
    }
}
