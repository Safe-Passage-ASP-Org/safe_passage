@page "/subscription/paypal-callback"
@layout SafePassage.Web.Components.Layout.AuthLayout
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>PayPal Checkout – Safe Passage</PageTitle>

<div class="auth-card" style="max-width:440px;margin:48px auto;padding:28px;text-align:center;">
    <h2 style="font-size:18px;font-weight:700;color:#1e293b;margin-bottom:8px;">
        @(IsSuccess ? "PayPal Approval Received" : "PayPal Checkout Cancelled")
    </h2>
    <p style="font-size:13px;color:#64748b;margin-bottom:20px;">
        @(NotifiedOpener
            ? "Returning to Safe Passage..."
            : "You can close this window and return to your Safe Passage Subscription page.")
    </p>
    <a href="/subscription" class="btn btn-primary btn-sm">Return to Subscription</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "subscription_id")]
    public string? SubscriptionId { get; set; }

    private bool IsSuccess => string.Equals(Status, "success", StringComparison.OrdinalIgnoreCase);
    private bool NotifiedOpener { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var normalizedStatus = IsSuccess ? "success" : "cancel";
        NotifiedOpener = await JS.InvokeAsync<bool>(
            "safePassagePayPal.notifyOpenerAndClose",
            normalizedStatus,
            SubscriptionId ?? string.Empty);

        StateHasChanged();
    }
}
