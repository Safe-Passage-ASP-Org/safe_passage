@page "/activity-logs"
@rendermode InteractiveServer

<PageTitle>Activity Logs – Safe Passage</PageTitle>

<div class="sp-page-header">
    <h1 class="sp-page-title">Activity Logs</h1>
    <p class="sp-page-subtitle">Immutable, searchable audit trail of all authentication and administrative events.</p>
</div>

<!-- Sample table skeleton -->
<div class="sp-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-semibold mb-0">Recent Events</h6>
        <button class="btn btn-sm btn-outline-secondary" disabled>Export CSV</button>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Event</th>
                    <th>Resource</th>
                    <th>IP Address</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-muted">2024-09-25 13:51</td>
                    <td>john.doe</td>
                    <td>Login</td>
                    <td>Web Portal</td>
                    <td>192.168.1.42</td>
                    <td><span class="badge-success">Success</span></td>
                </tr>
                <tr>
                    <td class="text-muted">2024-09-25 13:49</td>
                    <td>jane.smith</td>
                    <td>MFA Approved</td>
                    <td>VPN Gateway</td>
                    <td>10.0.0.14</td>
                    <td><span class="badge-success">Success</span></td>
                </tr>
                <tr>
                    <td class="text-muted">2024-09-25 13:31</td>
                    <td>unknown</td>
                    <td>Login Attempt</td>
                    <td>Admin Panel</td>
                    <td>185.220.101.5</td>
                    <td><span class="badge-danger">Blocked</span></td>
                </tr>
            </tbody>
        </table>
    </div>
    <p class="text-muted mt-3 small text-center">Showing placeholder data — connect backend to populate live logs.</p>
</div>
