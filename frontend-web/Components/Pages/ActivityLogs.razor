@page "/activity-logs"
@rendermode InteractiveServer
@using SafePassage.Web.Services
@inject AdminApiClient Api

<PageTitle>Activity Logs – Safe Passage</PageTitle>
<div class="sp-page-header"><h1 class="sp-page-title">Activity Logs</h1><p class="sp-page-subtitle">Recent authentication and administrative events recorded by the system.</p></div>
<div class="audit-toolbar"><input aria-label="Search activity" placeholder="Search user, action, or resource" @bind="Search" @bind:event="oninput" /><select aria-label="Filter by result" @bind="StatusFilter"><option value="">All results</option><option value="Success">Success</option><option value="Denied">Denied</option></select><button @onclick="LoadAsync" disabled="@Loading">Refresh</button></div>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="audit-error" role="alert">@Error</div> }
<section class="sp-card audit-card">
    @if (Loading) { <p class="audit-state" role="status">Loading activity…</p> }
    else if (FilteredRows.Count == 0) { <p class="audit-state">@(Rows.Count == 0 ? "No activity has been recorded." : "No events match these filters.")</p> }
    else
    {
        <div class="audit-scroll"><table><thead><tr><th>Timestamp</th><th>User</th><th>Event</th><th>Resource</th><th>Result</th></tr></thead><tbody>
        @foreach (var row in FilteredRows)
        {
            <tr><td>@row.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td>@row.Username</td><td>@row.Action</td><td>@row.Resource</td><td><span class="audit-status @(row.Status.Equals("Success", StringComparison.OrdinalIgnoreCase) ? "success" : "denied")">@row.Status</span></td></tr>
        }
        </tbody></table></div>
        <p class="audit-foot">Showing @FilteredRows.Count of @Rows.Count most recent events.</p>
    }
</section>
<style>
    .audit-toolbar{display:flex;gap:8px;margin-bottom:14px}.audit-toolbar input{flex:1;min-width:140px}.audit-toolbar input,.audit-toolbar select{border:1px solid #cbd5dc;border-radius:5px;padding:9px 11px;background:#fff;font:inherit;font-size:12px}.audit-toolbar button{border:0;border-radius:5px;padding:9px 14px;background:#087f75;color:#fff;font-size:12px;font-weight:650}.audit-toolbar button:disabled{opacity:.6}.audit-error{padding:11px 14px;border-radius:6px;margin-bottom:14px;background:#fcecea;color:#9d332b;font-size:13px}.audit-card{overflow:hidden}.audit-scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:700px}th{text-align:left;background:#f8fafb;color:#64748b;text-transform:uppercase;font-size:10px;letter-spacing:.5px;padding:12px 15px}td{padding:12px 15px;border-top:1px solid #edf0f2;font-size:12px}td:first-child{white-space:nowrap;color:#64748b}.audit-status{display:inline-block;border-radius:12px;padding:4px 8px;font-size:10px;font-weight:700}.audit-status.success{background:#edf7f2;color:#087f5b}.audit-status.denied{background:#fcecea;color:#a53e34}.audit-state,.audit-foot{padding:20px;color:#64748b;font-size:12px}.audit-foot{border-top:1px solid #edf0f2;margin:0;text-align:right}
    @@media(max-width:560px){.audit-toolbar{flex-wrap:wrap}.audit-toolbar input{flex-basis:100%}.audit-toolbar select{flex:1}}
</style>
@code {
    private List<AdminActivity> Rows = [];
    private string Search = "", StatusFilter = "", Error = "";
    private bool Loading = true;
    private List<AdminActivity> FilteredRows => Rows.Where(row =>
        (string.IsNullOrWhiteSpace(StatusFilter) || row.Status.Equals(StatusFilter, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(Search) || $"{row.Username} {row.Action} {row.Resource}".Contains(Search, StringComparison.OrdinalIgnoreCase))).ToList();
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { Loading = true; Error = ""; try { Rows = await Api.GetAdminActivityAsync(); } catch (Exception ex) { Error = ex.Message; } finally { Loading = false; } }
}
