    .sub-tier-featured{border-color:#087f75;box-shadow:0 8px 24px rgba(8,127,117,.08)}
    .sub-tier-enterprise{background:linear-gradient(180deg,#f8fafc 0%,#fff 100%);border-color:#cbd5e1}
    .sub-tier-current{background:#f0fdfa}
    .sub-tier-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
    .sub-tier-name{font-size:17px;font-weight:750;color:#0f172a}
    .sub-tier-badge{padding:3px 8px;border-radius:10px;font-size:10px;font-weight:700;text-transform:uppercase;background:#f1f5f9;color:#475569}
    .sub-tier-badge-pro{background:#ccfbf1;color:#0f766e}
    .sub-tier-badge-ent{background:#0f172a;color:#f8fafc}
    .sub-tier-price{font-size:22px;font-weight:800;color:#0f172a;margin-bottom:6px}
    .sub-tier-price span{font-size:12px;font-weight:500;color:#64748b}
    .sub-tier-desc{font-size:12px;color:#64748b;line-height:1.45;margin:0 0 12px}
    .sub-tier-list{margin:0 0 16px;padding-left:18px;font-size:12px;color:#334155;line-height:1.65;flex:1}
    .sub-tier-foot{margin-top:auto;padding-top:10px;border-top:1px solid #edf0f2}
    .sub-tier-note{display:block;text-align:center;font-size:12px;font-weight:600;color:#087f75}
</style>

@code {
    private List<SubscriptionPlanDto> Plans { get; set; } = [];
    private List<SubscriptionHistoryItemDto> History { get; set; } = [];
    private UserSubscriptionDto? Current { get; set; }
    private SubscriptionHistoryItemDto? SelectedReceipt { get; set; }
    private bool Loading { get; set; } = true;
    private bool Busy { get; set; }
    private string? BusyPlanCode { get; set; }
    private string? BusyAction { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? BlockedPopupUrl { get; set; }
    private DotNetObjectReference<Subscription>? _dotNetRef;

    private bool IsDemoMode => Plans.Any(p => string.Equals(p.Mode, "demo", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        ErrorMessage = null;
        try
        {
            Plans = await Api.GetSubscriptionPlansAsync();
            Current = await Api.GetMySubscriptionAsync();
            History = await Api.GetSubscriptionHistoryAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task StartCheckoutAsync(string planCode)
    {
        Busy = true;
        BusyPlanCode = planCode;
        ErrorMessage = null;
        SuccessMessage = null;
        BlockedPopupUrl = null;
        try
        {
            var checkout = await Api.CreateSubscriptionCheckoutAsync(planCode);
            Current = await Api.GetMySubscriptionAsync();
            await LaunchPopupAsync(checkout.ApprovalUrl, checkout.PayPalSubscriptionId);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
            BusyPlanCode = null;
        }
    }

    private async Task LaunchPopupAsync(string approvalUrl, string subscriptionId)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        var opened = await JS.InvokeAsync<bool>(
            "safePassagePayPal.openCheckoutPopup",
            approvalUrl,
            subscriptionId,
            _dotNetRef);

        if (!opened)
            BlockedPopupUrl = approvalUrl;
    }

    [JSInvokable]
    public async Task OnPayPalApproved(string subscriptionId)
    {
        await ConfirmManuallyAsync(subscriptionId);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnPayPalCancelled(string subscriptionId)
    {
        await AbandonPendingAsync(subscriptionId);
        ErrorMessage = "Checkout was cancelled.";
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnPayPalPopupClosed(string subscriptionId)
    {
        await ConfirmManuallyAsync(subscriptionId, silentIfPending: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmManuallyAsync(string subscriptionId, bool silentIfPending = false)
    {
        Busy = true;
        BusyAction = "confirm";
        ErrorMessage = null;
        SuccessMessage = null;
        BlockedPopupUrl = null;
        try
        {
            Current = await Api.ConfirmSubscriptionAsync(subscriptionId);
            History = await Api.GetSubscriptionHistoryAsync();
            if (Current.HasActiveEntitlement)
                SuccessMessage = $"Subscription {Current.PlanName} is now active.";
            else if (!silentIfPending)
                ErrorMessage = $"Subscription status is currently {FormatStatus(Current.Status)}. Complete approval in checkout first.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
            BusyAction = null;
        }
    }

    private async Task AbandonPendingAsync(string subscriptionId)
    {
        Busy = true;
        BusyAction = "abandon";
        ErrorMessage = null;
        BlockedPopupUrl = null;
        try
        {
            await Api.AbandonSubscriptionAsync(subscriptionId);
            Current = await Api.GetMySubscriptionAsync();
            History = await Api.GetSubscriptionHistoryAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
            BusyAction = null;
        }
    }

    private async Task CancelCurrentAsync()
    {
        if (!await JS.InvokeAsync<bool>(
                "confirm",
                "Cancel your subscription? You will return to the Free tier immediately and lose access to paid features."))
            return;

        Busy = true;
        BusyAction = "cancel";
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            await Api.CancelSubscriptionAsync("Cancelled by user in Web Portal");
            Current = await Api.GetMySubscriptionAsync();
            History = await Api.GetSubscriptionHistoryAsync();
            SuccessMessage = "Your subscription has been cancelled. You are now on the Free tier, and paid features are no longer available.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
            BusyAction = null;
        }
    }

    private async Task ResendReceiptAsync(string? subscriptionId)
    {
        Busy = true;
        BusyAction = "resend";
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var result = await Api.ResendSubscriptionReceiptAsync(subscriptionId);
            SuccessMessage = result.Message;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
            BusyAction = null;
        }
    }

    private static string FormatStatus(string? status) => status switch
    {
        "ApprovalPending" => "Approval Pending",
        null or "" => "Free",
        _ => status
    };

    private async Task PrintReceiptAsync()
    {
        if (SelectedReceipt is null)
            return;

        static string E(string? value) => System.Net.WebUtility.HtmlEncode(value ?? "—");
        var account = E(Api.CurrentEmail ?? Api.CurrentUsername ?? "Account holder");
        var cancelledRow = SelectedReceipt.CancelledAt.HasValue
            ? $"<tr><th>Cancelled At</th><td>{E(SelectedReceipt.CancelledAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm"))}</td></tr>"
            : string.Empty;

        var html = $@"<!doctype html>
<html><head><meta charset=""utf-8""><title>Safe Passage Receipt - {E(SelectedReceipt.SubscriptionId)}</title>
<style>
body{{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#0f172a;margin:36px;max-width:620px}}
.hdr{{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #087f75;padding-bottom:14px;margin-bottom:20px}}
.eyebrow{{font-size:11px;font-weight:700;letter-spacing:.7px;color:#087f75;text-transform:uppercase}}
h1{{font-size:22px;margin:4px 0 0}}
.amt{{font-size:20px;font-weight:800;color:#087f75}}
table{{width:100%;border-collapse:collapse;font-size:13px}}
th,td{{padding:10px 0;border-bottom:1px solid #e2e8f0;text-align:left}}
th{{color:#64748b;font-weight:600;width:42%}}
td{{text-align:right;font-weight:600}}
.foot{{margin-top:24px;font-size:11px;color:#64748b}}
</style></head><body>
<div class=""hdr"">
  <div><div class=""eyebrow"">Safe Passage Official Receipt</div><h1>{E(SelectedReceipt.PlanName)}</h1></div>
  <div class=""amt"">{E(SelectedReceipt.PriceDisplay)}</div>
</div>
<table>
  <tr><th>Account</th><td>{account}</td></tr>
  <tr><th>Reference ID</th><td>{E(SelectedReceipt.SubscriptionId)}</td></tr>
  <tr><th>Status</th><td>{E(FormatStatus(SelectedReceipt.Status))}</td></tr>
  <tr><th>Payment Method</th><td>{E(SelectedReceipt.PaymentMode)}</td></tr>
  <tr><th>Issued Date</th><td>{E(SelectedReceipt.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm"))}</td></tr>
  <tr><th>Billing Period Start</th><td>{E(SelectedReceipt.CurrentPeriodStart?.ToLocalTime().ToString("MMM dd, yyyy"))}</td></tr>
  <tr><th>Expiration / Next Renewal</th><td>{E(SelectedReceipt.CurrentPeriodEnd?.ToLocalTime().ToString("MMM dd, yyyy"))}</td></tr>
  {cancelledRow}
</table>
<div class=""foot"">Generated by Safe Passage Identity Security Platform.</div>
</body></html>";

        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "/receipt-print.js?v=1");
            await module.InvokeVoidAsync("printHtml", html);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to open print dialog: {ex.Message}";
        }
    }

    private static string GetStatusClass(string? status) => status?.ToLowerInvariant() switch
    {
        "active" => "sub-badge-active",
        "approvalpending" => "sub-badge-pending",
        "cancelled" => "sub-badge-cancelled",
        "suspended" or "expired" => "sub-badge-suspended",
        _ => "sub-badge-free"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("safePassagePayPal.dispose");
        }
        catch (JSDisconnectedException)
        {
        }
        _dotNetRef?.Dispose();
    }
}
