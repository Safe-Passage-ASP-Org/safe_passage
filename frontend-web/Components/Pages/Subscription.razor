@page "/subscription"
@using SafePassage.Web.Services
@inject AdminApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Subscription – Safe Passage</PageTitle>

<div class="sp-page-header" style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;">
    <div>
        <h1 class="sp-page-title">Subscription &amp; Billing</h1>
        <p class="sp-page-subtitle">Manage your personal Safe Passage subscription, payment receipts, and billing history.</p>
    </div>
    @if (!Loading && Plans.Count > 0)
    {
        <span class="sub-mode-badge sub-mode-paymongo">
            PayMongo
        </span>
    }
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="sub-alert sub-alert-danger" role="alert">@ErrorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="sub-alert sub-alert-success" role="alert">@SuccessMessage</div>
}

@if (Loading)
{
    <div class="sp-card p-4">
        <div class="text-muted">Loading subscription details...</div>
    </div>
}
else
{
    <div class="sub-grid">
        <section class="sp-card sub-card">
            <div class="sub-section-title">Current Plan</div>
            <div class="sub-current-header">
                <div>
                    <div class="sub-plan-name">@(Current?.PlanName ?? "Free")</div>
                    @if (!string.IsNullOrWhiteSpace(Current?.PayPalSubscriptionId))
                    {
                        <div class="sub-meta">Reference ID: <code>@Current.PayPalSubscriptionId</code></div>
                    }
                </div>
                <span class="sub-status-badge @GetStatusClass(Current?.Status)">@FormatStatus(Current?.Status)</span>
            </div>

            @if (Current?.HasActiveEntitlement == true)
            {
                <div class="sub-details">
                    @if (Current.CurrentPeriodEnd.HasValue)
                    {
                        <div>
                            <strong>@(Current.CancelAtPeriodEnd ? "Active until:" : "Next billing date:")</strong>
                            @Current.CurrentPeriodEnd.Value.ToLocalTime().ToString("MMM dd, yyyy")
                        </div>
                    }
                    @if (Current.CancelAtPeriodEnd)
                    {
                        <div class="sub-warning-text">
                            Auto-renewal is off. You retain access until the end of your paid period.
                        </div>
                    }
                </div>

                <div class="sub-actions-row">
                    @if (string.Equals(Current.Status, "Active", StringComparison.OrdinalIgnoreCase))
                    {
                        <button class="sub-btn sub-btn-danger" type="button" disabled="@Busy" @onclick="CancelCurrentAsync">
                            @(BusyAction == "cancel" ? "Cancelling..." : "Cancel Subscription")
                        </button>
                    }
                    <button class="sub-btn sub-btn-secondary" type="button" disabled="@Busy" @onclick="() => ResendReceiptAsync(Current.PayPalSubscriptionId)">
                        @(BusyAction == "resend" ? "Sending..." : "Resend Receipt Email")
                    </button>
                </div>
            }
            else if (string.Equals(Current?.Status, "ApprovalPending", StringComparison.OrdinalIgnoreCase))
            {
                <div class="sub-details">
                    <p class="sub-pending-text">
                        A PayMongo checkout is awaiting your payment confirmation.
                    </p>
                    <div class="sub-actions-row">
                        @if (Current is { } pendingSubscription
                             && !string.IsNullOrWhiteSpace(pendingSubscription.PendingApprovalUrl)
                             && !string.IsNullOrWhiteSpace(pendingSubscription.PayPalSubscriptionId))
                        {
                            <button class="sub-btn sub-btn-primary" type="button" disabled="@Busy"
                                    @onclick="() => LaunchPopupAsync(pendingSubscription.PendingApprovalUrl, pendingSubscription.PayPalSubscriptionId)">
                                Resume Checkout
                            </button>
                        }
                        @if (Current?.PayPalSubscriptionId is { } pendingSubscriptionId
                             && !string.IsNullOrWhiteSpace(pendingSubscriptionId))
                        {
                            <button class="sub-btn sub-btn-secondary" type="button" disabled="@Busy"
                                    @onclick="() => ConfirmManuallyAsync(pendingSubscriptionId)">
                                @(BusyAction == "confirm" ? "Checking..." : "Check / Confirm Status")
                            </button>
                            <button class="sub-btn sub-btn-danger" type="button" disabled="@Busy"
                                    @onclick="() => AbandonPendingAsync(pendingSubscriptionId)">
                                @(BusyAction == "abandon" ? "Discarding..." : "Discard Pending")
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="sub-note mb-0">You are currently on the Free tier. Choose a plan below to subscribe with PayMongo (Card, GCash, Maya, GrabPay).</p>
            }

            @if (!string.IsNullOrWhiteSpace(BlockedPopupUrl))
            {
                <div class="sub-alert sub-alert-warning" style="margin-top:12px;">
                    Popup was blocked by your browser.
                    <a href="@BlockedPopupUrl" target="_blank" rel="noopener noreferrer">Open Checkout</a>,
                    then click <strong>Check / Confirm Status</strong> above after completing payment.
                </div>
            }
        </section>

        <section class="sp-card sub-card">
            <div class="sub-section-title">Available Plans</div>
            @if (Plans.Count == 0)
            {
                <p class="sub-note mb-0">No subscription plans are configured.</p>
            }
            else
            {
                <div class="sub-plans-list">
                    @foreach (var plan in Plans)
                    {
                        var isCurrentActivePlan = Current?.HasActiveEntitlement == true
                            && string.Equals(Current.PlanCode, plan.PlanCode, StringComparison.OrdinalIgnoreCase);

                        var isThisPlanBusy = string.Equals(BusyPlanCode, plan.PlanCode, StringComparison.OrdinalIgnoreCase);

                        <div class="sub-plan-item @(isCurrentActivePlan ? "sub-plan-item-active" : "")">
                            <div class="sub-plan-info">
                                <div class="sub-plan-title">
                                    <strong>@plan.Name</strong>
                                    <span class="sub-price">@plan.PriceDisplay</span>
                                </div>
                                <div class="sub-plan-desc">@plan.Description</div>
                                @if (!plan.IsConfigured)
                                {
                                    <div class="sub-unconfigured">Payment checkout is not configured on the server</div>
                                }
                            </div>
                            <button class="sub-btn sub-btn-primary" type="button"
                                    disabled="@(Busy || !plan.IsConfigured || Current?.HasActiveEntitlement == true)"
                                    @onclick="() => StartCheckoutAsync(plan.PlanCode)">
                                @(isCurrentActivePlan ? "Current Plan" : isThisPlanBusy ? "Starting..." : "Subscribe with PayMongo")
                            </button>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <section class="sp-card sub-card" style="margin-top:16px;">
        <div class="sub-section-title">Plan Features</div>
        <div class="sub-tiers-grid">
            <div class="sub-tier-card @(Current?.HasActiveEntitlement != true ? "sub-tier-current" : "")">
                <div class="sub-tier-head"><span class="sub-tier-name">Free</span><span class="sub-tier-badge">Starter</span></div>
                <div class="sub-tier-price">PHP 0 <span>/ month</span></div>
                <p class="sub-tier-desc">Core account protection and a personal credential vault.</p>
                <ul class="sub-tier-list">
                    <li>Mobile MFA sign-in approvals</li>
                    <li>Up to 2 trusted devices</li>
                    <li>Up to 5 saved websites with username and password autofill</li>
                    <li>7-day sign-in activity history</li>
                </ul>
                <div class="sub-tier-foot"><span class="sub-tier-note">@(Current?.HasActiveEntitlement != true ? "Active on your account" : "Included base tier")</span></div>
            </div>
            <div class="sub-tier-card sub-tier-featured @(Current?.HasActiveEntitlement == true ? "sub-tier-current" : "")">
                <div class="sub-tier-head"><span class="sub-tier-name">Pro</span><span class="sub-tier-badge sub-tier-badge-pro">Monthly or annual</span></div>
                <div class="sub-tier-price">PHP 299 <span>/ month</span></div>
                <p class="sub-tier-desc">More room for trusted devices and saved logins, plus authenticator support.</p>
                <ul class="sub-tier-list">
                    <li>Unlimited trusted devices and saved websites</li>
                    <li>Authenticator secret storage and generated codes in the extension</li>
                    <li>90-day sign-in activity history</li>
                    <li>All Free features</li>
                </ul>
                <div class="sub-tier-foot"><span class="sub-tier-note">Choose Pro Monthly or Pro Annual in Available Plans above.</span></div>
            </div>
            <div class="sub-tier-card sub-tier-enterprise">
                <div class="sub-tier-head"><span class="sub-tier-name">Enterprise</span><span class="sub-tier-badge sub-tier-badge-ent">Organization plan</span></div>
                <div class="sub-tier-price">Features to be defined</div>
                <p class="sub-tier-desc">Enterprise is reserved for future organization features. Its capabilities and pricing have not been defined.</p>
                <ul class="sub-tier-list"><li>Feature set to be announced</li><li>No Enterprise checkout is available yet</li></ul>
                <div class="sub-tier-foot"><span class="sub-tier-note">Coming soon</span></div>
            </div>
        </div>
    </section>
    <section class="sp-card sub-card mt-4">
        <div class="sub-section-title">Billing &amp; Receipt History</div>
        @if (History.Count == 0)
        {
            <p class="sub-note mb-0">No checkout sessions or billing receipts recorded yet.</p>
        }
        else
        {
            <div class="sub-table-wrap">
                <table class="sub-table">
                    <thead>
                        <tr>
                            <th>Plan</th>
                            <th>Status</th>
                            <th>Amount</th>
                            <th>Mode</th>
                            <th>Reference ID</th>
                            <th>Date</th>
                            <th>Expires</th>
                            <th style="text-align:right;">Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in History)
                        {
                            var canResend = (string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase)
                                             || string.Equals(item.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                                            && item.CurrentPeriodStart.HasValue;
                            <tr>
                                <td><strong>@item.PlanName</strong></td>
                                <td><span class="sub-status-badge @GetStatusClass(item.Status)">@FormatStatus(item.Status)</span></td>
                                <td>@item.PriceDisplay</td>
                                <td>@item.PaymentMode</td>
                                <td><code>@item.SubscriptionId</code></td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@(item.CurrentPeriodEnd.HasValue ? item.CurrentPeriodEnd.Value.ToLocalTime().ToString("MMM dd, yyyy") : "—")</td>
                                <td style="text-align:right;">
                                    <div style="display:inline-flex;gap:6px;justify-content:flex-end;">
                                        <button class="sub-btn sub-btn-secondary sub-btn-sm" type="button"
                                                @onclick="() => SelectedReceipt = item">
                                            View Receipt
                                        </button>
                                        @if (canResend)
                                        {
                                            <button class="sub-btn sub-btn-secondary sub-btn-sm" type="button" disabled="@Busy"
                                                    @onclick="() => ResendReceiptAsync(item.SubscriptionId)">
                                                Resend
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (SelectedReceipt is not null)
    {
        <div class="sub-receipt-backdrop" @onclick="() => SelectedReceipt = null">
            <section class="sub-receipt-modal" role="dialog" aria-modal="true" aria-labelledby="receipt-modal-title" @onclick:stopPropagation="true">
                <div class="sub-receipt-header">
                    <div>
                        <span class="sub-receipt-eyebrow">SAFE PASSAGE RECEIPT</span>
                        <h2 id="receipt-modal-title">@SelectedReceipt.PlanName</h2>
                    </div>
                    <button type="button" class="sub-receipt-close no-print" aria-label="Close" @onclick="() => SelectedReceipt = null">&times;</button>
                </div>
                <dl class="sub-receipt-dl">
                    <dt>Account</dt><dd>@(Api.CurrentEmail ?? Api.CurrentUsername ?? "Account holder")</dd>
                    <dt>Reference ID</dt><dd><code>@SelectedReceipt.SubscriptionId</code></dd>
                    <dt>Status</dt><dd>@FormatStatus(SelectedReceipt.Status)</dd>
                    <dt>Amount</dt><dd>@SelectedReceipt.PriceDisplay</dd>
                    <dt>Payment Method</dt><dd>@SelectedReceipt.PaymentMode</dd>
                    <dt>Issued Date</dt><dd>@SelectedReceipt.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</dd>
                    <dt>Billing Period Start</dt><dd>@(SelectedReceipt.CurrentPeriodStart?.ToLocalTime().ToString("MMM dd, yyyy") ?? "—")</dd>
                    <dt>Expiration / Next Renewal</dt><dd>@(SelectedReceipt.CurrentPeriodEnd?.ToLocalTime().ToString("MMM dd, yyyy") ?? "—")</dd>
                    @if (SelectedReceipt.CancelledAt.HasValue)
                    {
                        <dt>Cancelled At</dt><dd>@SelectedReceipt.CancelledAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</dd>
                    }
                </dl>
                <div class="sub-receipt-footer no-print">
                    <button type="button" class="sub-btn sub-btn-secondary" @onclick="() => SelectedReceipt = null">Close</button>
                    <button type="button" class="sub-btn sub-btn-primary" @onclick="PrintReceiptAsync">Print Receipt</button>
                </div>
            </section>
        </div>
    }
}

<style>
