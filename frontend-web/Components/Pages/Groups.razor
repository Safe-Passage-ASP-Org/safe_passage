@page "/groups"
@rendermode InteractiveServer

<PageTitle>Groups – Safe Passage</PageTitle>

<div class="sp-page-header">
    <h1 class="sp-page-title">Groups</h1>
    <p class="sp-page-subtitle">Organize users into groups for streamlined access and policy management.</p>
</div>

<div class="sp-card d-flex flex-column align-items-center justify-content-center py-5 text-center">
    <div class="sp-placeholder-icon">🗂️</div>
    <h5 class="fw-semibold mb-2">Groups</h5>
    <p class="text-muted" style="max-width:420px">
        Group memberships, nested groups, and group-level policy assignments will be managed here.
    </p>
    <button class="btn btn-primary mt-3" disabled>
        + Create Group
    </button>
</div>
