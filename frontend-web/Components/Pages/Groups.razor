@page "/groups"
@rendermode InteractiveServer
@using SafePassage.Web.Services
@inject AdminApiClient Api

<PageTitle>Groups – Safe Passage</PageTitle>
<div class="sp-page-header"><h1 class="sp-page-title">Groups</h1><p class="sp-page-subtitle">Organize users into groups for application access assignments.</p></div>
<div class="groups-toolbar"><span>@DirectoryGroups.Count groups</span><button class="groups-primary" @onclick="OpenCreate" disabled="@Busy">＋ Create group</button></div>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="groups-alert" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Notice)) { <div class="groups-notice" role="status">@Notice</div> }
<section class="sp-card groups-card">
    @if (Loading) { <p class="groups-state" role="status">Loading groups…</p> }
    else if (DirectoryGroups.Count == 0) { <p class="groups-state">No groups yet. Create one to assign users and applications.</p> }
    else
    {
        <div class="groups-scroll"><table><thead><tr><th>Group</th><th>Description</th><th>Members</th><th>Actions</th></tr></thead><tbody>
        @foreach (var group in DirectoryGroups)
        {
            <tr><td><strong>@group.Name</strong></td><td>@(string.IsNullOrWhiteSpace(group.Description) ? "—" : group.Description)</td><td>@group.MemberCount</td><td><button @onclick="() => OpenEdit(group)" disabled="@Busy">Edit</button><button class="danger" @onclick="() => DeleteAsync(group)" disabled="@Busy">Delete</button></td></tr>
        }
        </tbody></table></div>
    }
</section>
@if (ModalOpen)
{
    <div class="groups-backdrop" @onclick="CloseModal"><section class="groups-modal" role="dialog" aria-modal="true" aria-labelledby="group-title" @onclick:stopPropagation="true">
        <header><div><small>DIRECTORY GROUPS</small><h2 id="group-title">@(Editing is null ? "Create group" : "Edit group")</h2></div><button aria-label="Close" @onclick="CloseModal">×</button></header>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true"><label>Name<input required maxlength="120" @bind="Draft.Name" /></label><label>Description<textarea maxlength="1000" rows="3" @bind="Draft.Description"></textarea></label>
            @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="groups-alert" role="alert">@FormError</div> }
            <footer><button type="button" class="cancel" @onclick="CloseModal" disabled="@Saving">Cancel</button><button type="submit" class="groups-primary" disabled="@Saving">@(Saving ? "Saving…" : "Save group")</button></footer>
        </form>
    </section></div>
}

<style>
    .groups-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;color:#64748b;font-size:12px}.groups-primary{border:0;border-radius:5px;padding:9px 14px;background:#087f75;color:#fff;font-size:13px;font-weight:650;cursor:pointer}.groups-primary:disabled{opacity:.6}.groups-alert,.groups-notice{padding:11px 14px;border-radius:6px;margin-bottom:14px;font-size:13px}.groups-alert{background:#fcecea;color:#9d332b}.groups-notice{background:#edf7f2;color:#087f5b}.groups-card{overflow:hidden}.groups-scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:620px}th{text-align:left;background:#f8fafb;color:#64748b;text-transform:uppercase;font-size:10px;letter-spacing:.5px;padding:12px 16px}td{padding:14px 16px;border-top:1px solid #edf0f2;font-size:13px;max-width:420px;overflow-wrap:anywhere}td button{border:0;background:none;color:#087f75;font-size:12px;font-weight:650;cursor:pointer;margin-right:10px}td button.danger{color:#b5473c}td button:disabled{opacity:.5}.groups-state{padding:24px;color:#64748b;font-size:13px}.groups-backdrop{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:18px;background:#0f172a80}.groups-modal{background:#fff;width:min(100%,450px);max-height:90vh;overflow:auto;border-radius:9px;padding:24px;box-shadow:0 20px 60px #0f172a40}.groups-modal header{display:flex;justify-content:space-between;margin-bottom:20px}.groups-modal header small{font-size:10px;color:#087f75;font-weight:700}.groups-modal h2{font-size:20px;margin:5px 0}.groups-modal header button{border:0;background:none;color:#64748b;font-size:24px;cursor:pointer}.groups-modal form{display:grid;gap:14px}.groups-modal label{display:grid;gap:6px;color:#334155;font-size:12px;font-weight:650}.groups-modal input,.groups-modal textarea{width:100%;border:1px solid #cbd5dc;border-radius:5px;padding:10px;font:inherit;font-size:13px}.groups-modal footer{display:flex;justify-content:flex-end;gap:8px;margin-top:6px}.groups-modal .cancel{border:0;border-radius:5px;background:#f1f5f9;color:#334155;padding:9px 14px}.groups-modal button:disabled{opacity:.6}
</style>

@code {
    private List<AdminGroup> DirectoryGroups = [];
    private AdminGroup? Editing;
    private AdminGroupForm Draft = new();
    private bool Loading = true, Busy, Saving, ModalOpen;
    private string Error = "", FormError = "", Notice = "";
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { Loading = true; Error = ""; try { DirectoryGroups = await Api.GetGroupsAsync(); } catch (Exception ex) { Error = ex.Message; } finally { Loading = false; } }
    private void OpenCreate() { Editing = null; Draft = new(); FormError = ""; ModalOpen = true; }
    private void OpenEdit(AdminGroup group) { Editing = group; Draft = new() { Name = group.Name, Description = group.Description }; FormError = ""; ModalOpen = true; }
    private void CloseModal() { if (!Saving) ModalOpen = false; }
    private async Task SaveAsync() { Saving = true; FormError = ""; try { await Api.SaveGroupAsync(Draft, Editing?.Id); ModalOpen = false; Notice = "Group saved."; await LoadAsync(); } catch (Exception ex) { FormError = ex.Message; } finally { Saving = false; } }
    private async Task DeleteAsync(AdminGroup group) { Busy = true; Error = ""; Notice = ""; try { await Api.DeleteGroupAsync(group.Id); Notice = "Group deleted."; await LoadAsync(); } catch (Exception ex) { Error = ex.Message; } finally { Busy = false; } }
}
