@page "/settings"
@using SafePassage.Web.Services
@inject AdminApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Settings – Safe Passage</PageTitle>
<div class="sp-page-header settings-page-heading"><h1 class="sp-page-title">Settings</h1><p class="sp-page-subtitle">Manage your Safe Passage account and security preferences.</p></div>

<div class="settings-layout">
    <nav class="settings-sidebar" aria-label="Settings sections">
        <div class="settings-nav-group">
            <button type="button" class="settings-nav-item @SectionClass("profile")" aria-current="@(ActiveSection == "profile" ? "page" : null)" @onclick="ShowProfile">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm5.5 6a5.5 5.5 0 0 0-11 0v1h11z" /></svg><span>Profile</span>
            </button>
            <button type="button" class="settings-nav-item @SectionClass("account")" aria-current="@(ActiveSection == "account" ? "page" : null)" @onclick="ShowAccount">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1 2 3v4c0 3.5 2.5 6.5 6 8 3.5-1.5 6-4.5 6-8V3zm0 2.1 4 1.3v2.6c0 2.4-1.5 4.5-4 5.8-2.5-1.3-4-3.4-4-5.8V4.4z" /><path d="M7.3 8.9 5.8 7.4l-.9.9 2.4 2.4 4-4-.9-.9z" /></svg><span>Account security</span>
            </button>
            <button type="button" class="settings-nav-item @SectionClass("devices")" aria-current="@(ActiveSection == "devices" ? "page" : null)" @onclick="ShowDevices">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1Zm0 1v10h8V2zm3 11v1h2v-1z" /></svg><span>Trusted devices</span>
            </button>
            <button type="button" class="settings-nav-item @SectionClass("appearance")" aria-current="@(ActiveSection == "appearance" ? "page" : null)" @onclick="ShowAppearance">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1a7 7 0 1 0 0 14h1.1a2.4 2.4 0 0 0 1.7-4.1.8.8 0 0 1 .6-1.4H13a2 2 0 0 0 2-2A6.5 6.5 0 0 0 8 1ZM4.5 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm2-3a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm4 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm2 3a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z" /></svg><span>Appearance</span>
            </button>
        </div>

        <div class="settings-nav-footer">
            <button type="button" class="settings-nav-item settings-nav-signout" @onclick="SignOutAsync">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2h8v12H6v-2h2v1h4V3H8v1H6zm1 3 3 3-3 3V9H1V7h6z" /></svg><span>Sign out</span>
            </button>
        </div>
    </nav>

    <section class="settings-content" aria-live="polite">
        @if (ActiveSection == "profile")
        {
            <header class="settings-content-heading"><h2>Profile</h2><p>Your identity details for this Safe Passage account.</p></header>
            <section class="settings-panel">
                <div class="settings-profile-row">
                    <div class="settings-avatar-wrap">
                        <div class="settings-avatar-picker">
                            @if (!string.IsNullOrWhiteSpace(ProfileImageData))
                            {
                                <img class="settings-avatar-image" src="@ProfileImageData" alt="Profile picture" />
                            }
                            else
                            {
                                <span class="settings-avatar" aria-hidden="true">@AvatarInitials</span>
                            }
                            <InputFile @key="ProfileImageInputVersion" class="settings-avatar-upload" aria-label="Edit profile picture. Choose a JPG, PNG, or WebP image under 1 MB." accept="image/jpeg,image/png,image/webp" OnChange="UpdateProfileImageAsync" disabled="@SavingProfileImage" />
                            <span class="settings-avatar-edit" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M11.013 1.427a1.75 1.75 0 0 1 2.475 0l1.085 1.085a1.75 1.75 0 0 1 0 2.475l-8.5 8.5a1.75 1.75 0 0 1-.742.438l-3.16.904a.75.75 0 0 1-.927-.927l.904-3.16a1.75 1.75 0 0 1 .438-.742l8.427-8.573Zm-7.306 9.634-.53 1.855 1.855-.53 7.25-7.25-1.325-1.325-7.25 7.25Zm9.635-8.31a.25.25 0 0 0-.354 0l-.969.987 1.325 1.325.987-.969a.25.25 0 0 0 0-.354l-.99-.99Z" /></svg></span>
                        </div>
                        @if (SavingProfileImage) { <span class="settings-avatar-caption" role="status">Uploading…</span> }
                        else if (ProfileImageData is not null) { <button type="button" class="settings-avatar-remove" @onclick="RemoveProfileImageAsync">Remove picture</button> }
                        else { <span class="settings-avatar-caption">Edit picture</span> }
                    </div>
                    <div class="settings-profile-info"><strong>@(ProfileName ?? Api.CurrentUsername ?? "—")</strong><span>@(Api.CurrentRole ?? "User")</span></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(ProfileImageError)) { <div class="settings-alert error" role="alert">@ProfileImageError</div> }
                @if (!string.IsNullOrWhiteSpace(ProfileImageNotice)) { <div class="settings-alert ok" role="status">@ProfileImageNotice</div> }
                <form class="settings-form settings-profile-form" @onsubmit="SaveProfileAsync" @onsubmit:preventDefault="true">
                    <label>Name<input maxlength="200" required autocomplete="name" @bind="ProfileName" /></label>
                    @if (!string.IsNullOrWhiteSpace(ProfileError)) { <div class="settings-alert error" role="alert">@ProfileError</div> }
                    @if (!string.IsNullOrWhiteSpace(ProfileNotice)) { <div class="settings-alert ok" role="status">@ProfileNotice</div> }
                    <button class="settings-save-btn" type="submit" disabled="@SavingProfile">@(SavingProfile ? "Saving…" : "Save name")</button>
                </form>
                <dl class="settings-details">
                    <div><dt>Username</dt><dd>@(ProfileUsername ?? "—")</dd></div>
                    <div><dt>Sign-in email</dt><dd>@(ProfileEmail ?? Api.CurrentEmail ?? "Not available")</dd></div>
                </dl>
            </section>
            <section class="settings-panel backup-email-panel">
                <h3>Backup email</h3>
                <p class="settings-note">Add an alternate address for account recovery. It becomes active only after you verify it using the email link or 6-digit code.</p>
                @if (!string.IsNullOrWhiteSpace(ProfileBackupEmail))
                {
                    <p class="settings-verified-email"><span class="settings-verified-dot" aria-hidden="true"></span>Verified: <strong>@ProfileBackupEmail</strong></p>
                }
                <form class="settings-form" @onsubmit="RequestBackupEmailAsync" @onsubmit:preventDefault="true">
                    <label>Backup email address<input type="email" required maxlength="320" autocomplete="email" @bind="BackupEmailDraft" /></label>
                    @if (!string.IsNullOrWhiteSpace(BackupEmailError)) { <div class="settings-alert error" role="alert">@BackupEmailError</div> }
                    @if (!string.IsNullOrWhiteSpace(BackupEmailNotice)) { <div class="settings-alert ok" role="status">@BackupEmailNotice</div> }
                    <button class="settings-save-btn" type="submit" disabled="@SendingBackupEmail">@(SendingBackupEmail ? "Sending…" : "Send verification")</button>
                </form>
                @if (BackupEmailVerificationSent)
                {
                    <form class="settings-form settings-email-verify" @onsubmit="VerifyBackupEmailOtpAsync" @onsubmit:preventDefault="true">
                        <label>6-digit verification code<input inputmode="numeric" autocomplete="one-time-code" required minlength="6" maxlength="6" pattern="[0-9]{6}" @bind="BackupEmailOtp" /></label>
                        <button class="settings-save-btn" type="submit" disabled="@VerifyingBackupEmail">@(VerifyingBackupEmail ? "Verifying…" : "Verify backup email")</button>
                    </form>
                }
            </section>
        }
        else if (ActiveSection == "account")
        {
            <header class="settings-content-heading"><h2>Account security</h2><p>Update the credentials used to sign in to Safe Passage.</p></header>
            @if (Api.IsAdministrator)
            {
                <section class="settings-panel">
                    <h3>Change email</h3>
                    <p class="settings-note">A verification link and 6-digit code will be sent to your new address. Your email changes after you verify either one.</p>
                    <form class="settings-form" @onsubmit="RequestEmailChangeAsync" @onsubmit:preventDefault="true">
                        <label>New email address<input type="email" required maxlength="320" autocomplete="email" @bind="NewEmail" /></label>
                        @if (!string.IsNullOrWhiteSpace(EmailError)) { <div class="settings-alert error" role="alert">@EmailError</div> }
                        @if (!string.IsNullOrWhiteSpace(EmailNotice)) { <div class="settings-alert ok" role="status">@EmailNotice</div> }
                        <button class="settings-save-btn" type="submit" disabled="@SendingEmailCode">@(SendingEmailCode ? "Sending…" : "Send verification")</button>
                    </form>
                    @if (EmailVerificationSent)
                    {
                        <form class="settings-form settings-email-verify" @onsubmit="VerifyEmailOtpAsync" @onsubmit:preventDefault="true">
                            <label>6-digit verification code<input inputmode="numeric" autocomplete="one-time-code" required minlength="6" maxlength="6" pattern="[0-9]{6}" @bind="EmailOtp" /></label>
                            <button class="settings-save-btn" type="submit" disabled="@VerifyingEmail">@(VerifyingEmail ? "Verifying…" : "Verify code")</button>
                        </form>
                    }
                </section>
            }
            else
            {
                <section class="settings-panel">
                    <h3>Change password</h3>
                    <p class="settings-note">Update the password for your Safe Passage account.</p>
                    <form class="settings-form" @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault="true">
                        <label>Current password<input type="password" required autocomplete="current-password" @bind="CurrentPassword" /></label>
                        <label>New password<input type="password" required minlength="8" autocomplete="new-password" @bind="NewPassword" /></label>
                        <label>Confirm new password<input type="password" required minlength="8" autocomplete="new-password" @bind="ConfirmPassword" /></label>
                        @if (!string.IsNullOrWhiteSpace(PasswordError)) { <div class="settings-alert error" role="alert">@PasswordError</div> }
                        @if (!string.IsNullOrWhiteSpace(PasswordNotice)) { <div class="settings-alert ok" role="status">@PasswordNotice</div> }
                        <button class="settings-save-btn" type="submit" disabled="@SavingPassword">@(SavingPassword ? "Updating…" : "Update password")</button>
                    </form>
                </section>
            }
        }
        else if (ActiveSection == "devices")
        {
            <header class="settings-content-heading"><h2>Trusted devices</h2><p>Review registered devices and their trust status.</p></header>
            <section class="settings-panel settings-link-panel">
                <div>
                    <h3>@(Api.IsAdministrator ? "Manage devices" : "My devices")</h3>
                    <p class="settings-note">@(Api.IsAdministrator ? "Review device enrollment and manage trust for registered users." : "View the devices registered to your account and their trust status.")</p>
                </div>
                <a class="settings-action-link" href="/devices">@(Api.IsAdministrator ? "Manage devices" : "View my devices") <span aria-hidden="true">→</span></a>
            </section>
        }
        else if (ActiveSection == "appearance")
        {
            <header class="settings-content-heading"><h2>Appearance</h2><p>Choose how Safe Passage looks while you are signed in.</p></header>
            <section class="settings-panel appearance-panel">
                <h3>Theme</h3>
                <p class="settings-note">Your choice applies to this signed-in session and resets to Light when you sign out.</p>
                <div class="appearance-options" role="radiogroup" aria-label="Theme">
                    <button type="button" class="appearance-option @(SelectedTheme == "light" ? "selected" : "")" role="radio" aria-checked="@(SelectedTheme == "light")" @onclick='() => SetThemeAsync("light")'>
                        <span class="appearance-preview light-preview" aria-hidden="true"><i></i><i></i><i></i></span>
                        <span><strong>Light</strong><small>Default appearance</small></span>
                    </button>
                    <button type="button" class="appearance-option @(SelectedTheme == "dark" ? "selected" : "")" role="radio" aria-checked="@(SelectedTheme == "dark")" @onclick='() => SetThemeAsync("dark")'>
                        <span class="appearance-preview dark-preview" aria-hidden="true"><i></i><i></i><i></i></span>
                        <span><strong>Dark</strong><small>Low-light appearance</small></span>
                    </button>
                </div>
            </section>
        }
    </section>
</div>

<style>
    .settings-page-heading{margin-bottom:22px}
    .settings-layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:30px;max-width:1100px;align-items:start}
    .settings-sidebar{min-height:440px;display:flex;flex-direction:column;justify-content:space-between;gap:18px;padding:0 18px 0 0;border-right:1px solid #d8dee4}
    .settings-nav-group,.settings-nav-footer{display:grid;gap:3px}
    .settings-nav-footer{padding-top:12px;border-top:1px solid #d8dee4}
    .settings-nav-item{width:100%;min-height:36px;display:flex;align-items:center;gap:10px;padding:7px 10px;border:0;border-radius:6px;background:transparent;color:#334155;text-align:left;font:inherit;font-size:13px;cursor:pointer}
    .settings-nav-item svg{width:16px;height:16px;flex:0 0 16px;fill:currentColor;color:#64748b}
    .settings-nav-item:hover{background:#f1f5f9;color:#0f172a}
    .settings-nav-item.active{background:#eaf2f8;color:#0f172a;font-weight:650;box-shadow:inset 2px 0 #0969da}
    .settings-nav-item.active svg{color:#0969da}
    .settings-nav-signout{color:#b42318}
    .settings-nav-signout svg{color:#b42318}
    .settings-nav-signout:hover{background:#fff1f0;color:#b42318}
    .settings-content{min-width:0}
    .settings-content-heading{padding:0 0 14px;margin:0 0 16px;border-bottom:1px solid #d8dee4}
    .settings-content-heading h2{margin:0 0 5px;color:#1f2328;font-size:22px;font-weight:600}
    .settings-content-heading p{margin:0;color:#64748b;font-size:13px;line-height:1.5}
    .settings-panel{padding:20px 22px;border:1px solid #d8dee4;border-radius:7px;background:#fff}
    .settings-panel h3{margin:0 0 7px;color:#1f2328;font-size:15px;font-weight:600}
    .settings-profile-row{display:flex;align-items:center;gap:13px;padding-bottom:18px;border-bottom:1px solid #e5e7eb}
    .settings-profile-form{margin:18px 0}
    .backup-email-panel{margin-top:16px}
    .settings-verified-email{display:flex;align-items:center;gap:7px;margin:0 0 15px;color:#334155;font-size:12px}
    .settings-verified-dot{width:8px;height:8px;border-radius:50%;background:#1f883d}
    .settings-avatar-wrap{display:grid;justify-items:center;gap:5px;flex:0 0 auto}
    .settings-avatar-picker{position:relative;width:64px;height:64px;flex:0 0 auto;border-radius:50%;cursor:pointer}
    .settings-avatar-picker:focus-within{outline:2px solid #0969da;outline-offset:3px}
    .settings-avatar,.settings-avatar-image{width:64px;height:64px;border-radius:50%;display:grid;place-items:center}
    .settings-avatar{background:var(--sp-accent,#087f75);color:#fff;font-size:18px;font-weight:700}
    .settings-avatar-image{display:block;object-fit:cover;border:1px solid #d8dee4}
    .settings-avatar-upload{position:absolute;inset:0;width:100%;height:100%;opacity:0;border-radius:50%;cursor:pointer;z-index:2}
    .settings-avatar-edit{position:absolute;right:-2px;bottom:-1px;z-index:1;width:23px;height:23px;display:grid;place-items:center;border:2px solid #fff;border-radius:50%;background:#0969da;color:#fff;box-shadow:0 1px 4px #0f172a55;pointer-events:none}
    .settings-avatar-edit svg{width:12px;height:12px;fill:currentColor}
    .settings-avatar-caption,.settings-avatar-remove{color:#64748b;font-size:10px}
    .settings-avatar-remove{padding:0;border:0;background:none;text-decoration:underline;cursor:pointer}
    .settings-profile-info{display:flex;flex-direction:column;gap:4px;min-width:0}
    .settings-profile-info strong{color:#1f2328;font-size:14px}
    .settings-profile-info span,.settings-note{color:#64748b;font-size:12px;line-height:1.6}
    .settings-details{display:grid;gap:0;margin:0}
    .settings-details>div{display:grid;grid-template-columns:minmax(100px, .35fr) minmax(0,1fr);gap:14px;padding:12px 0;border-bottom:1px solid #e5e7eb;font-size:12px}
    .settings-details>div:last-child{border-bottom:0;padding-bottom:0}
    .settings-details dt{color:#64748b;font-weight:600}
    .settings-details dd{margin:0;color:#1f2328;overflow-wrap:anywhere}
    .settings-note{margin:0 0 14px}
    .settings-form{display:grid;gap:11px;max-width:460px}
    .settings-form label{display:grid;gap:5px;color:#334155;font-size:12px;font-weight:600}
    .settings-form input{width:100%;box-sizing:border-box;padding:9px 10px;border:1px solid #cbd5dc;border-radius:6px;background:#fff;color:#1f2328;font:inherit;font-size:13px}
    .settings-form input:focus{outline:2px solid #0969da;outline-offset:-1px;border-color:#0969da}
    .settings-email-verify{margin-top:16px;padding-top:16px;border-top:1px solid #d8dee4}
    .settings-save-btn{justify-self:start;padding:8px 13px;border:1px solid #1f883d;border-radius:6px;background:#1f883d;color:#fff;font-size:12px;font-weight:650;cursor:pointer}
    .settings-save-btn:hover{background:#1a7f37}
    .settings-save-btn:disabled{opacity:.6;cursor:wait}
    .settings-alert{padding:9px 11px;border-radius:6px;font-size:12px}
    .settings-alert.error{background:#fff1f0;color:#b42318}
    .settings-alert.ok{background:#edf7f2;color:#087f5b}
    .settings-link-panel{display:flex;justify-content:space-between;align-items:center;gap:18px}
    .settings-link-panel h3{margin-bottom:5px}
    .settings-link-panel .settings-note{margin:0}
    .settings-action-link{display:inline-flex;align-items:center;gap:7px;flex:0 0 auto;padding:7px 11px;border:1px solid #d8dee4;border-radius:6px;color:#0969da;text-decoration:none;font-size:12px;font-weight:600}
    .settings-action-link:hover{background:#f6f8fa;text-decoration:none}
    .appearance-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:560px}
    .appearance-option{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #d8dee4;border-radius:7px;background:#fff;color:#1f2328;text-align:left;cursor:pointer}
    .appearance-option:hover{border-color:#0969da}
    .appearance-option.selected{border-color:#0969da;box-shadow:0 0 0 2px #0969da22}
    .appearance-option>span:last-child{display:grid;gap:3px}
    .appearance-option strong{font-size:13px}
    .appearance-option small{color:#64748b;font-size:11px}
    .appearance-preview{width:76px;height:48px;flex:0 0 auto;display:grid;grid-template-columns:18px 1fr;grid-template-rows:repeat(2,1fr);gap:3px;padding:5px;border:1px solid #d8dee4;border-radius:4px;background:#fff}
    .appearance-preview i{display:block;border-radius:2px;background:#dbeafe}
    .appearance-preview i:first-child{grid-row:span 2;background:#0f172a}
    .appearance-preview i:nth-child(2){background:#e2e8f0}
    .dark-preview{background:#0d1117;border-color:#30363d}
    .dark-preview i,.dark-preview i:first-child{background:#21262d}
    .dark-preview i:nth-child(2){background:#30363d}
    @@media(max-width:760px){.settings-layout{grid-template-columns:190px minmax(0,1fr);gap:20px}.settings-sidebar{padding-right:12px}}
    @@media(max-width:600px){.settings-layout{grid-template-columns:1fr;gap:18px}.settings-sidebar{min-height:0;padding:0 0 14px;border-right:0;border-bottom:1px solid #d8dee4}.settings-nav-group{grid-template-columns:repeat(2,minmax(0,1fr))}.settings-nav-footer{padding-top:8px}.settings-content-heading h2{font-size:20px}.settings-panel{padding:16px}.settings-link-panel{align-items:flex-start;flex-direction:column}.settings-details>div{grid-template-columns:100px minmax(0,1fr)}}
</style>

@code {
    private string ActiveSection = "profile";
    private string? ProfileName, ProfileUsername, ProfileEmail, ProfileBackupEmail;
    private string? ProfileImageData;
    private string ProfileError = "", ProfileNotice = "", BackupEmailDraft = "", BackupEmailOtp = "", BackupEmailError = "", BackupEmailNotice = "";
    private string CurrentPassword = "", NewPassword = "", ConfirmPassword = "", PasswordError = "", PasswordNotice = "";
    private string NewEmail = "", EmailOtp = "", EmailError = "", EmailNotice = "";
    private bool SavingPassword;
    private bool SavingProfile, SendingBackupEmail, VerifyingBackupEmail, BackupEmailVerificationSent;
    private bool SavingProfileImage;
    private int ProfileImageInputVersion;
    private string ProfileImageError = "", ProfileImageNotice = "";
    private const long MaxProfileImageBytes = 1024 * 1024;
    private string SelectedTheme = "light";
    private bool SendingEmailCode, VerifyingEmail, EmailVerificationSent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await Api.GetProfileAsync();
            ProfileName = profile.Name;
            ProfileUsername = profile.Username;
            ProfileEmail = profile.Email;
            ProfileBackupEmail = profile.BackupEmail;
            ProfileImageData = profile.ProfileImageData;
        }
        catch (Exception ex) { ProfileError = ex.Message; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(Api.AccessToken)) return;
        SelectedTheme = await JS.InvokeAsync<string>("safePassageAppearance.getTheme", Api.IsAdministrator);
        StateHasChanged();
    }

    private string AvatarInitials
    {
        get
        {
            var name = Api.CurrentUsername;
            if (string.IsNullOrWhiteSpace(name)) return Api.IsAdministrator ? "AD" : "SP";
            var parts = name.Split(new[] { ' ', '.', '_', '-', '@' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2) return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
            return name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
        }
    }

    private string SectionClass(string section) => ActiveSection == section ? "active" : "";
    private void ShowProfile() => ActiveSection = "profile";
    private void ShowAccount() => ActiveSection = "account";
    private void ShowDevices() => ActiveSection = "devices";
    private void ShowAppearance() => ActiveSection = "appearance";

    private async Task SetThemeAsync(string theme)
    {
        if (theme is not ("light" or "dark")) return;
        SelectedTheme = theme;
        await JS.InvokeVoidAsync("safePassageAppearance.setTheme", theme, true, Api.IsAdministrator);
    }

    private async Task SaveProfileAsync()
    {
        ProfileError = ProfileNotice = "";
        SavingProfile = true;
        try
        {
            var profile = await Api.UpdateProfileNameAsync(ProfileName?.Trim() ?? "");
            ProfileName = profile.Name;
            ProfileNotice = "Your name was updated.";
        }
        catch (Exception ex) { ProfileError = ex.Message; }
        finally { SavingProfile = false; }
    }

    private async Task UpdateProfileImageAsync(InputFileChangeEventArgs args)
    {
        ProfileImageError = ProfileImageNotice = "";
        var image = args.File;
        if (image.Size > MaxProfileImageBytes)
        {
            ProfileImageError = "Choose an image smaller than 1 MB.";
            ProfileImageInputVersion++;
            return;
        }
        if (image.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
        {
            ProfileImageError = "Use a JPG, PNG, or WebP image.";
            ProfileImageInputVersion++;
            return;
        }

        SavingProfileImage = true;
        try
        {
            await using var stream = image.OpenReadStream(MaxProfileImageBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var imageData = $"data:{image.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
            var profile = await Api.UpdateProfileImageAsync(imageData);
            ProfileImageData = profile.ProfileImageData;
            ProfileImageNotice = "Profile picture updated.";
        }
        catch (Exception exception) { ProfileImageError = exception.Message; }
        finally { SavingProfileImage = false; ProfileImageInputVersion++; }
    }

    private async Task RemoveProfileImageAsync()
    {
        ProfileImageError = ProfileImageNotice = "";
        SavingProfileImage = true;
        try
        {
            var profile = await Api.RemoveProfileImageAsync();
            ProfileImageData = profile.ProfileImageData;
            ProfileImageNotice = "Profile picture removed.";
        }
        catch (Exception exception) { ProfileImageError = exception.Message; }
        finally { SavingProfileImage = false; }
    }

    private async Task RequestBackupEmailAsync()
    {
        BackupEmailError = BackupEmailNotice = "";
        SendingBackupEmail = true;
        try
        {
            await Api.RequestBackupEmailVerificationAsync(BackupEmailDraft.Trim());
            BackupEmailVerificationSent = true;
            BackupEmailOtp = "";
            BackupEmailNotice = $"A verification link and 6-digit code were sent to {BackupEmailDraft.Trim()}.";
        }
        catch (Exception ex) { BackupEmailError = ex.Message; }
        finally { SendingBackupEmail = false; }
    }

    private async Task VerifyBackupEmailOtpAsync()
    {
        BackupEmailError = BackupEmailNotice = "";
        VerifyingBackupEmail = true;
        try
        {
            var profile = await Api.VerifyBackupEmailOtpAsync(BackupEmailOtp.Trim());
            ProfileBackupEmail = profile.BackupEmail;
            BackupEmailDraft = BackupEmailOtp = "";
            BackupEmailVerificationSent = false;
            BackupEmailNotice = "Backup email verified successfully.";
        }
        catch (Exception ex) { BackupEmailError = ex.Message; }
        finally { VerifyingBackupEmail = false; }
    }

    private async Task ChangePasswordAsync()
    {
        PasswordError = "";
        PasswordNotice = "";
        if (NewPassword != ConfirmPassword) { PasswordError = "New password confirmation does not match."; return; }
        SavingPassword = true;
        try
        {
            await Api.ChangePasswordAsync(CurrentPassword, NewPassword);
            CurrentPassword = NewPassword = ConfirmPassword = "";
            PasswordNotice = "Password updated successfully.";
        }
        catch (Exception ex) { PasswordError = ex.Message; }
        finally { SavingPassword = false; }
    }

    private async Task RequestEmailChangeAsync()
    {
        EmailError = "";
        EmailNotice = "";
        SendingEmailCode = true;
        try
        {
            await Api.RequestAdminEmailChangeAsync(NewEmail.Trim());
            EmailVerificationSent = true;
            EmailOtp = "";
            EmailNotice = $"A verification link and code were sent to {NewEmail.Trim()}.";
        }
        catch (Exception ex) { EmailError = ex.Message; }
        finally { SendingEmailCode = false; }
    }

    private async Task VerifyEmailOtpAsync()
    {
        EmailError = "";
        EmailNotice = "";
        VerifyingEmail = true;
        try
        {
            await Api.VerifyAdminEmailChangeOtpAsync(EmailOtp.Trim());
            NewEmail = EmailOtp = "";
            EmailVerificationSent = false;
            EmailNotice = "Administrator email updated successfully.";
        }
        catch (Exception ex) { EmailError = ex.Message; }
        finally { VerifyingEmail = false; }
    }

    private async Task SignOutAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to sign out?")) return;
        await JS.InvokeVoidAsync("safePassageAppearance.reset");
        Api.SignOut();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
