@page "/applications"
@rendermode InteractiveServer

<PageTitle>Applications – Safe Passage</PageTitle>

<div class="sp-page-header">
    <h1 class="sp-page-title">Applications</h1>
    <p class="sp-page-subtitle">Register and manage protected applications and their access policies.</p>
</div>

<div class="apps-toolbar"><div><strong>@ConnectedApps.Count connected applications</strong><span>SSO integrations and access assignments</span></div><button class="apps-primary" @onclick="OpenAddModal">＋ Add Application</button></div>

<div class="apps-grid">
    @foreach (var app in ConnectedApps)
    {
        <article class="sp-card app-card">
            <div class="app-card-top"><span class="app-mark">@app.Mark</span><span class="app-state"><i></i>@app.Status</span></div>
            <h2>@app.Name</h2><p class="app-type">@app.Category <span>·</span> @app.Protocol</p>
            <div class="app-access-summary"><div><strong>@app.Users.Count</strong><span>users</span></div><div><strong>@app.Groups.Count</strong><span>groups</span></div><span class="app-sso">SSO enabled</span></div>
            <div class="app-card-footer"><span>Access assignments</span><button @onclick="() => OpenAccessModal(app)">Manage Access <span aria-hidden="true">→</span></button></div>
        </article>
    }
</div>

@if (IsAddModalOpen)
{
    <div class="apps-backdrop" @onclick="CloseModal">
        <section class="apps-modal" role="dialog" aria-modal="true" aria-labelledby="add-app-title" @onclick:stopPropagation="true">
            <div class="apps-modal-heading"><div><span>APPLICATION REGISTRY</span><h2 id="add-app-title">Add application</h2></div><button aria-label="Close" @onclick="CloseModal">×</button></div>
            <form @onsubmit="SaveApplication" @onsubmit:preventDefault="true">
                <label>Application name<input required @bind="DraftName" placeholder="e.g. Customer workspace" /></label>
                <label>Category<input required @bind="DraftCategory" placeholder="e.g. Operations" /></label>
                <label>Sign-in URL<input type="url" @bind="DraftUrl" placeholder="https://app.company.com" /></label>
                <div class="apps-modal-actions"><button type="button" class="apps-cancel" @onclick="CloseModal">Cancel</button><button type="submit" class="apps-primary">Add application</button></div>
            </form>
        </section>
    </div>
}

@if (AccessApp is not null)
{
    <div class="apps-backdrop" @onclick="CloseModal">
        <section class="apps-modal" role="dialog" aria-modal="true" aria-labelledby="access-app-title" @onclick:stopPropagation="true">
            <div class="apps-modal-heading"><div><span>ACCESS CONTROL</span><h2 id="access-app-title">@AccessApp.Name</h2><p>Choose who can sign in through Safe Passage.</p></div><button aria-label="Close" @onclick="CloseModal">×</button></div>
            <div class="assignment-section"><h3>Users</h3>
                @foreach (var user in DirectoryNames)
                {
                    <label class="assignment-row"><span>@user</span><input type="checkbox" checked="@AccessApp.Users.Contains(user)" @onchange="args => ToggleAssignment(args, AccessApp.Users, user)" /></label>
                }
            </div>
            <div class="assignment-section"><h3>Groups</h3>
                @foreach (var group in GroupNames)
                {
                    <label class="assignment-row"><span>@group</span><input type="checkbox" checked="@AccessApp.Groups.Contains(group)" @onchange="args => ToggleAssignment(args, AccessApp.Groups, group)" /></label>
                }
            </div>
            <div class="apps-modal-actions"><button class="apps-primary" @onclick="CloseModal">Done</button></div>
        </section>
    </div>
}

<style>
    .apps-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.apps-toolbar>div{display:flex;flex-direction:column;gap:4px}.apps-toolbar strong{font-size:13px}.apps-toolbar span{font-size:11px;color:#64748b}.apps-primary,.apps-cancel{border:0;border-radius:5px;padding:9px 14px;font-size:12px;font-weight:650;cursor:pointer}.apps-primary{background:#087f75;color:#fff}.apps-primary:hover{background:#06665f}.apps-cancel{background:#f1f5f9;color:#334155}
    .apps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px}.app-card{padding:18px 19px;min-width:0}.app-card-top{display:flex;justify-content:space-between;align-items:center}.app-mark{width:38px;height:38px;display:grid;place-items:center;border-radius:7px;background:#e5f2ed;color:#087f75;font-size:13px;font-weight:800}.app-state{display:flex;align-items:center;gap:6px;color:#087f5b;font-size:10px;font-weight:650}.app-state i{width:6px;height:6px;border-radius:50%;background:#099268}.app-card h2{font-size:16px;margin:17px 0 5px;overflow-wrap:anywhere}.app-type{font-size:11px;color:#64748b;margin:0}.app-type span{padding:0 3px;color:#aab3ba}.app-access-summary{display:flex;align-items:center;gap:17px;margin:20px 0 16px;padding:12px 0;border-top:1px solid #edf0f2;border-bottom:1px solid #edf0f2}.app-access-summary div{display:flex;align-items:baseline;gap:5px}.app-access-summary strong{font-size:15px}.app-access-summary span{font-size:10px;color:#64748b}.app-access-summary .app-sso{margin-left:auto;padding:5px 7px;border-radius:4px;background:#eef5f2;color:#45665b}.app-card-footer{display:flex;justify-content:space-between;align-items:center;gap:8px}.app-card-footer>span{font-size:10px;color:#64748b}.app-card-footer button{border:0;background:none;color:#087f75;font-size:11px;font-weight:650;cursor:pointer}.app-card-footer button span{padding-left:4px}
    .apps-backdrop{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(15,23,42,.48)}.apps-modal{width:min(100%,460px);max-height:min(88vh,720px);overflow:auto;background:#fff;border-radius:8px;padding:23px;box-shadow:0 24px 70px rgba(15,23,42,.24)}.apps-modal-heading{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:21px}.apps-modal-heading span{font-size:10px;font-weight:700;color:#087f75}.apps-modal-heading h2{font-size:20px;margin:5px 0}.apps-modal-heading p{font-size:12px;color:#64748b;margin:0}.apps-modal-heading>button{border:0;background:none;color:#64748b;font-size:25px;cursor:pointer}.apps-modal form{display:grid;gap:14px}.apps-modal form>label{display:grid;gap:6px;font-size:12px;font-weight:650;color:#334155}.apps-modal input:not([type=checkbox]){border:1px solid #cbd5dc;border-radius:5px;padding:10px;font:inherit;font-size:13px}.apps-modal input:focus{outline:2px solid #b7e1d8;border-color:#087f75}.apps-modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.assignment-section{margin:17px 0}.assignment-section h3{font-size:12px;margin:0 0 7px;color:#64748b;text-transform:uppercase}.assignment-row{display:flex;justify-content:space-between;align-items:center;padding:10px 2px;border-top:1px solid #edf0f2;font-size:13px}.assignment-row input{width:16px;height:16px;accent-color:#087f75}
    @@media(max-width:600px){.apps-toolbar{align-items:flex-start;flex-direction:column}.apps-toolbar .apps-primary{width:100%}.app-card{padding:16px}}
</style>

@code {
    private readonly List<ConnectedApplication> ConnectedApps = new()
    {
        new("Company HR System", "People Operations", "SAML 2.0", "HR", new() { "Avery Chen", "Samira Patel" }, new() { "Workforce" }),
        new("Finance Portal", "Finance & Accounting", "OIDC", "FN", new() { "Samira Patel", "Morgan Rivera" }, new() { "Finance", "Administrators" }),
        new("Engineering Console", "Developer Tools", "SAML 2.0", "EC", new() { "Avery Chen", "Morgan Rivera" }, new() { "Engineering" })
    };
    private readonly string[] DirectoryNames = { "Avery Chen", "Samira Patel", "Noah Williams", "Morgan Rivera" };
    private readonly string[] GroupNames = { "Administrators", "Engineering", "Finance", "Workforce" };
    private bool IsAddModalOpen;
    private ConnectedApplication? AccessApp;
    private string DraftName = "";
    private string DraftCategory = "";
    private string DraftUrl = "";

    private void OpenAddModal() { AccessApp = null; DraftName = ""; DraftCategory = ""; DraftUrl = ""; IsAddModalOpen = true; }
    private void OpenAccessModal(ConnectedApplication app) { IsAddModalOpen = false; AccessApp = app; }
    private void CloseModal() { IsAddModalOpen = false; AccessApp = null; }
    private void SaveApplication()
    {
        ConnectedApps.Add(new(DraftName.Trim(), DraftCategory.Trim(), "SAML 2.0", "APP", new(), new()));
        CloseModal();
    }
    private static void ToggleAssignment(ChangeEventArgs args, List<string> assignments, string value)
    {
        if (args.Value is true && !assignments.Contains(value)) assignments.Add(value);
        else if (args.Value is false) assignments.Remove(value);
    }

    private sealed class ConnectedApplication(string name, string category, string protocol, string mark, List<string> users, List<string> groups)
    {
        public string Name { get; } = name;
        public string Category { get; } = category;
        public string Protocol { get; } = protocol;
        public string Mark { get; } = mark;
        public string Status { get; } = "Connected";
        public List<string> Users { get; } = users;
        public List<string> Groups { get; } = groups;
    }
}
