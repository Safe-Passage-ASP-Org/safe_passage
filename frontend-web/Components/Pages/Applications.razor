@page "/applications"
@rendermode InteractiveServer
@using SafePassage.Web.Services
@inject AdminApiClient Api

<PageTitle>Applications – Safe Passage</PageTitle>
<div class="sp-page-header"><h1 class="sp-page-title">Applications</h1><p class="sp-page-subtitle">Register protected applications and assign access to users and groups.</p></div>
<div class="apps-toolbar"><div><strong>@RegisteredApplications.Count registered applications</strong><span>Application registry and access assignments</span></div><button class="apps-primary" @onclick="OpenCreate" disabled="@Saving">＋ Add application</button></div>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="apps-alert" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Notice)) { <div class="apps-notice" role="status">@Notice</div> }
@if (Loading) { <p class="apps-state" role="status">Loading applications…</p> }
else if (RegisteredApplications.Count == 0) { <div class="sp-card apps-state">No applications registered. Add an application to configure access assignments.</div> }
else
{
    <div class="apps-grid">
    @foreach (var app in RegisteredApplications)
    {
        <article class="sp-card app-card"><div class="app-card-top"><span class="app-mark">@Mark(app.Name)</span><span class="app-state"><i></i>Registered</span></div><h2>@app.Name</h2><p class="app-description">@(string.IsNullOrWhiteSpace(app.Description) ? "No description" : app.Description)</p>
            <div class="app-access-summary"><div><strong>@app.UserAccessCount</strong><span>users</span></div><div><strong>@app.GroupAccessCount</strong><span>groups</span></div></div>
            <div class="app-card-footer"><button @onclick="() => OpenEdit(app)" disabled="@Saving">Edit details</button><button @onclick="() => OpenAccessAsync(app)" disabled="@Saving">Manage access →</button></div></article>
    }
    </div>
}

@if (EditModal)
{
    <div class="apps-backdrop" @onclick="CloseModals"><section class="apps-modal" role="dialog" aria-modal="true" aria-labelledby="app-title" @onclick:stopPropagation="true">
        <header><div><small>APPLICATION REGISTRY</small><h2 id="app-title">@(Editing is null ? "Add application" : "Edit application")</h2></div><button aria-label="Close" @onclick="CloseModals">×</button></header>
        <form @onsubmit="SaveAppAsync" @onsubmit:preventDefault="true"><label>Application name<input required maxlength="200" @bind="Draft.Name" /></label><label>Description<textarea rows="3" maxlength="2000" @bind="Draft.Description"></textarea></label>
            @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="apps-alert" role="alert">@FormError</div> }
            <footer><button type="button" class="apps-cancel" @onclick="CloseModals" disabled="@Saving">Cancel</button><button class="apps-primary" type="submit" disabled="@Saving">@(Saving ? "Saving…" : "Save application")</button></footer></form>
    </section></div>
}

@if (AccessApp is not null)
{
    <div class="apps-backdrop" @onclick="CloseModals"><section class="apps-modal" role="dialog" aria-modal="true" aria-labelledby="access-title" @onclick:stopPropagation="true">
        <header><div><small>ACCESS CONTROL</small><h2 id="access-title">@AccessApp.Name</h2><p>Select users and groups allowed to access this application.</p></div><button aria-label="Close" @onclick="CloseModals">×</button></header>
        @if (LoadingAccess) { <p class="apps-state">Loading assignments…</p> }
        else
        {
            <div class="assignment-section"><h3>Users</h3>
            @if (DirectoryUsers.Count == 0) { <p class="apps-state">No active directory users available.</p> }
            @foreach (var user in DirectoryUsers.Where(user => user.IsActive)) { <label class="assignment-row"><span>@user.Username <small>@user.Email</small></span><input type="checkbox" checked="@SelectedUsers.Contains(user.Id)" @onchange="args => Toggle(args, SelectedUsers, user.Id)" /></label> }
            </div>
            <div class="assignment-section"><h3>Groups</h3>
            @foreach (var group in DirectoryGroups) { <label class="assignment-row"><span>@group.Name <small>@group.MemberCount members</small></span><input type="checkbox" checked="@SelectedGroups.Contains(group.Id)" @onchange="args => Toggle(args, SelectedGroups, group.Id)" /></label> }
            </div>
            @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="apps-alert" role="alert">@FormError</div> }
            <footer><button class="apps-cancel" @onclick="CloseModals" disabled="@Saving">Cancel</button><button class="apps-primary" @onclick="SaveAccessAsync" disabled="@Saving">@(Saving ? "Saving…" : "Save access")</button></footer>
        }
    </section></div>
}

<style>
    .apps-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.apps-toolbar>div{display:flex;flex-direction:column;gap:4px}.apps-toolbar strong{font-size:13px}.apps-toolbar span{font-size:11px;color:#64748b}.apps-primary,.apps-cancel{border:0;border-radius:5px;padding:9px 14px;font-size:12px;font-weight:650;cursor:pointer}.apps-primary{background:#087f75;color:#fff}.apps-cancel{background:#f1f5f9;color:#334155}.apps-primary:disabled,.apps-cancel:disabled{opacity:.6}.apps-alert,.apps-notice{padding:11px 14px;border-radius:6px;margin-bottom:14px;font-size:13px}.apps-alert{background:#fcecea;color:#9d332b}.apps-notice{background:#edf7f2;color:#087f5b}.apps-state{padding:22px;color:#64748b;font-size:13px}.apps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px}.app-card{padding:18px 19px;min-width:0}.app-card-top{display:flex;justify-content:space-between;align-items:center}.app-mark{width:38px;height:38px;display:grid;place-items:center;border-radius:7px;background:#e5f2ed;color:#087f75;font-size:13px;font-weight:800}.app-state{display:flex;align-items:center;gap:6px;color:#087f5b;font-size:10px;font-weight:650}.app-state i{width:6px;height:6px;border-radius:50%;background:#099268}.app-card h2{font-size:16px;margin:17px 0 5px;overflow-wrap:anywhere}.app-description{font-size:11px;color:#64748b;min-height:32px;margin:0}.app-access-summary{display:flex;gap:20px;margin:16px 0;padding:12px 0;border-top:1px solid #edf0f2;border-bottom:1px solid #edf0f2}.app-access-summary div{display:flex;align-items:baseline;gap:5px}.app-access-summary strong{font-size:15px}.app-access-summary span{font-size:10px;color:#64748b}.app-card-footer{display:flex;justify-content:space-between;gap:8px}.app-card-footer button{border:0;background:none;color:#087f75;font-size:11px;font-weight:650;cursor:pointer}.apps-backdrop{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(15,23,42,.48)}.apps-modal{width:min(100%,500px);max-height:88vh;overflow:auto;background:#fff;border-radius:8px;padding:23px;box-shadow:0 24px 70px rgba(15,23,42,.24)}.apps-modal header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px}.apps-modal header small{font-size:10px;font-weight:700;color:#087f75}.apps-modal header h2{font-size:20px;margin:5px 0}.apps-modal header p{font-size:12px;color:#64748b;margin:0}.apps-modal header>button{border:0;background:none;color:#64748b;font-size:25px;cursor:pointer}.apps-modal form{display:grid;gap:14px}.apps-modal form>label{display:grid;gap:6px;font-size:12px;font-weight:650;color:#334155}.apps-modal input:not([type=checkbox]),.apps-modal textarea{border:1px solid #cbd5dc;border-radius:5px;padding:10px;font:inherit;font-size:13px}.apps-modal footer{display:flex;justify-content:flex-end;gap:8px;margin-top:15px}.assignment-section{margin:14px 0}.assignment-section h3{font-size:12px;margin:0 0 7px;color:#64748b;text-transform:uppercase}.assignment-row{display:flex;justify-content:space-between;align-items:center;padding:10px 2px;border-top:1px solid #edf0f2;font-size:13px;gap:12px}.assignment-row small{display:block;color:#64748b;font-size:11px}.assignment-row input{width:16px;height:16px;accent-color:#087f75;flex:0 0 auto}
    @@media(max-width:600px){.apps-toolbar{align-items:flex-start;flex-direction:column}.apps-toolbar .apps-primary{width:100%}.app-card{padding:16px}}
</style>

@code {
    private List<AdminApplication> RegisteredApplications = [];
    private List<AdminUser> DirectoryUsers = [];
    private List<AdminGroup> DirectoryGroups = [];
    private HashSet<Guid> SelectedUsers = [];
    private HashSet<Guid> SelectedGroups = [];
    private AdminApplication? Editing, AccessApp;
    private AdminApplicationForm Draft = new();
    private bool Loading = true, LoadingAccess, Saving, EditModal;
    private string Error = "", FormError = "", Notice = "";
    protected override async Task OnInitializedAsync() { await LoadAsync(); }
    private async Task LoadAsync() { Loading = true; Error = ""; try { RegisteredApplications = await Api.GetApplicationsAsync(); } catch (Exception ex) { Error = ex.Message; } finally { Loading = false; } }
    private static string Mark(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    private void OpenCreate() { Editing = null; Draft = new(); FormError = ""; EditModal = true; }
    private void OpenEdit(AdminApplication app) { Editing = app; Draft = new() { Name = app.Name, Description = app.Description }; FormError = ""; EditModal = true; }
    private void CloseModals() { if (!Saving) { EditModal = false; AccessApp = null; } }
    private async Task SaveAppAsync() { Saving = true; FormError = ""; try { await Api.SaveApplicationAsync(Draft, Editing?.Id); EditModal = false; Notice = "Application saved."; await LoadAsync(); } catch (Exception ex) { FormError = ex.Message; } finally { Saving = false; } }
    private async Task OpenAccessAsync(AdminApplication app) { AccessApp = app; SelectedUsers.Clear(); SelectedGroups.Clear(); FormError = ""; LoadingAccess = true; try { DirectoryUsers = await Api.GetUsersAsync(); DirectoryGroups = await Api.GetGroupsAsync(); var access = await Api.GetApplicationAccessAsync(app.Id); SelectedUsers = access.UserIds.ToHashSet(); SelectedGroups = access.GroupIds.ToHashSet(); } catch (Exception ex) { FormError = ex.Message; } finally { LoadingAccess = false; } }
    private static void Toggle(ChangeEventArgs args, HashSet<Guid> set, Guid id) { if (args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)) set.Add(id); else set.Remove(id); }
    private async Task SaveAccessAsync() { if (AccessApp is null) return; Saving = true; FormError = ""; try { await Api.SaveApplicationAccessAsync(AccessApp.Id, new(SelectedUsers.ToList(), SelectedGroups.ToList())); AccessApp = null; Notice = "Application access assignments saved."; await LoadAsync(); } catch (Exception ex) { FormError = ex.Message; } finally { Saving = false; } }
}
