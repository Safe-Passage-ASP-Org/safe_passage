@page "/applications"
@rendermode InteractiveServer
@using SafePassage.Web.Services
@inject AdminApiClient Api

<PageTitle>Applications – Safe Passage</PageTitle>
<div class="sp-page-header"><h1 class="sp-page-title">Applications</h1><p class="sp-page-subtitle">Register and maintain protected applications.</p></div>
<div class="apps-toolbar"><div><strong>@RegisteredApplications.Count registered applications</strong><span>Application registry</span></div><button class="apps-primary" @onclick="OpenCreate" disabled="@Saving">＋ Add application</button></div>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="apps-alert" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Notice)) { <div class="apps-notice" role="status">@Notice</div> }
@if (Loading) { <p class="apps-state" role="status">Loading applications…</p> }
else if (RegisteredApplications.Count == 0) { <div class="sp-card apps-state">No applications registered yet.</div> }
else
{
    <div class="apps-grid">@foreach (var app in RegisteredApplications)
    {
        <article class="sp-card app-card"><div class="app-card-top"><span class="app-mark">@Mark(app.Name)</span><span class="app-state"><i></i>Registered</span></div><h2>@app.Name</h2><p>@(string.IsNullOrWhiteSpace(app.Description) ? "No description" : app.Description)</p><div class="app-counts"><span>@app.UserAccessCount user assignments</span><span>@app.GroupAccessCount group assignments</span></div><button class="app-edit" @onclick="() => OpenEdit(app)" disabled="@Saving">Edit details</button></article>
    }</div>
}
@if (EditModal)
{
    <div class="apps-backdrop" @onclick="CloseModal"><section class="apps-modal" role="dialog" aria-modal="true" aria-labelledby="app-title" @onclick:stopPropagation="true">
        <header><div><small>APPLICATION REGISTRY</small><h2 id="app-title">@(Editing is null ? "Add application" : "Edit application")</h2></div><button aria-label="Close" @onclick="CloseModal">×</button></header>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true"><label>Application name<input required maxlength="200" @bind="Draft.Name" /></label><label>Description<textarea rows="3" maxlength="2000" @bind="Draft.Description"></textarea></label>
            @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="apps-alert" role="alert">@FormError</div> }
            <footer><button type="button" class="apps-cancel" @onclick="CloseModal" disabled="@Saving">Cancel</button><button class="apps-primary" type="submit" disabled="@Saving">@(Saving ? "Saving…" : "Save application")</button></footer></form>
    </section></div>
}
<style>
    .apps-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.apps-toolbar>div{display:flex;flex-direction:column;gap:4px}.apps-toolbar strong{font-size:13px}.apps-toolbar span{font-size:11px;color:#64748b}.apps-primary,.apps-cancel{border:0;border-radius:5px;padding:9px 14px;font-size:12px;font-weight:650;cursor:pointer}.apps-primary{background:#087f75;color:#fff}.apps-cancel{background:#f1f5f9;color:#334155}.apps-primary:disabled,.apps-cancel:disabled{opacity:.6}.apps-alert,.apps-notice{padding:11px 14px;border-radius:6px;margin-bottom:14px;font-size:13px}.apps-alert{background:#fcecea;color:#9d332b}.apps-notice{background:#edf7f2;color:#087f5b}.apps-state{padding:22px;color:#64748b;font-size:13px}.apps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px}.app-card{padding:18px;min-width:0}.app-card-top{display:flex;justify-content:space-between;align-items:center}.app-mark{width:38px;height:38px;display:grid;place-items:center;border-radius:7px;background:#e5f2ed;color:#087f75;font-size:13px;font-weight:800}.app-state{display:flex;align-items:center;gap:6px;color:#087f5b;font-size:10px;font-weight:650}.app-state i{width:6px;height:6px;border-radius:50%;background:#099268}.app-card h2{font-size:16px;margin:17px 0 5px;overflow-wrap:anywhere}.app-card p{font-size:11px;color:#64748b;min-height:32px}.app-counts{display:grid;gap:5px;border-top:1px solid #edf0f2;padding:12px 0;color:#64748b;font-size:11px}.app-edit{border:0;background:none;color:#087f75;font-size:11px;font-weight:650;cursor:pointer}.apps-backdrop{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(15,23,42,.48)}.apps-modal{width:min(100%,480px);max-height:88vh;overflow:auto;background:#fff;border-radius:8px;padding:23px;box-shadow:0 24px 70px rgba(15,23,42,.24)}.apps-modal header{display:flex;justify-content:space-between;margin-bottom:20px}.apps-modal header small{font-size:10px;font-weight:700;color:#087f75}.apps-modal header h2{font-size:20px;margin:5px 0}.apps-modal header>button{border:0;background:none;color:#64748b;font-size:25px;cursor:pointer}.apps-modal form{display:grid;gap:14px}.apps-modal form>label{display:grid;gap:6px;font-size:12px;font-weight:650;color:#334155}.apps-modal input,.apps-modal textarea{border:1px solid #cbd5dc;border-radius:5px;padding:10px;font:inherit;font-size:13px}.apps-modal footer{display:flex;justify-content:flex-end;gap:8px;margin-top:15px}
</style>
@code {
    private List<AdminApplication> RegisteredApplications = [];
    private AdminApplication? Editing;
    private AdminApplicationForm Draft = new();
    private bool Loading = true, Saving, EditModal;
    private string Error = "", FormError = "", Notice = "";
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { Loading = true; Error = ""; try { RegisteredApplications = await Api.GetApplicationsAsync(); } catch (Exception ex) { Error = ex.Message; } finally { Loading = false; } }
    private static string Mark(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    private void OpenCreate() { Editing = null; Draft = new(); FormError = ""; EditModal = true; }
    private void OpenEdit(AdminApplication app) { Editing = app; Draft = new() { Name = app.Name, Description = app.Description }; FormError = ""; EditModal = true; }
    private void CloseModal() { if (!Saving) EditModal = false; }
    private async Task SaveAsync() { Saving = true; FormError = ""; try { await Api.SaveApplicationAsync(Draft, Editing?.Id); EditModal = false; Notice = "Application saved."; await LoadAsync(); } catch (Exception ex) { FormError = ex.Message; } finally { Saving = false; } }
}
