@using SafePassage.Web.Services
@inject AdminApiClient Api
@inject NavigationManager Navigation

@if (CanViewRoute)
{
    <RouteView RouteData="RouteData" DefaultLayout="typeof(Layout.MainLayout)" />
}

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    private static readonly HashSet<string> AdminPages =
    [
        "Users",
        "Groups",
        "Roles",
        "Applications",
        "Policies",
        "ActivityLogs",
        "Alerts",
        "Reports",
        "SecurityMfa"
    ];

    private bool CanViewRoute =>
        Api.IsAdministrator || !AdminPages.Contains(RouteData.PageType.Name);

    protected override void OnParametersSet()
    {
        if (!CanViewRoute)
            Navigation.NavigateTo("/dashboard", replace: true);
    }
}
