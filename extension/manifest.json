{
  "manifest_version": 3,
  "name": "Safe Passage Authenticator & Autofill",
  "version": "1.1.0",
  "description": "Request Safe Passage MFA on saved application login pages and optionally autofill credentials.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Safe Passage"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
