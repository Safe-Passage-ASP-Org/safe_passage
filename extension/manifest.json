{
  "manifest_version": 3,
  "name": "Safe Passage Authenticator & Autofill",
  "version": "1.0.0",
  "description": "Authenticate custom sites through Safe Passage MFA and autofill credentials after API approval.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Safe Passage"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
