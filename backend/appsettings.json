{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/safepassage.db"
  },
  "Jwt": {
    "Issuer": "SafePassage.Api",
    "Audience": "SafePassage.Clients",
    "AccessTokenMinutes": 480
  },
  "Smtp": {
    "Port": 587,
    "EnableSsl": true
  },
  "AccountActivation": {
    "TokenLifetimeMinutes": 60
  },
  "Facebook": {
    "GraphApiVersion": "v21.0",
    "FrontendUrl": "http://localhost:5092"
  },
  "GitHub": {
    "FrontendUrl": "http://localhost:5092"
  },
  "GitLab": {
    "InstanceUrl": "https://gitlab.com",
    "FrontendUrl": "http://localhost:5092"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5092",
      "https://localhost:7095",
      "http://localhost:5190",
      "http://127.0.0.1:5190",
      "http://localhost:8081",
      "http://localhost:8082",
      "http://192.168.1.2:8081",
      "http://192.168.1.2:8082",
      "http://192.168.1.2:5092",
      "http://192.168.1.2:19006"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
