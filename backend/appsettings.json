{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/safepassage.db"
  },
  "Jwt": {
    "Issuer": "SafePassage.Api",
    "Audience": "SafePassage.Clients",
    "AccessTokenMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5092",
      "https://localhost:7095",
      "http://localhost:5190",
      "http://127.0.0.1:5190",
      "http://localhost:8081",
      "http://localhost:8082"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
