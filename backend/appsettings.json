{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/safepassage.db"
  },
  "Jwt": {
    "Issuer": "SafePassage.Api",
    "Audience": "SafePassage.Clients",
    "AccessTokenMinutes": 480
  },
  "Smtp": {
    "Port": 587,
    "EnableSsl": true
  },
  "AccountActivation": {
    "TokenLifetimeMinutes": 60
  },
  "AdminLogin": {
    "TokenLifetimeMinutes": 10
  },
  "Facebook": {
    "GraphApiVersion": "v21.0",
    "FrontendUrl": "http://localhost:5092"
  },
  "GitHub": {
    "FrontendUrl": "http://localhost:5092"
  },
  "GitLab": {
    "InstanceUrl": "https://gitlab.com",
    "FrontendUrl": "http://localhost:5092"
  },
  "PayMongo": {
    "BaseUrl": "https://api.paymongo.com/v1",
    "DemoMode": false,
    "SuccessUrl": "http://localhost:5092/subscription/paymongo-callback?status=success",
    "CancelUrl": "http://localhost:5092/subscription/paymongo-callback?status=cancel",
    "PendingCheckoutTtlMinutes": 30,
    "Plans": {
      "pro-monthly": {
        "AmountCentavos": 29900,
        "Currency": "PHP",
        "Name": "Pro Monthly",
        "Description": "Full device protection, priority MFA alerts, and extended audit retention.",
        "PriceDisplay": "PHP 299 / month",
        "Interval": "Month"
      },
      "pro-annual": {
        "AmountCentavos": 299000,
        "Currency": "PHP",
        "Name": "Pro Annual",
        "Description": "All Pro Monthly features billed annually (save 17%).",
        "PriceDisplay": "PHP 2,990 / year",
        "Interval": "Year"
      }
    }
  },
  "PayPal": {
    "Environment": "Sandbox",
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "ReturnUrl": "http://localhost:5092/subscription/paypal-callback?status=success",
    "CancelUrl": "http://localhost:5092/subscription/paypal-callback?status=cancel",
    "PendingCheckoutTtlMinutes": 30,
    "Plans": {
      "pro-monthly": {
        "PayPalPlanId": "",
        "Name": "Pro Monthly",
        "Description": "Full device protection, priority MFA alerts, and extended audit retention.",
        "PriceDisplay": "$4.99 / month",
        "Interval": "Month"
      },
      "pro-annual": {
        "PayPalPlanId": "",
        "Name": "Pro Annual",
        "Description": "All Pro Monthly features billed annually (save 17%).",
        "PriceDisplay": "$49.99 / year",
        "Interval": "Year"
      }
    }
